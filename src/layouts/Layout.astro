---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <!-- ===== Bing 网站验证 ===== -->
    <meta name="msvalidate.01" content="78082B8B3536A479B13C484B31119863" />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <!-- ===== 底部渐变模糊（顶部0 → 底部12px） ===== -->
    <!-- 亮色模式 -->
    <!-- 第1层：顶部，模糊接近0 -->
    <div class="fixed bottom-0 left-0 w-full h-6 pointer-events-none z-30 block dark:hidden"
         style="background: linear-gradient(to top, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 100%); 
                backdrop-filter: blur(0.5px); 
                -webkit-backdrop-filter: blur(0.5px);">
    </div>
    <!-- 第2层：中上部，模糊3px -->
    <div class="fixed bottom-0 left-0 w-full h-14 pointer-events-none z-30 block dark:hidden"
         style="background: linear-gradient(to top, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 100%); 
                backdrop-filter: blur(3px); 
                -webkit-backdrop-filter: blur(3px);">
    </div>
    <!-- 第3层：中下部，模糊7px -->
    <div class="fixed bottom-0 left-0 w-full h-24 pointer-events-none z-30 block dark:hidden"
         style="background: linear-gradient(to top, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 100%); 
                backdrop-filter: blur(7px); 
                -webkit-backdrop-filter: blur(7px);">
    </div>
    <!-- 第4层：底部，模糊12px（最强） -->
    <div class="fixed bottom-0 left-0 w-full h-34 pointer-events-none z-30 block dark:hidden"
         style="background: linear-gradient(to top, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 100%); 
                backdrop-filter: blur(12px); 
                -webkit-backdrop-filter: blur(12px);">
    </div>

    <!-- 暗色模式 -->
    <div class="fixed bottom-0 left-0 w-full h-6 pointer-events-none z-30 hidden dark:block"
         style="background: linear-gradient(to top, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0) 100%); 
                backdrop-filter: blur(0.5px); 
                -webkit-backdrop-filter: blur(0.5px);">
    </div>
    <div class="fixed bottom-0 left-0 w-full h-14 pointer-events-none z-30 hidden dark:block"
         style="background: linear-gradient(to top, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0) 100%); 
                backdrop-filter: blur(3px); 
                -webkit-backdrop-filter: blur(3px);">
    </div>
    <div class="fixed bottom-0 left-0 w-full h-24 pointer-events-none z-30 hidden dark:block"
         style="background: linear-gradient(to top, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0) 100%); 
                backdrop-filter: blur(7px); 
                -webkit-backdrop-filter: blur(7px);">
    </div>
    <div class="fixed bottom-0 left-0 w-full h-34 pointer-events-none z-30 hidden dark:block"
         style="background: linear-gradient(to top, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 100%); 
                backdrop-filter: blur(12px); 
                -webkit-backdrop-filter: blur(12px);">
    </div>

    <BasicScripts />
  </body>
</html>