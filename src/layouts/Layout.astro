<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- 隐藏返回顶部的火箭按钮 -->
    <style is:inline>
      button:has(svg[class*="rocket"]),
      a:has(svg[class*="rocket"]),
      [id*="back-to-top"],
      [class*="back-to-top"],
      [id*="scroll-top"],
      [class*="scroll-top"] {
        display: none !important;
      }
    </style>
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>