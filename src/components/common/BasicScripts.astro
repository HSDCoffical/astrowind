---
import { UI } from 'astrowind:config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme }}>
  /*
   * =========================================================
   * HSDC Basic Scripts
   * =========================================================
   *
   * 这部分脚本需要兼容 Astro ClientRouter。
   *
   * 旧版本的问题：
   *
   * 1. #header nav 的 click 监听范围过大
   * 2. 桌面一级菜单也位于 nav 中
   * 3. 点击桌面一级菜单时，会被这里再次执行“关闭菜单”
   * 4. Astro 页面切换后 onLoad() 会再次运行
   * 5. 如果不清理旧监听器，会产生重复事件
   *
   * 本版本使用 AbortController 管理生命周期。
   */


  /* =========================================================
     防止 BasicScripts 本身重复初始化
  ========================================================= */

  if (window.basic_script) {
    return;
  }

  window.basic_script = true;


  /* =========================================================
     BasicScripts 事件控制器
  ========================================================= */

  let basicEventController = null;


  /* =========================================================
     主题
  ========================================================= */

  function applyTheme(theme) {

    if (theme === 'dark') {

      document.documentElement.classList.add(
        'dark'
      );

    } else {

      document.documentElement.classList.remove(
        'dark'
      );

    }
  }


  const initTheme = function () {

    if (
      (
        defaultTheme &&
        defaultTheme.endsWith(':only')
      ) ||
      (
        !localStorage.theme &&
        defaultTheme !== 'system'
      )
    ) {

      applyTheme(
        defaultTheme.replace(':only', '')
      );

    } else if (

      localStorage.theme === 'dark' ||

      (
        !('theme' in localStorage) &&
        window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches
      )

    ) {

      applyTheme('dark');

    } else {

      applyTheme('light');

    }
  };


  initTheme();


  /* =========================================================
     关闭手机菜单
  ========================================================= */

  const closeMobileMenu = function () {

    const toggleMenu =
      document.querySelector(
        '[data-aw-toggle-menu]'
      );

    toggleMenu?.classList.remove(
      'expanded'
    );


    document.body.classList.remove(
      'overflow-hidden'
    );


    const header =
      document.getElementById('header');


    header?.classList.remove(
      'h-screen'
    );

    header?.classList.remove(
      'expanded'
    );

    header?.classList.remove(
      'bg-page'
    );


    /*
     * 不再使用：
     *
     * document.querySelector('#header nav')
     *
     * 因为 Header 中现在同时存在：
     *
     * 1. 手机 nav
     * 2. 桌面 nav
     *
     * 如果直接操作 #header nav，
     * 就有可能误伤桌面菜单。
     */

    const mobileNav =
      header?.querySelector(
        '.hsdc-mobile-nav'
      );


    mobileNav?.classList.remove(
      'expanded'
    );

    mobileNav?.setAttribute(
      'data-expanded',
      'false'
    );
  };


  /* =========================================================
     事件绑定工具
  ========================================================= */

  function attachEvent(
    selector,
    event,
    fn
  ) {

    const matches =
      typeof selector === 'string'
        ? document.querySelectorAll(
            selector
          )
        : selector;


    if (
      matches &&
      matches.length
    ) {

      matches.forEach((elem) => {

        elem.addEventListener(
          event,
          (e) => fn(e, elem),
          {
            signal:
              basicEventController?.signal,
          }
        );

      });
    }
  }


  /* =========================================================
     页面加载 / Astro 页面切换
  ========================================================= */

  const onLoad = function () {

    /*
     * 先取消当前页面上一次绑定的监听器。
     *
     * 这样：
     *
     * 页面 A
     * ↓
     * 页面 B
     * ↓
     * 页面 C
     *
     * 不会出现：
     *
     * 一个按钮绑定 3 次 click。
     */

    basicEventController?.abort();


    basicEventController =
      new AbortController();


    let lastKnownScrollPosition =
      window.scrollY;

    let ticking = true;


    /* =======================================================
       手机二级菜单链接
    ======================================================== */

    /*
     * 这里只监听手机二级菜单。
     *
     * 绝对不能再写：
     *
     * #header nav
     *
     * 因为桌面一级菜单也在 nav 中。
     */

    attachEvent(
      '.hsdc-mobile-submenu a',
      'click',
      function () {

        closeMobileMenu();

      }
    );


    /* =======================================================
       手机汉堡菜单
    ======================================================== */

    attachEvent(
      '[data-aw-toggle-menu]',
      'click',
      function (_, elem) {

        const expanded =
          elem.classList.toggle(
            'expanded'
          );


        document.body.classList.toggle(
          'overflow-hidden',
          expanded
        );


        const header =
          document.getElementById('header');


        header?.classList.toggle(
          'h-screen',
          expanded
        );

        header?.classList.toggle(
          'expanded',
          expanded
        );

        header?.classList.toggle(
          'bg-page',
          expanded
        );


        /*
         * 只控制手机导航。
         */

        const mobileNav =
          header?.querySelector(
            '.hsdc-mobile-nav'
          );


        if (mobileNav) {

          mobileNav.classList.toggle(
            'expanded',
            expanded
          );

          mobileNav.setAttribute(
            'data-expanded',
            expanded
              ? 'true'
              : 'false'
          );
        }


        /*
         * 打开手机菜单时，
         * 确保桌面菜单状态关闭。
         */

        if (expanded) {

          header
            ?.querySelectorAll(
              '.hsdc-desktop-group.is-open'
            )
            .forEach((group) => {

              group.classList.remove(
                'is-open'
              );

              group
                .querySelector(
                  '.hsdc-desktop-group-trigger'
                )
                ?.setAttribute(
                  'aria-expanded',
                  'false'
                );
            });
        }

      }
    );


    /* =======================================================
       主题切换
    ======================================================== */

    attachEvent(
      '[data-aw-toggle-color-scheme]',
      'click',
      function () {

        if (
          defaultTheme.endsWith(':only')
        ) {
          return;
        }


        Observer.removeAnimationDelay();


        document.documentElement.classList.toggle(
          'dark'
        );


        localStorage.theme =
          document.documentElement.classList.contains(
            'dark'
          )
            ? 'dark'
            : 'light';

      }
    );


    /* =======================================================
       社交分享
    ======================================================== */

    attachEvent(
      '[data-aw-social-share]',
      'click',
      function (_, elem) {

        const network =
          elem.getAttribute(
            'data-aw-social-share'
          );


        const url =
          encodeURIComponent(
            elem.getAttribute(
              'data-aw-url'
            )
          );


        const text =
          encodeURIComponent(
            elem.getAttribute(
              'data-aw-text'
            )
          );


        let href;


        switch (network) {

          case 'facebook':

            href =
              `https://www.facebook.com/sharer.php?u=${url}`;

            break;


          case 'twitter':

            href =
              `https://twitter.com/intent/tweet?url=${url}&text=${text}`;

            break;


          case 'linkedin':

            href =
              `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${text}`;

            break;


          case 'whatsapp':

            href =
              `https://wa.me/?text=${text}%20${url}`;

            break;


          case 'mail':

            href =
              `mailto:?subject=%22${text}%22&body=${text}%20${url}`;

            break;


          default:

            return;
        }


        const newlink =
          document.createElement('a');


        newlink.target =
          '_blank';


        newlink.href =
          href;


        newlink.click();

      }
    );


    /* =======================================================
       手机 / 桌面尺寸切换
    ======================================================== */

    const screenSize =
      window.matchMedia(
        '(max-width: 767px)'
      );


    const handleScreenSizeChange =
      function () {

        /*
         * 尺寸发生变化时，
         * 关闭手机菜单。
         */

        closeMobileMenu();


        /*
         * 同时关闭桌面一级菜单。
         */

        document
          .querySelectorAll(
            '.hsdc-desktop-group.is-open'
          )
          .forEach((group) => {

            group.classList.remove(
              'is-open'
            );

            group
              .querySelector(
                '.hsdc-desktop-group-trigger'
              )
              ?.setAttribute(
                'aria-expanded',
                'false'
              );

          });

      };


    screenSize.addEventListener(
      'change',
      handleScreenSizeChange,
      {
        signal:
          basicEventController.signal,
      }
    );


    /* =======================================================
       原有滚动逻辑
    ======================================================== */

    /*
     * 这里保留你原来的滚动逻辑注释，
     * 不重新启用，避免影响你之前已经处理好的
     * Header / 首页滚动效果。
     */

    // ===== 已注释冲突的滚动逻辑 =====

    /*
    function applyHeaderStylesOnScroll() {

      const header =
        document.querySelector(
          '#header[data-aw-sticky-header]'
        );

      if (!header) return;


      if (
        lastKnownScrollPosition > 60 &&
        !header.classList.contains('scroll')
      ) {

        header.classList.add(
          'scroll'
        );

      } else if (
        lastKnownScrollPosition <= 60 &&
        header.classList.contains('scroll')
      ) {

        header.classList.remove(
          'scroll'
        );
      }


      ticking = false;
    }


    applyHeaderStylesOnScroll();


    attachEvent(
      [document],
      'scroll',
      function () {

        lastKnownScrollPosition =
          window.scrollY;


        if (!ticking) {

          window.requestAnimationFrame(
            () => {

              applyHeaderStylesOnScroll();

            }
          );

          ticking = true;
        }

      }
    );
    */

  };


  /* =========================================================
     页面显示状态
  ========================================================= */

  const onPageShow = function () {

    /*
     * 不再使用：
     *
     * document.querySelector('#header nav')
     *
     * 因为它可能选择到桌面 nav。
     */

    closeMobileMenu();


    /*
     * 页面切换后，
     * 清除桌面一级菜单的打开状态。
     */

    document
      .querySelectorAll(
        '.hsdc-desktop-group.is-open'
      )
      .forEach((group) => {

        group.classList.remove(
          'is-open'
        );


        group
          .querySelector(
            '.hsdc-desktop-group-trigger'
          )
          ?.setAttribute(
            'aria-expanded',
            'false'
          );

      });

  };


  /* =========================================================
     浏览器首次加载
  ========================================================= */

  window.onload =
    onLoad;


  window.onpageshow =
    onPageShow;


  /* =========================================================
     Astro ClientRouter
  ========================================================= */

  document.addEventListener(
    'astro:after-swap',
    () => {

      /*
       * Astro 页面切换后：
       *
       * 1. 恢复主题
       * 2. 重新绑定 BasicScripts
       * 3. 清理菜单状态
       *
       * onLoad() 内部会先 abort 上一轮监听器，
       * 所以不会重复绑定。
       */

      initTheme();

      onLoad();

      onPageShow();

    }
  );
</script>


<script is:inline>

  /* =========================================================
     Intersection Observer
     =========================================================
     
     Inspired by:
     https://github.com/heidkaemper/tailwindcss-intersect
  ========================================================= */

  const Observer = {

    observer: null,

    delayBetweenAnimations: 100,

    animationCounter: 0,

    elements: null,


    start(isNavigation) {

      if (this.observer) {

        this.observer.disconnect();

      }


      this.animationCounter = 0;


      const selectors = [

        '[class*=" intersect:"]',

        '[class*=":intersect:"]',

        '[class^="intersect:"]',

        '[class="intersect"]',

        '[class*=" intersect "]',

        '[class^="intersect "]',

        '[class$=" intersect"]',

      ];


      this.elements =
        Array.from(
          document.querySelectorAll(
            selectors.join(',')
          )
        );


      const getThreshold =
        (element) => {

          if (
            element.classList.contains(
              'intersect-full'
            )
          ) {

            return 0.99;

          }


          if (
            element.classList.contains(
              'intersect-half'
            )
          ) {

            return 0.5;

          }


          if (
            element.classList.contains(
              'intersect-quarter'
            )
          ) {

            return 0.25;

          }


          return 0;

        };


      this.elements.forEach(
        (el) => {

          el.setAttribute(
            'no-intersect',
            ''
          );


          el._intersectionThreshold =
            getThreshold(el);

        }
      );


      if (isNavigation) {

        const vh =
          window.innerHeight;


        this.elements.forEach(
          (el) => {

            const rect =
              el.getBoundingClientRect();


            if (
              rect.top < vh &&
              rect.bottom > 0
            ) {

              el.removeAttribute(
                'no-intersect'
              );


              el.setAttribute(
                'data-animated',
                'true'
              );


              el.style.animationDuration =
                '0s';

            }

          }
        );
      }


      const callback =
        (entries) => {

          entries.forEach(
            (entry) => {

              requestAnimationFrame(
                () => {

                  const target =
                    entry.target;


                  const intersectionRatio =
                    entry.intersectionRatio;


                  const threshold =
                    target._intersectionThreshold;


                  if (
                    target.classList.contains(
                      'intersect-no-queue'
                    )
                  ) {

                    if (
                      entry.isIntersecting
                    ) {

                      target.removeAttribute(
                        'no-intersect'
                      );


                      if (
                        target.classList.contains(
                          'intersect-once'
                        )
                      ) {

                        this.observer.unobserve(
                          target
                        );

                      }

                    } else {

                      target.setAttribute(
                        'no-intersect',
                        ''
                      );

                    }


                    return;
                  }


                  if (
                    intersectionRatio >=
                    threshold
                  ) {

                    if (
                      !target.hasAttribute(
                        'data-animated'
                      )
                    ) {

                      target.removeAttribute(
                        'no-intersect'
                      );


                      target.setAttribute(
                        'data-animated',
                        'true'
                      );


                      target.style.animationDuration =
                        '';


                      const delay =
                        this.animationCounter *
                        this.delayBetweenAnimations;


                      this.animationCounter++;


                      target.style.transitionDelay =
                        `${delay}ms`;


                      target.style.animationDelay =
                        `${delay}ms`;


                      if (
                        target.classList.contains(
                          'intersect-once'
                        )
                      ) {

                        this.observer.unobserve(
                          target
                        );

                      }

                    }

                  } else {

                    target.setAttribute(
                      'no-intersect',
                      ''
                    );


                    target.removeAttribute(
                      'data-animated'
                    );


                    target.style.transitionDelay =
                      '';


                    target.style.animationDelay =
                      '';


                    target.style.animationDuration =
                      '';


                    this.animationCounter = 0;

                  }

                }
              );

            }
          );
        };


      this.observer =
        new IntersectionObserver(
          callback,
          {
            threshold: [
              0,
              0.25,
              0.5,
              0.99,
            ],
          }
        );


      this.elements.forEach(
        (el) => {

          if (
            !el.hasAttribute(
              'data-animated'
            )
          ) {

            this.observer.observe(
              el
            );

          }

        }
      );

    },


    /* =======================================================
       删除动画延迟
    ======================================================== */

    /*
      REF: #643;

      We need to remove the delay to fix flickering/delay
      when toggling the theme. Observer only removes them
      after data-animated is gone (out of view).
    */

    removeAnimationDelay() {

      this.elements.forEach(
        (el) => {

          if (
            el.getAttribute(
              'data-animated'
            ) === 'true'
          ) {

            el.style.transitionDelay =
              '';


            el.style.animationDelay =
              '';

          }

        }
      );

    },

  };


  /* =========================================================
     Observer 初次启动
  ========================================================= */

  Observer.start(false);


  /* =========================================================
     Astro 页面切换
  ========================================================= */

  document.addEventListener(
    'astro:after-swap',
    () => {

      Observer.start(true);

    }
  );

</script>