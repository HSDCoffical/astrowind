---
// src/components/common/ToggleMenu.astro
import ToggleTheme from './ToggleTheme.astro';

export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class: className = 'flex flex-col h-12 w-12 rounded justify-center items-center cursor-pointer group relative z-[60]',
} = Astro.props;

const menuLinks = [
  { text: '首页', href: '/' },
  { text: '信息中心', href: '/blog' },
  { text: '社区中心', href: 'https://hono-bbs-9qj.pages.dev' },
  { text: '工具中心', href: 'https://it-toolbox-19l.pages.dev/' },
  { text: '个人中心', href: 'https://users-manage-react.pages.dev/account?sessionId=' },
  { text: '关于我们', href: '/about' },
];
---

<button
  type="button"
  class={className}
  aria-label={label}
  id="menu-toggle-btn"
>
  <span class="sr-only">{label}</span>
  <slot>
    <span
      aria-hidden="true"
      class="h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80 group-[.expanded]:rotate-45 group-[.expanded]:translate-y-2.5"
    ></span>
    <span
      aria-hidden="true"
      class="h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80 group-[.expanded]:opacity-0"
    ></span>
    <span
      aria-hidden="true"
      class="h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80 group-[.expanded]:-rotate-45 group-[.expanded]:translate-y-2.5"
    ></span>
  </slot>
</button>

<!-- 遮罩层 -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none"
></div>

<!-- 侧边菜单面板 -->
<div
  id="menu-panel"
  class="fixed top-0 right-0 z-50 h-full w-80 max-w-[85vw] bg-white dark:bg-gray-900 shadow-2xl transition-transform duration-300 ease-out translate-x-full"
>
  <!-- 占位高度，与状态栏对齐 -->
  <div class="h-16 border-b border-gray-100 dark:border-gray-800"></div>

  <nav class="py-2 px-3 overflow-y-auto h-[calc(100%-4rem)]">
    <ul class="space-y-1">
      {menuLinks.map(({ text, href }) => (
        <li>
          <a
            href={href || '#'}
            target={href?.startsWith('http') ? '_blank' : '_self'}
            rel={href?.startsWith('http') ? 'noopener noreferrer' : ''}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-sm font-medium"
          >
            {text}
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
      <div class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-500 dark:text-gray-400">
        <ToggleTheme iconClass="w-5 h-5" />
        <span>切换主题</span>
      </div>
    </div>
  </nav>
</div>

<script>
  (function() {
    const btn = document.getElementById('menu-toggle-btn');
    const panel = document.getElementById('menu-panel');
    const overlay = document.getElementById('menu-overlay');
    let isOpen = false;

    // 打开菜单
    function openMenu() {
      isOpen = true;
      btn.classList.add('expanded');
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }

    // 关闭菜单
    function closeMenu() {
      isOpen = false;
      btn.classList.remove('expanded');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    // 切换
    function toggleMenu() {
      isOpen ? closeMenu() : openMenu();
    }

    // 事件绑定
    btn.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });

    // 点击菜单项关闭
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', function (e) {
        if (this.href.startsWith('http')) return;
        e.preventDefault();
        const href = this.href;
        closeMenu();
        setTimeout(() => {
          window.location.href = href;
        }, 300);
      });
    });

    // 页面加载重置
    closeMenu();

    // Astro SPA 导航后重置
    document.addEventListener('astro:after-swap', () => {
      closeMenu();
    });

    // 页面可见性变化重置
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') closeMenu();
    });
  })();
</script>