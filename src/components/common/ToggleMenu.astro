---
// src/components/common/ToggleMenu.astro
import ToggleTheme from './ToggleTheme.astro';

export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class: className = 'flex flex-col h-12 w-12 rounded justify-center items-center cursor-pointer group relative z-[60]',
} = Astro.props;

const menuLinks = [
  { text: '首页', href: '/' },
  { text: '信息中心', href: '/blog' },
  { text: '社区中心', href: 'https://hono-bbs-9qj.pages.dev' },
  { text: '工具中心', href: 'https://it-toolbox-19l.pages.dev/' },
  { text: '个人中心', href: 'https://users-manage-react.pages.dev/account?sessionId=' },
  { text: '关于我们', href: '/about' },
];
---

<!-- ========== 汉堡按钮 ========== -->
<button
  id="menu-toggle-btn"
  type="button"
  class={className}
  aria-label={label}
  data-aw-toggle-menu
>
  <span class="sr-only">{label}</span>
  <slot>
    <span id="menu-line-1" class="menu-line"></span>
    <span id="menu-line-2" class="menu-line"></span>
    <span id="menu-line-3" class="menu-line"></span>
  </slot>
</button>

<!-- 遮罩 -->
<div id="menu-overlay" class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<!-- 侧边菜单 -->
<div id="menu-panel" class="fixed top-0 right-0 z-50 h-full w-80 max-w-[85vw] bg-white dark:bg-gray-900 shadow-2xl transition-transform duration-300 ease-out translate-x-full">
  <div class="h-16 border-b border-gray-100 dark:border-gray-800"></div>
  <nav class="py-2 px-3 overflow-y-auto h-[calc(100%-4rem)]">
    <ul class="space-y-1">
      {menuLinks.map(({ text, href }) => (
        <li>
          <a href={href || '#'}
             target={href?.startsWith('http') ? '_blank' : '_self'}
             rel={href?.startsWith('http') ? 'noopener noreferrer' : ''}
             class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-sm font-medium"
          >{text}</a>
        </li>
      ))}
    </ul>
    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
      <div class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-500 dark:text-gray-400">
        <ToggleTheme iconClass="w-5 h-5" />
        <span>切换主题</span>
      </div>
    </div>
  </nav>
</div>

<style>
  .menu-line {
    display: block;
    width: 1.5rem;
    height: 2px;
    margin: 4px 0;
    border-radius: 9999px;
    background-color: black;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center center;
  }
  .dark .menu-line {
    background-color: white;
  }
</style>

<script>
  (function() {
    const btn = document.getElementById('menu-toggle-btn');
    const line1 = document.getElementById('menu-line-1');
    const line2 = document.getElementById('menu-line-2');
    const line3 = document.getElementById('menu-line-3');
    const panel = document.getElementById('menu-panel');
    const overlay = document.getElementById('menu-overlay');

    // 重置到三横线
    function resetMenu() {
      // 三条线恢复
      line1.style.transform = 'rotate(0deg)';
      line1.style.opacity = '1';
      line2.style.transform = 'rotate(0deg)';
      line2.style.opacity = '0.8';
      line3.style.transform = 'rotate(0deg)';
      line3.style.opacity = '1';
      // 面板关闭
      panel.style.transform = 'translateX(100%)';
      // 遮罩隐藏
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
      document.body.style.overflow = '';
    }

    // 打开菜单（三横线 → X）
    function openMenu() {
      line1.style.transform = 'rotate(45deg)';
      line1.style.opacity = '1';
      line2.style.transform = 'rotate(0deg)';
      line2.style.opacity = '0';
      line3.style.transform = 'rotate(-45deg)';
      line3.style.opacity = '1';
      panel.style.transform = 'translateX(0%)';
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
      document.body.style.overflow = 'hidden';
    }

    // 关闭菜单（X → 三横线）
    function closeMenu() {
      resetMenu();
    }

    // 切换
    function toggleMenu() {
      // 判断：如果面板在显示（transform 不是 translateX(100%)）
      if (panel.style.transform === 'translateX(0%)' || panel.classList.contains('translate-x-0')) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    // 事件绑定
    btn.addEventListener('click', toggleMenu);
    overlay.addEventListener('click', closeMenu);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });

    // 菜单内链接点击
    panel.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', function(e) {
        if (this.href.startsWith('http')) return;
        e.preventDefault();
        const href = this.href;
        closeMenu();
        setTimeout(() => {
          window.location.href = href;
        }, 300);
      });
    });

    // 页面加载时重置
    resetMenu();

    // Astro SPA 导航后重置
    document.addEventListener('astro:after-swap', () => {
      resetMenu();
    });

    // 切回页面时重置
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        resetMenu();
      }
    });
  })();
</script>