---
export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class: className =
    'flex flex-col h-12 w-12 rounded justify-center items-center cursor-pointer group',
} = Astro.props;
---

<button
  type="button"
  class={className}
  aria-label={label}
  data-aw-toggle-menu
>
  <span class="sr-only">{label}</span>

  <slot>
    <!-- 第一条 -->
    <span
      aria-hidden="true"
      class="
        h-0.5
        w-6
        my-1
        rounded-full
        bg-black
        dark:bg-white
        opacity-80

        transform-gpu
        origin-center

        transition-all
        duration-300
        ease-out

        group-[.expanded]:rotate-45
        group-[.expanded]:translate-y-2.5
      "
    ></span>

    <!-- 中间条 -->
    <span
      aria-hidden="true"
      class="
        h-0.5
        w-6
        my-1
        rounded-full
        bg-black
        dark:bg-white
        opacity-80

        transform-gpu
        origin-center

        transition-all
        duration-280
        ease-out

        group-[.expanded]:opacity-0
        group-[.expanded]:scale-x-75
      "
    ></span>

    <!-- 第三条 -->
    <span
      aria-hidden="true"
      class="
        h-0.5
        w-6
        my-1
        rounded-full
        bg-black
        dark:bg-white
        opacity-80

        transform-gpu
        origin-center

        transition-all
        duration-300
        ease-out

        group-[.expanded]:-rotate-45
        group-[.expanded]:-translate-y-2.5
      "
    ></span>
  </slot>
</button>