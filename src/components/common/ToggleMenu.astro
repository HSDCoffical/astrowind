---
// src/components/common/ToggleMenu.astro
import ToggleTheme from './ToggleTheme.astro';

export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class: className = 'flex flex-col h-12 w-12 rounded justify-center items-center cursor-pointer group relative z-[60]',
} = Astro.props;

// 菜单链接
const menuLinks = [
  { text: '首页', href: '/' },
  { text: '信息中心', href: '/blog' },
  { text: '社区中心', href: 'https://hono-bbs-9qj.pages.dev' },
  { text: '工具中心', href: 'https://it-toolbox-19l.pages.dev/' },
  { text: '个人中心', href: 'https://users-manage-react.pages.dev/account?sessionId=' },
  { text: '关于我们', href: '/about' },
];
---

<!-- ========== 三横线按钮 ========== -->
<button
  id="menu-toggle-btn"
  type="button"
  class={className}
  aria-label={label}
  data-aw-toggle-menu
>
  <span class="sr-only">{label}</span>
  <slot>
    <span
      id="menu-line-1"
      aria-hidden="true"
      class="h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80"
    ></span>
    <span
      id="menu-line-2"
      aria-hidden="true"
      class="h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80"
    ></span>
    <span
      id="menu-line-3"
      aria-hidden="true"
      class="h-0.5 w-6 my-1 rounded-full bg-black dark:bg-white transition ease transform duration-200 opacity-80"
    ></span>
  </slot>
</button>

<!-- ========== 遮罩层 ========== -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- ========== 侧边菜单面板（去掉X关闭按钮） ========== -->
<div
  id="menu-panel"
  class="fixed top-0 right-0 z-50 h-full w-80 max-w-[85vw] bg-white dark:bg-gray-900 shadow-2xl transition-transform duration-300 ease-out translate-x-full"
  role="dialog"
  aria-modal="true"
  aria-label="导航菜单"
>
  <!-- ✅ 顶部只保留一条细线分割，不要关闭按钮 -->
  <div class="h-16 border-b border-gray-100 dark:border-gray-800"></div>

  <!-- 菜单列表 -->
  <nav class="py-2 px-3 overflow-y-auto h-[calc(100%-4rem)]">
    <ul class="space-y-1">
      {menuLinks.map(({ text, href }) => (
        <li>
          <a
            href={href || '#'}
            target={href?.startsWith('http') ? '_blank' : '_self'}
            rel={href?.startsWith('http') ? 'noopener noreferrer' : ''}
            class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-sm font-medium"
          >
            {text}
          </a>
        </li>
      ))}
    </ul>

    <!-- 底部：主题切换 -->
    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
      <div class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-500 dark:text-gray-400">
        <ToggleTheme iconClass="w-5 h-5" />
        <span>切换主题</span>
      </div>
    </div>
  </nav>
</div>

<!-- ========== 交互脚本 ========== -->
<script>
  (function() {
    const btn = document.getElementById('menu-toggle-btn');
    const line1 = document.getElementById('menu-line-1');
    const line2 = document.getElementById('menu-line-2');
    const line3 = document.getElementById('menu-line-3');
    const panel = document.getElementById('menu-panel');
    const overlay = document.getElementById('menu-overlay');
    let isOpen = false;

    // ✅ 重置按钮到三横线状态
    function resetButton() {
      line1.style.transform = 'rotate(0deg) translateY(0px)';
      line1.style.transition = 'transform 0.2s ease';
      line2.style.opacity = '0.8';
      line3.style.transform = 'rotate(0deg) translateY(0px)';
      line3.style.transition = 'transform 0.2s ease';
      panel.classList.add('translate-x-full');
      panel.classList.remove('translate-x-0');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = '';
      isOpen = false;
    }

    function openMenu() {
      isOpen = true;
      // 三横线 → X
      line1.style.transform = 'rotate(45deg) translateY(-2.5px)';
      line2.style.opacity = '0';
      line3.style.transform = 'rotate(-45deg) translateY(2.5px)';
      // 菜单滑出
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      // 遮罩显示
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      // X → 三横线
      line1.style.transform = 'rotate(0deg) translateY(0px)';
      line2.style.opacity = '0.8';
      line3.style.transform = 'rotate(0deg) translateY(0px)';
      // 菜单滑回
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      // 遮罩隐藏
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      isOpen ? closeMenu() : openMenu();
    }

    // ✅ 只有点击汉堡按钮才触发切换
    btn.addEventListener('click', toggleMenu);

    // ✅ 点击遮罩层关闭
    overlay.addEventListener('click', closeMenu);

    // ✅ ESC 键关闭
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // ✅ 点击内部链接：关闭菜单后再跳转
    panel.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', function(e) {
        // 外部链接：新窗口打开，不影响当前页面
        if (this.href.startsWith('http')) {
          // 不阻止默认行为，直接新窗口打开
          return;
        }
        // 内部链接：关闭菜单后再跳转
        e.preventDefault();
        const href = this.href;
        closeMenu();
        setTimeout(() => {
          window.location.href = href;
        }, 300);
      });
    });

    // ✅ 页面加载后重置（解决返回后状态不对）
    resetButton();

    // ✅ Astro SPA 导航后重置
    document.addEventListener('astro:after-swap', function() {
      resetButton();
    });
  })();
</script>

<style is:global>
  #menu-panel {
    will-change: transform;
  }
  #menu-overlay {
    will-change: opacity;
  }
</style>