---
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// 提取图片 URL
let imageUrl = '';

if (image) {
  if (typeof image === 'object' && image.src) {
    imageUrl = image.src;
  } else if (typeof image === 'string') {
    imageUrl = image;
  }
}
---

<section
  data-home-hero
  class="relative not-prose min-h-screen md:min-h-[100dvh] flex items-center pointer-events-none bg-black overflow-x-clip"
  style="margin-top: 0;"
  {...id ? { id } : {}}
>
  <!-- =====================================================
       Hero 背景图片
  ====================================================== -->

  {imageUrl && (
    <div
      class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat hsdc-hero-background pointer-events-none"
      style={`background-image: url('${imageUrl}');`}
      aria-hidden="true"
    ></div>
  )}

  <!-- =====================================================
       自定义背景插槽
       
       放在黑色遮罩之前。
       这样下面的所有背景内容都会统一被黑色遮罩覆盖。
  ====================================================== -->

  <div
    class="absolute inset-0 pointer-events-none hsdc-hero-bg-layer"
    aria-hidden="true"
  >
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>

  <!-- =====================================================
       黑色半透明遮罩
       
       注意：
       必须位于所有背景内容之上，
       同时位于 Hero 文字内容之下。
       
       这样 Hero 整个区域，包括底部，
       都会保持统一的半透明黑色效果。
  ====================================================== -->

  <div
    class="absolute inset-0 w-full h-full bg-black/40 hsdc-hero-overlay pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- =====================================================
       Hero 内容
  ====================================================== -->

  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 z-10 w-full pointer-events-auto hsdc-hero-content"
  >
    <div
      class="pt-0"
      style="padding-top: 0;"
    ></div>

    <div class="pt-12 pb-28 md:py-20">

      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">

        <!-- =================================================
             Tagline
        ================================================== -->

        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade hsdc-hero-item hsdc-hero-item-1"
              set:html={tagline}
            />
          )
        }

        <!-- =================================================
             标题
        ================================================== -->

        {
          title && (
            <h1
              class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter md:tracking-normal mb-4 font-heading text-white drop-shadow-lg intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade hsdc-hero-item hsdc-hero-item-2"
              set:html={title}
            />
          )
        }

        <div class="max-w-3xl mx-auto">

          <!-- ===============================================
               Subtitle
          ================================================ -->

          {
            subtitle && (
              <p
                class="text-xl text-white/90 mb-6 dark:text-slate-200 intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade hsdc-hero-item hsdc-hero-item-3"
                set:html={subtitle}
              />
            )
          }

          <!-- ===============================================
               Actions
          ================================================ -->

          {
            actions && (
              <div
                class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:opacity-0 motion-safe:intersect:animate-fade hsdc-hero-item hsdc-hero-item-4"
              >
                {
                  Array.isArray(actions) ? (
                    actions.map((action) => (
                      <div class="flex w-full sm:w-auto">
                        <Button
                          {...(action || {})}
                          class="w-full sm:mb-0 hsdc-hero-button"
                        />
                      </div>
                    ))
                  ) : (
                    <Fragment set:html={actions} />
                  )
                }
              </div>
            )
          }

        </div>

        <!-- =================================================
             Content
        ================================================== -->

        {content && (
          <div class="hsdc-hero-extra">
            <Fragment set:html={content} />
          </div>
        )}

      </div>

    </div>
  </div>
</section>


<style>
  /* =========================================================
     Hero 基础
  ========================================================= */

  section[data-home-hero] {
    isolation: isolate;
  }


  /* =========================================================
     Hero 背景图片
  ========================================================= */

  .hsdc-hero-background {
    z-index: 0;

    transform: scale(1.02);

    transform-origin: center center;

    will-change: transform;

    animation:
      hsdcHeroZoom
      18s
      ease-in-out
      infinite
      alternate;
  }


  /* =========================================================
     自定义背景层
     
     位于背景图片之上，
     但是必须位于黑色遮罩之下。
  ========================================================= */

  .hsdc-hero-bg-layer {
    z-index: 1;
  }


  /* =========================================================
     Hero 黑色半透明遮罩
     
     这是这次修复的核心。
     
     z-index: 2：
     确保整个 Hero，包括底部区域，
     都被统一的 40% 黑色覆盖。
  ========================================================= */

  .hsdc-hero-overlay {
    z-index: 2;

    background: rgb(0 0 0 / 40%) !important;

    pointer-events: none;

    transition: opacity 500ms ease;
  }


  /* =========================================================
     Hero 内容
     
     必须位于遮罩之上。
  ========================================================= */

  .hsdc-hero-content {
    position: relative;

    z-index: 3;
  }


  /* =========================================================
     Hero 内容动画
  ========================================================= */

  .hsdc-hero-item {
    will-change: opacity, transform;
  }


  .hsdc-hero-item-1 {
    animation-delay: 0ms;
  }


  .hsdc-hero-item-2 {
    animation-delay: 90ms;
  }


  .hsdc-hero-item-3 {
    animation-delay: 170ms;
  }


  .hsdc-hero-item-4 {
    animation-delay: 260ms;
  }


  /* =========================================================
     Hero 按钮
  ========================================================= */

  .hsdc-hero-button {
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      filter 220ms ease;
  }


  @media (hover: hover) and (pointer: fine) {
    .hsdc-hero-button:hover {
      transform: translateY(-3px);

      box-shadow:
        0 12px 30px rgb(0 0 0 / 20%);

      filter: brightness(1.03);
    }
  }


  /* =========================================================
     Hero 背景动画
  ========================================================= */

  @keyframes hsdcHeroZoom {
    0% {
      transform: scale(1.02);
    }

    100% {
      transform: scale(1.055);
    }
  }


  /* =========================================================
     手机端
  ========================================================= */

  @media (max-width: 767px) {

    section[data-home-hero] {
      margin-top: 0 !important;

      min-height: 100svh !important;

      overflow-x: clip !important;
    }


    /*
     * 手机端降低背景动画幅度，
     * 防止图片边缘出现空隙。
     */

    .hsdc-hero-background {
      animation-duration: 28s;

      transform: scale(1.015);
    }


    /*
     * 手机按钮按压反馈
     */

    .hsdc-hero-button:active {
      transform: scale(0.975);
    }

  }


  /* =========================================================
     桌面端
  ========================================================= */

  @media (min-width: 768px) {

    section[data-home-hero] {
      margin-top: -76px !important;

      overflow-x: clip !important;
    }


    section[data-home-hero]
      > div.relative.max-w-7xl {
      padding-top: 76px !important;
    }

  }


  /* =========================================================
     减少动态效果
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .hsdc-hero-background {
      animation: none !important;

      transform: none !important;
    }


    .hsdc-hero-button {
      transition: none !important;
    }

  }
</style>