---
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// 提取图片 URL
let imageUrl = '';
if (image) {
  if (typeof image === 'object' && image.src) {
    imageUrl = image.src;
  } else if (typeof image === 'string') {
    imageUrl = image;
  }
}
---

<section
  data-home-hero
  class="relative not-prose min-h-screen md:min-h-[100dvh] flex items-center pointer-events-none bg-black"
  style="margin-top: 0;"
  {...id ? { id } : {}}
>
  {imageUrl && (
    <div
      class="absolute inset-0 w-full h-full bg-cover bg-center"
      style={`background-image: url('${imageUrl}');`}
    ></div>
  )}

  {imageUrl && (
    <div class="absolute inset-0 w-full h-full bg-black/40"></div>
  )}

  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>

  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 z-10 w-full pointer-events-auto"
  >
    <div
      class="pt-0"
      style="padding-top: 0;"
    ></div>

    <div class="pt-12 pb-28 md:py-20">
      <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">

        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={tagline}
            />
          )
        }

        {
          title && (
            <h1
              class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter md:tracking-normal mb-4 font-heading text-white drop-shadow-lg intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
              set:html={title}
            />
          )
        }

        <div class="max-w-3xl mx-auto">

          {
            subtitle && (
              <p
                class="text-xl text-white/90 mb-6 dark:text-slate-200 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                set:html={subtitle}
              />
            )
          }

          {
            actions && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button
                        {...(action || {})}
                        class="w-full sm:mb-0"
                      />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }

        </div>

        {content && <Fragment set:html={content} />}

      </div>
    </div>
  </div>
</section>

<style>
  /*
   * 手机端：
   * 不再使用 -16px 和 calc(100dvh + 16px)
   *
   * svh 的高度更加稳定，不会因为浏览器地址栏
   * 展开/收起而不断改变 Hero 高度。
   */
  @media (max-width: 767px) {
    section[data-home-hero] {
      margin-top: 0 !important;
      min-height: 100svh !important;
    }
  }

  /*
   * 桌面端保持你原来的顶部布局。
   */
  @media (min-width: 768px) {
    section[data-home-hero] {
      margin-top: -76px !important;
    }

    section[data-home-hero] > div.relative.max-w-7xl {
      padding-top: 76px !important;
    }
  }
</style>