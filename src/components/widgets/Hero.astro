---
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

let imageUrl = '';

if (image) {
  if (typeof image === 'object' && image.src) {
    imageUrl = image.src;
  } else if (typeof image === 'string') {
    imageUrl = image;
  }
}
---

<section
  data-home-hero
  class="relative not-prose min-h-screen md:min-h-[100dvh] flex items-center pointer-events-none bg-black overflow-hidden"
  {...id ? { id } : {}}
>
  <!-- =====================================================
       Hero 背景图片
  ====================================================== -->

  {imageUrl && (
    <div
      class="absolute inset-0 w-full h-full bg-cover bg-center hsdc-hero-image"
      style={`background-image: url('${imageUrl}');`}
      aria-hidden="true"
    ></div>
  )}


  <!-- =====================================================
       Hero 半透明黑色覆盖层
       
       注意：
       这里必须完整覆盖整个 Hero，
       包括背景图片。
  ====================================================== -->

  {imageUrl && (
    <div
      class="absolute inset-0 w-full h-full bg-black/40 hsdc-hero-overlay"
      aria-hidden="true"
    ></div>
  )}


  <!-- =====================================================
       自定义背景插槽
  ====================================================== -->

  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>


  <!-- =====================================================
       Hero 内容
  ====================================================== -->

  <div
    class="relative max-w-7xl mx-auto px-4 sm:px-6 z-10 w-full pointer-events-auto"
  >

    <div class="pt-12 pb-28 md:py-20">

      <div
        class="text-center pb-10 md:pb-16 max-w-5xl mx-auto hsdc-hero-content"
      >

        <!-- =================================================
             Tagline
        ================================================== -->

        {
          tagline && (
            <div
              class="mb-4 text-base sm:text-lg md:text-xl font-semibold text-primary hsdc-hero-tagline"
            >
              {tagline}
            </div>
          )
        }


        <!-- =================================================
             标题
        ================================================== -->

        {
          title && (
            <h1
              class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-white hsdc-hero-title"
            >
              <Fragment set:html={title} />
            </h1>
          )
        }


        <!-- =================================================
             副标题
        ================================================== -->

        <div class="max-w-3xl mx-auto">

          {
            subtitle && (
              <div
                class="mt-6 text-xl sm:text-2xl md:text-3xl text-white/90 hsdc-hero-subtitle"
              >
                <Fragment set:html={subtitle} />
              </div>
            )
          }


          <!-- =================================================
               操作按钮
          ================================================== -->

          {
            actions && (
              <div
                class="mt-8 flex flex-wrap justify-center gap-4 hsdc-hero-actions"
              >
                <Fragment set:html={actions} />
              </div>
            )
          }

        </div>


        <!-- =================================================
             内容
        ================================================== -->

        {
          content && (
            <div class="mt-8 hsdc-hero-extra">
              <Fragment set:html={content} />
            </div>
          )
        }

      </div>

    </div>

  </div>

</section>


<style>
  /* =========================================================
     Hero 基础
  ========================================================= */

  section[data-home-hero] {
    isolation: isolate;
  }


  /* =========================================================
     Hero 背景
  ========================================================= */

  .hsdc-hero-image {
    z-index: 0;

    transform: scale(1.015);

    will-change: transform;

    animation: hsdcHeroKenBurns 24s ease-in-out infinite alternate;
  }


  /* =========================================================
     Hero 黑色遮罩
  ========================================================= */

  .hsdc-hero-overlay {
    z-index: 1;

    background: rgb(0 0 0 / 40%) !important;

    pointer-events: none;
  }


  /* =========================================================
     Hero 内容
  ========================================================= */

  .hsdc-hero-content {
    position: relative;
    z-index: 2;
  }


  /* =========================================================
     Hero 入场动画
  ========================================================= */

  .hsdc-hero-tagline,
  .hsdc-hero-title,
  .hsdc-hero-subtitle,
  .hsdc-hero-actions,
  .hsdc-hero-extra {
    opacity: 0;

    transform: translate3d(0, 24px, 0);

    animation:
      hsdcHeroFadeUp
      0.8s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }


  .hsdc-hero-tagline {
    animation-delay: 80ms;
  }


  .hsdc-hero-title {
    animation-delay: 160ms;
  }


  .hsdc-hero-subtitle {
    animation-delay: 260ms;
  }


  .hsdc-hero-actions {
    animation-delay: 360ms;
  }


  .hsdc-hero-extra {
    animation-delay: 440ms;
  }


  /* =========================================================
     Hero 按钮
  ========================================================= */

  .hsdc-hero-actions :global(a),
  .hsdc-hero-actions :global(button) {
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 220ms ease,
      filter 220ms ease;
  }


  @media (hover: hover) and (pointer: fine) {

    .hsdc-hero-actions :global(a:hover),
    .hsdc-hero-actions :global(button:hover) {
      transform: translateY(-3px);

      box-shadow:
        0 12px 30px rgb(0 0 0 / 18%);

      filter: brightness(1.03);
    }

  }


  /* =========================================================
     手机按钮按压
  ========================================================= */

  @media (max-width: 767px) {

    .hsdc-hero-actions :global(a:active),
    .hsdc-hero-actions :global(button:active) {
      transform: scale(0.975);
    }

  }


  /* =========================================================
     Ken Burns
  ========================================================= */

  @keyframes hsdcHeroKenBurns {

    from {
      transform: scale(1.015);
    }

    to {
      transform: scale(1.055);
    }

  }


  /* =========================================================
     Fade Up
  ========================================================= */

  @keyframes hsdcHeroFadeUp {

    from {
      opacity: 0;

      transform: translate3d(0, 24px, 0);
    }

    to {
      opacity: 1;

      transform: translate3d(0, 0, 0);
    }

  }


  /* =========================================================
     手机端
     
     手机不要让背景持续明显放大，
     防止视觉抖动以及图片边缘出现空隙。
  ========================================================= */

  @media (max-width: 767px) {

    section[data-home-hero] {
      margin-top: 0 !important;

      min-height: 100svh !important;
    }


    .hsdc-hero-image {
      transform: scale(1.02);

      animation:
        hsdcHeroMobileKenBurns
        36s
        ease-in-out
        infinite
        alternate;
    }


    @keyframes hsdcHeroMobileKenBurns {

      from {
        transform: scale(1.02);
      }

      to {
        transform: scale(1.035);
      }

    }


    .hsdc-hero-content {
      padding-top: 1rem;
    }


    .hsdc-hero-title {
      font-size: clamp(
        3rem,
        13vw,
        5rem
      );

      line-height: 1.08;
    }


    .hsdc-hero-subtitle {
      font-size: clamp(
        1.25rem,
        5.5vw,
        2rem
      );

      line-height: 1.5;
    }

  }


  /* =========================================================
     桌面端
  ========================================================= */

  @media (min-width: 768px) {

    section[data-home-hero] {
      margin-top: -76px !important;
    }


    section[data-home-hero]
      > div.relative.max-w-7xl {
      padding-top: 76px !important;
    }

  }


  /* =========================================================
     减少动态效果
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .hsdc-hero-image {
      animation: none !important;

      transform: scale(1.02);
    }


    .hsdc-hero-tagline,
    .hsdc-hero-title,
    .hsdc-hero-subtitle,
    .hsdc-hero-actions,
    .hsdc-hero-extra {
      opacity: 1 !important;

      transform: none !important;

      animation: none !important;
    }


    .hsdc-hero-actions :global(a),
    .hsdc-hero-actions :global(button) {
      transition: none !important;
    }

  }
</style>