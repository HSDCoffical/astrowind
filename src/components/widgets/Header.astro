---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    header#header * {
      background: transparent !important;
    }
    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }
    header#header button:hover,
    header#header a:hover {
      background: rgba(255,255,255,0.1) !important;
    }
    .dark header#header button:hover,
    .dark header#header a:hover {
      background: rgba(255,255,255,0.05) !important;
    }
    .menu-theme-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      margin-top: 0.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      color: #666;
    }
    .dark .menu-theme-item {
      border-top-color: rgba(255,255,255,0.06);
      color: #aaa;
    }
    @media (min-width: 768px) {
      .menu-theme-item {
        display: none !important;
      }
    }

    /* 手机端禁用毛玻璃，防止白色采样 */
    @media (max-width: 768px) {
      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }
    }

    /* ===== 搜索框样式（在 Header 内部） ===== */
    .header-search {
      width: 100%;
      margin-top: 4px;
      margin-bottom: 4px;
      position: relative;
    }
    .header-search input[type="text"] {
      width: 100%;
      padding: 8px 44px 8px 40px;
      background: rgba(255, 255, 255, 0.20);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: 9999px;
      color: #1f2937;
      font-size: 14px;
      outline: none;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: border-color 0.2s;
      height: 44px;
    }
    .dark .header-search input[type="text"] {
      background: rgba(31, 41, 55, 0.30);
      color: #f3f4f6;
      border-color: rgba(255, 255, 255, 0.10);
    }
    .header-search input[type="text"]::placeholder {
      color: #9ca3af;
    }
    .dark .header-search input[type="text"]::placeholder {
      color: #6b7280;
    }
    .header-search input[type="text"]:focus {
      border-color: rgba(59, 130, 246, 0.5);
    }
    .header-search .icon-btn {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #6b7280;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dark .header-search .icon-btn {
      color: #9ca3af;
    }
    .header-search .icon-btn svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }
    .header-search .mode-btn {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.30);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: none;
      padding: 2px 10px;
      border-radius: 9999px;
      font-size: 10px;
      color: #4b5563;
      cursor: pointer;
      transition: background 0.2s;
      line-height: 1.6;
    }
    .dark .header-search .mode-btn {
      background: rgba(55, 65, 81, 0.40);
      color: #d1d5db;
    }
    .header-search .mode-btn:hover {
      background: rgba(255, 255, 255, 0.50);
    }
    .dark .header-search .mode-btn:hover {
      background: rgba(75, 85, 99, 0.60);
    }
    .header-search #results {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 4px);
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: 12px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      max-height: 240px;
      overflow-y: auto;
      display: none;
      z-index: 60;
    }
    .dark .header-search #results {
      background: rgba(31, 41, 55, 0.95);
      border-color: rgba(255, 255, 255, 0.10);
    }
    .header-search #results a {
      display: block;
      padding: 8px 16px;
      color: #1f2937;
      text-decoration: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      transition: background 0.15s;
    }
    .dark .header-search #results a {
      color: #f3f4f6;
    }
    .header-search #results a:last-child {
      border-bottom: none;
    }
    .header-search #results a:hover {
      background: rgba(0, 0, 0, 0.05);
    }
    .dark .header-search #results a:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    .header-search #results .title {
      font-weight: 500;
      font-size: 13px;
    }
    .header-search #results .desc {
      font-size: 11px;
      color: #6b7280;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dark .header-search #results .desc {
      color: #9ca3af;
    }
    .header-search .hidden {
      display: none !important;
    }

    /* 桌面端搜索框宽度限制 */
    @media (min-width: 768px) {
      .header-search-desktop {
        max-width: 300px;
      }
    }

    /* 桌面端导航栏中的搜索框 */
    .nav-search {
      position: relative;
      flex: 1;
      max-width: 300px;
    }
    .nav-search input[type="text"] {
      width: 100%;
      padding: 6px 40px 6px 36px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 9999px;
      color: #fff;
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s;
      height: 38px;
    }
    .dark .nav-search input[type="text"] {
      background: rgba(31, 41, 55, 0.40);
      border-color: rgba(255, 255, 255, 0.10);
      color: #f3f4f6;
    }
    .nav-search input[type="text"]::placeholder {
      color: rgba(255, 255, 255, 0.6);
    }
    .dark .nav-search input[type="text"]::placeholder {
      color: #6b7280;
    }
    .nav-search input[type="text"]:focus {
      border-color: rgba(59, 130, 246, 0.5);
    }
    .nav-search .icon-btn {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.6);
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dark .nav-search .icon-btn {
      color: #9ca3af;
    }
    .nav-search .icon-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }
    .nav-search .mode-btn {
      position: absolute;
      right: 6px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.20);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: none;
      padding: 1px 8px;
      border-radius: 9999px;
      font-size: 9px;
      color: rgba(255, 255, 255, 0.7);
      cursor: pointer;
      transition: background 0.2s;
      line-height: 1.6;
    }
    .dark .nav-search .mode-btn {
      background: rgba(55, 65, 81, 0.40);
      color: #9ca3af;
    }
    .nav-search .mode-btn:hover {
      background: rgba(255, 255, 255, 0.30);
    }
    .dark .nav-search .mode-btn:hover {
      background: rgba(75, 85, 99, 0.60);
    }
    .nav-search #results-desktop {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 4px);
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: 12px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      max-height: 240px;
      overflow-y: auto;
      display: none;
      z-index: 60;
    }
    .dark .nav-search #results-desktop {
      background: rgba(31, 41, 55, 0.95);
      border-color: rgba(255, 255, 255, 0.10);
    }
    .nav-search #results-desktop a {
      display: block;
      padding: 8px 16px;
      color: #1f2937;
      text-decoration: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      transition: background 0.15s;
    }
    .dark .nav-search #results-desktop a {
      color: #f3f4f6;
    }
    .nav-search #results-desktop a:last-child {
      border-bottom: none;
    }
    .nav-search #results-desktop a:hover {
      background: rgba(0, 0, 0, 0.05);
    }
    .dark .nav-search #results-desktop a:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    .nav-search #results-desktop .title {
      font-weight: 500;
      font-size: 13px;
    }
    .nav-search #results-desktop .desc {
      font-size: 11px;
      color: #6b7280;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dark .nav-search #results-desktop .desc {
      color: #9ca3af;
    }
  </style>

  <div class="absolute inset-0" style="background: transparent !important;"></div>
  <div
    class:list={[
      'relative text-default py-1.5 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <!-- ===== 手机端：Logo + 菜单 + 搜索框 ===== -->
    <div class="md:hidden">
      <div class="flex items-center justify-between">
        <a class="flex items-center" href={getHomePermalink()}>
          <Logo />
        </a>
        <div class="flex items-center gap-2">
          <ToggleTheme iconClass="w-5 h-5" />
          <ToggleMenu />
        </div>
      </div>
      <!-- 手机端搜索框 -->
      <div class="header-search">
        <form id="search-form-mobile" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
          <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
          <input
            id="search-input-mobile"
            type="text"
            name="q"
            placeholder="搜索本站内容..."
            autocomplete="off"
          />
          <button type="button" class="icon-btn" id="search-toggle-mobile" aria-label="聚焦搜索框">
            <svg viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
          <button type="button" class="mode-btn" id="mode-toggle-mobile"><span id="mode-label-mobile">站外</span></button>
        </form>
        <div id="results-mobile"></div>
      </div>
    </div>

    <!-- ===== 桌面端：Logo + 导航 + 搜索框 ===== -->
    <div class="hidden md:flex items-center justify-between w-full gap-4">
      <a class="flex items-center flex-shrink-0" href={getHomePermalink()}>
        <Logo />
      </a>

      <!-- 桌面端导航菜单 -->
      <nav class="flex items-center gap-4 text-sm font-medium flex-1 justify-center">
        {
          links.map(({ text, href }) => (
            <a
              href={href}
              class={currentPath === href ? 'text-link' : 'hover:text-link'}
            >
              {text}
            </a>
          ))
        }
      </nav>

      <!-- 桌面端：搜索框 + 主题切换 + 操作按钮 -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <!-- 桌面端搜索框 -->
        <div class="nav-search">
          <form id="search-form-desktop" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
            <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
            <input
              id="search-input-desktop"
              type="text"
              name="q"
              placeholder="搜索..."
              autocomplete="off"
            />
            <button type="button" class="icon-btn" id="search-toggle-desktop" aria-label="聚焦搜索框">
              <svg viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
            <button type="button" class="mode-btn" id="mode-toggle-desktop"><span id="mode-label-desktop">站外</span></button>
          </form>
          <div id="results-desktop"></div>
        </div>

        <ToggleTheme iconClass="w-5 h-5" />
        {showRssFeed && (
          <a
            class="text-muted hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg text-sm p-2 inline-flex items-center"
            aria-label="RSS Feed"
            href={getAsset('/rss.xml')}
          >
            <Icon name="tabler:rss" class="w-5 h-5" />
          </a>
        )}
        {actions?.length && actions.map((btnProps) => (
          <Button {...btnProps} class="py-2 px-4 text-sm font-semibold" />
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    // === 手机端搜索 ===
    const formM = document.getElementById('search-form-mobile');
    const inputM = document.getElementById('search-input-mobile');
    const toggleM = document.getElementById('search-toggle-mobile');
    const modeToggleM = document.getElementById('mode-toggle-mobile');
    const modeLabelM = document.getElementById('mode-label-mobile');
    const resultsM = document.getElementById('results-mobile');

    // === 桌面端搜索 ===
    const formD = document.getElementById('search-form-desktop');
    const inputD = document.getElementById('search-input-desktop');
    const toggleD = document.getElementById('search-toggle-desktop');
    const modeToggleD = document.getElementById('mode-toggle-desktop');
    const modeLabelD = document.getElementById('mode-label-desktop');
    const resultsD = document.getElementById('results-desktop');

    let modeM = 'external';
    let modeD = 'external';
    let searchData = null;

    async function loadSearchData() {
      try {
        const resp = await fetch('/search.json');
        if (resp.ok) {
          searchData = await resp.json();
        }
      } catch (e) {}
    }

    function searchInternal(query) {
      if (!searchData || !query.trim()) return [];
      const q = query.toLowerCase().trim();
      return searchData
        .filter(page => {
          const title = page.title.toLowerCase();
          const desc = page.description.toLowerCase();
          const content = page.content.toLowerCase();
          return title.includes(q) || desc.includes(q) || content.includes(q);
        })
        .slice(0, 10);
    }

    function showResults(results, container) {
      container.innerHTML = '';
      if (results.length === 0) {
        container.style.display = 'none';
        return;
      }
      let html = '';
      for (const page of results) {
        html += `
          <a href="${page.url}">
            <div class="title">${page.title}</div>
            <div class="desc">${page.description || ''}</div>
          </a>
        `;
      }
      container.innerHTML = html;
      container.style.display = 'block';
    }

    function clearResults(container) {
      container.innerHTML = '';
      container.style.display = 'none';
    }

    function updateMode(newMode, form, input, label, container) {
      clearResults(container);
      if (newMode === 'external') {
        form.action = 'https://www.bing.com/search';
        form.target = '_blank';
        let hidden = form.querySelector('input[name="q1"]');
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'q1';
          form.appendChild(hidden);
        }
        hidden.value = 'site:hsdc.dpdns.org';
        input.name = 'q';
        input.placeholder = input === inputM ? '搜索本站内容...' : '搜索...';
        label.textContent = '站外';
      } else {
        form.action = '#';
        form.target = '';
        const hidden = form.querySelector('input[name="q1"]');
        if (hidden) hidden.remove();
        input.name = '';
        input.placeholder = input === inputM ? '检索本站...' : '检索本站...';
        label.textContent = '站内';
        if (input.value.trim()) {
          const results = searchInternal(input.value);
          showResults(results, container);
        }
      }
    }

    // 初始化手机端
    if (formM && inputM) {
      updateMode(modeM, formM, inputM, modeLabelM, resultsM);
      inputM.addEventListener('input', function() {
        if (modeM === 'internal') {
          const query = this.value.trim();
          if (!query) { clearResults(resultsM); return; }
          const results = searchInternal(query);
          showResults(results, resultsM);
        } else {
          clearResults(resultsM);
        }
      });
      toggleM.addEventListener('click', function(e) {
        e.preventDefault();
        inputM.focus();
      });
      modeToggleM.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const newMode = modeM === 'external' ? 'internal' : 'external';
        modeM = newMode;
        updateMode(modeM, formM, inputM, modeLabelM, resultsM);
      });
    }

    // 初始化桌面端
    if (formD && inputD) {
      updateMode(modeD, formD, inputD, modeLabelD, resultsD);
      inputD.addEventListener('input', function() {
        if (modeD === 'internal') {
          const query = this.value.trim();
          if (!query) { clearResults(resultsD); return; }
          const results = searchInternal(query);
          showResults(results, resultsD);
        } else {
          clearResults(resultsD);
        }
      });
      toggleD.addEventListener('click', function(e) {
        e.preventDefault();
        inputD.focus();
      });
      modeToggleD.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const newMode = modeD === 'external' ? 'internal' : 'external';
        modeD = newMode;
        updateMode(modeD, formD, inputD, modeLabelD, resultsD);
      });
    }

    // 点击外部清除结果
    document.addEventListener('click', function(e) {
      const containerM = document.querySelector('.header-search');
      if (containerM && !containerM.contains(e.target)) {
        clearResults(resultsM);
      }
      const containerD = document.querySelector('.nav-search');
      if (containerD && !containerD.contains(e.target)) {
        clearResults(resultsD);
      }
    });

    loadSearchData();

    // SPA 导航后重新初始化
    document.addEventListener('astro:after-swap', function() {
      setTimeout(function() {
        // 重新获取元素
        const newFormM = document.getElementById('search-form-mobile');
        const newInputM = document.getElementById('search-input-mobile');
        const newToggleM = document.getElementById('search-toggle-mobile');
        const newModeToggleM = document.getElementById('mode-toggle-mobile');
        const newModeLabelM = document.getElementById('mode-label-mobile');
        const newResultsM = document.getElementById('results-mobile');

        const newFormD = document.getElementById('search-form-desktop');
        const newInputD = document.getElementById('search-input-desktop');
        const newToggleD = document.getElementById('search-toggle-desktop');
        const newModeToggleD = document.getElementById('mode-toggle-desktop');
        const newModeLabelD = document.getElementById('mode-label-desktop');
        const newResultsD = document.getElementById('results-desktop');

        // 重新初始化手机端
        if (newFormM && newInputM) {
          modeM = 'external';
          updateMode(modeM, newFormM, newInputM, newModeLabelM, newResultsM);
          newInputM.oninput = function() {
            if (modeM === 'internal') {
              const query = this.value.trim();
              if (!query) { clearResults(newResultsM); return; }
              const results = searchInternal(query);
              showResults(results, newResultsM);
            } else {
              clearResults(newResultsM);
            }
          };
          newToggleM.onclick = function(e) { e.preventDefault(); newInputM.focus(); };
          newModeToggleM.onclick = function(e) {
            e.preventDefault();
            e.stopPropagation();
            const newMode = modeM === 'external' ? 'internal' : 'external';
            modeM = newMode;
            updateMode(modeM, newFormM, newInputM, newModeLabelM, newResultsM);
          };
        }

        // 重新初始化桌面端
        if (newFormD && newInputD) {
          modeD = 'external';
          updateMode(modeD, newFormD, newInputD, newModeLabelD, newResultsD);
          newInputD.oninput = function() {
            if (modeD === 'internal') {
              const query = this.value.trim();
              if (!query) { clearResults(newResultsD); return; }
              const results = searchInternal(query);
              showResults(results, newResultsD);
            } else {
              clearResults(newResultsD);
            }
          };
          newToggleD.onclick = function(e) { e.preventDefault(); newInputD.focus(); };
          newModeToggleD.onclick = function(e) {
            e.preventDefault();
            e.stopPropagation();
            const newMode = modeD === 'external' ? 'internal' : 'external';
            modeD = newMode;
            updateMode(modeD, newFormD, newInputD, newModeLabelD, newResultsD);
          };
        }
      }, 50);
    });
  })();
</script>