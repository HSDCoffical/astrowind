---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    header#header * {
      background: transparent !important;
    }
    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }
    header#header button:hover,
    header#header a:hover {
      background: rgba(255,255,255,0.1) !important;
    }
    .dark header#header button:hover,
    .dark header#header a:hover {
      background: rgba(255,255,255,0.05) !important;
    }
    .menu-theme-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      margin-top: 0.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      color: #666;
    }
    .dark .menu-theme-item {
      border-top-color: rgba(255,255,255,0.06);
      color: #aaa;
    }
    @media (min-width: 768px) {
      .menu-theme-item {
        display: none !important;
      }
    }

    /* 手机端禁用毛玻璃（避免白色采样） */
    @media (max-width: 768px) {
      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }
    }

    /* 搜索框在 Header 中适配 */
    #search-form {
      width: 100%;
    }
    #search-input {
      width: 100%;
      background: rgba(255, 255, 255, 0.20);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: 9999px;
      padding: 8px 48px 8px 40px;
      color: #1f2937;
      font-size: 14px;
      outline: none;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: border-color 0.2s;
    }
    .dark #search-input {
      background: rgba(31, 41, 55, 0.30);
      color: #f3f4f6;
      border-color: rgba(255, 255, 255, 0.10);
    }
    #search-input::placeholder {
      color: #9ca3af;
    }
    .dark #search-input::placeholder {
      color: #6b7280;
    }
    #search-input:focus {
      border-color: rgba(59, 130, 246, 0.5);
    }
    .search-icon-btn {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #6b7280;
      padding: 4px;
      transition: color 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .search-icon-btn:hover {
      color: #1f2937;
    }
    .dark .search-icon-btn {
      color: #9ca3af;
    }
    .dark .search-icon-btn:hover {
      color: #f3f4f6;
    }
    .search-icon-btn svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }
    .search-mode-btn {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.30);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: none;
      padding: 2px 10px;
      border-radius: 9999px;
      font-size: 10px;
      color: #4b5563;
      cursor: pointer;
      transition: background 0.2s;
      line-height: 1.6;
    }
    .dark .search-mode-btn {
      background: rgba(55, 65, 81, 0.40);
      color: #d1d5db;
    }
    .search-mode-btn:hover {
      background: rgba(255, 255, 255, 0.50);
    }
    .dark .search-mode-btn:hover {
      background: rgba(75, 85, 99, 0.60);
    }
    #search-results-container {
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 4px);
      background: rgba(255, 255, 255, 0.90);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: 12px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      max-height: 240px;
      overflow-y: auto;
      display: none;
      z-index: 50;
    }
    .dark #search-results-container {
      background: rgba(31, 41, 55, 0.95);
      border-color: rgba(255, 255, 255, 0.10);
    }
    #search-results-container a {
      display: block;
      padding: 8px 16px;
      color: #1f2937;
      text-decoration: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      transition: background 0.15s;
    }
    .dark #search-results-container a {
      color: #f3f4f6;
    }
    #search-results-container a:last-child {
      border-bottom: none;
    }
    #search-results-container a:hover {
      background: rgba(0, 0, 0, 0.05);
    }
    .dark #search-results-container a:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    #search-results-container .title {
      font-weight: 500;
      font-size: 13px;
    }
    #search-results-container .desc {
      font-size: 11px;
      color: #6b7280;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dark #search-results-container .desc {
      color: #9ca3af;
    }
    .hidden {
      display: none !important;
    }

    /* 桌面端搜索框宽度限制 */
    @media (min-width: 768px) {
      .search-wrapper-desktop {
        max-width: 320px;
      }
    }
  </style>

  <div class="absolute inset-0" style="background: transparent !important;"></div>
  <div
    class:list={[
      'relative text-default py-1.5 px-3 md:px-6 mx-auto w-full',
      {
        'md:flex md:justify-between': position !== 'center',
      },
      {
        'md:grid md:grid-cols-3 md:items-center': position === 'center',
      },
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >
    <!-- ===== Logo + 移动端菜单 ===== -->
    <div class="flex items-center justify-between w-full md:hidden">
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center gap-2">
        <ToggleTheme iconClass="w-5 h-5" />
        <ToggleMenu />
      </div>
    </div>

    <!-- ===== 手机端搜索框（在 Logo 下方） ===== -->
    <div class="w-full mt-1 md:hidden">
      <form id="search-form" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
        <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
        <input
          id="search-input"
          type="text"
          name="q"
          placeholder="搜索本站内容..."
          autocomplete="off"
        />
        <button type="button" id="search-toggle" class="search-icon-btn" aria-label="聚焦搜索框">
          <svg viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <button type="button" id="mode-toggle" class="search-mode-btn"><span id="mode-label">站外</span></button>
      </form>
      <div id="search-results-container"></div>
    </div>

    <!-- ===== 桌面端布局 ===== -->
    <div class="hidden md:flex items-center justify-between w-full gap-4">
      <!-- Logo -->
      <a class="flex items-center flex-shrink-0" href={getHomePermalink()}>
        <Logo />
      </a>

      <!-- 桌面端导航菜单 -->
      <nav class="flex items-center gap-4 text-sm font-medium">
        {
          links.map(({ text, href }) => (
            <a
              href={href}
              class={currentPath === href ? 'text-link' : 'hover:text-link'}
            >
              {text}
            </a>
          ))
        }
      </nav>

      <!-- 桌面端：搜索框 + 主题切换 + 操作按钮 -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <!-- 桌面端搜索框 -->
        <div class="search-wrapper-desktop relative">
          <form id="search-form-desktop" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
            <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
            <input
              id="search-input-desktop"
              type="text"
              name="q"
              placeholder="搜索..."
              autocomplete="off"
              class="w-full py-1.5 px-4 pl-9 bg-white/20 backdrop-blur-sm md:backdrop-blur-lg border border-white/30 rounded-full text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm"
            />
            <button
              id="search-toggle-desktop"
              type="button"
              class="absolute left-3 top-1/2 transform -translate-y-1/2 text-white/70 hover:text-white transition-colors"
              aria-label="聚焦搜索框"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
            <button
              id="mode-toggle-desktop"
              type="button"
              class="absolute right-2 top-1/2 transform -translate-y-1/2 text-[10px] text-white/70 bg-white/20 backdrop-blur-sm px-1.5 py-0.5 rounded-full hover:bg-white/30 transition-colors"
            >
              <span id="mode-label-desktop">站外</span>
            </button>
          </form>
          <div id="search-results-container-desktop" class="absolute left-0 right-0 mt-1 bg-white/90 dark:bg-gray-800/90 backdrop-blur-lg border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden z-50"></div>
        </div>

        <ToggleTheme iconClass="w-5 h-5" />
        {showRssFeed && (
          <a
            class="text-muted hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg text-sm p-2 inline-flex items-center"
            aria-label="RSS Feed"
            href={getAsset('/rss.xml')}
          >
            <Icon name="tabler:rss" class="w-5 h-5" />
          </a>
        )}
        {actions?.length && actions.map((btnProps) => (
          <Button {...btnProps} class="py-2 px-4 text-sm font-semibold" />
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    // === 手机端搜索 ===
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const modeToggle = document.getElementById('mode-toggle');
    const modeLabel = document.getElementById('mode-label');
    const resultsContainer = document.getElementById('search-results-container');
    const toggleBtn = document.getElementById('search-toggle');

    // === 桌面端搜索 ===
    const formDesktop = document.getElementById('search-form-desktop');
    const inputDesktop = document.getElementById('search-input-desktop');
    const modeToggleDesktop = document.getElementById('mode-toggle-desktop');
    const modeLabelDesktop = document.getElementById('mode-label-desktop');
    const resultsContainerDesktop = document.getElementById('search-results-container-desktop');
    const toggleBtnDesktop = document.getElementById('search-toggle-desktop');

    let mode = 'external';
    let modeDesktop = 'external';
    let searchData = null;

    async function loadSearchData() {
      try {
        const resp = await fetch('/search.json');
        if (resp.ok) {
          searchData = await resp.json();
        }
      } catch (e) {}
    }

    function searchInternal(query) {
      if (!searchData || !query.trim()) return [];
      const q = query.toLowerCase().trim();
      return searchData
        .filter(page => {
          const title = page.title.toLowerCase();
          const desc = page.description.toLowerCase();
          const content = page.content.toLowerCase();
          return title.includes(q) || desc.includes(q) || content.includes(q);
        })
        .slice(0, 10);
    }

    function showResults(results, container) {
      container.innerHTML = '';
      if (results.length === 0) {
        container.classList.add('hidden');
        return;
      }
      let html = '';
      for (const page of results) {
        html += `
          <a href="${page.url}">
            <div class="title">${page.title}</div>
            <div class="desc">${page.description || ''}</div>
          </a>
        `;
      }
      container.innerHTML = html;
      container.classList.remove('hidden');
    }

    function clearResults(container) {
      container.innerHTML = '';
      container.classList.add('hidden');
    }

    function updateMode(newMode, formEl, inputEl, labelEl, containerEl) {
      clearResults(containerEl);
      if (newMode === 'external') {
        formEl.action = 'https://www.bing.com/search';
        formEl.target = '_blank';
        let hidden = formEl.querySelector('input[name="q1"]');
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'q1';
          formEl.appendChild(hidden);
        }
        hidden.value = 'site:hsdc.dpdns.org';
        inputEl.name = 'q';
        inputEl.placeholder = '搜索...';
        labelEl.textContent = '输入关键词以联网搜索';
      } else {
        formEl.action = '#';
        formEl.target = '';
        const hidden = formEl.querySelector('input[name="q1"]');
        if (hidden) hidden.remove();
        inputEl.name = '';
        inputEl.placeholder = '输入关键词以检索本站';
        labelEl.textContent = '站内搜索';
        if (inputEl.value.trim()) {
          const results = searchInternal(inputEl.value);
          showResults(results, containerEl);
        }
      }
    }

    // 初始化手机端
    function initMobile() {
      if (!form || !input) return;
      updateMode(mode, form, input, modeLabel, resultsContainer);

      input.addEventListener('input', function() {
        if (mode === 'internal') {
          const query = this.value.trim();
          if (!query) { clearResults(resultsContainer); return; }
          const results = searchInternal(query);
          showResults(results, resultsContainer);
        } else {
          clearResults(resultsContainer);
        }
      });

      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault();
        input.focus();
      });

      modeToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const newMode = mode === 'external' ? 'internal' : 'external';
        mode = newMode;
        updateMode(mode, form, input, modeLabel, resultsContainer);
      });
    }

    // 初始化桌面端
    function initDesktop() {
      if (!formDesktop || !inputDesktop) return;
      updateMode(modeDesktop, formDesktop, inputDesktop, modeLabelDesktop, resultsContainerDesktop);

      inputDesktop.addEventListener('input', function() {
        if (modeDesktop === 'internal') {
          const query = this.value.trim();
          if (!query) { clearResults(resultsContainerDesktop); return; }
          const results = searchInternal(query);
          showResults(results, resultsContainerDesktop);
        } else {
          clearResults(resultsContainerDesktop);
        }
      });

      toggleBtnDesktop.addEventListener('click', function(e) {
        e.preventDefault();
        inputDesktop.focus();
      });

      modeToggleDesktop.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const newMode = modeDesktop === 'external' ? 'internal' : 'external';
        modeDesktop = newMode;
        updateMode(modeDesktop, formDesktop, inputDesktop, modeLabelDesktop, resultsContainerDesktop);
      });
    }

    // 点击外部清除结果
    document.addEventListener('click', function(e) {
      const container = document.querySelector('.search-wrapper-desktop');
      if (container && !container.contains(e.target)) {
        clearResults(resultsContainerDesktop);
      }
      const mobileContainer = document.querySelector('.w-full.mt-1');
      if (mobileContainer && !mobileContainer.contains(e.target)) {
        clearResults(resultsContainer);
      }
    });

    // 初始化
    if (document.readyState === 'complete') {
      initMobile();
      initDesktop();
    } else {
      window.addEventListener('load', function() {
        initMobile();
        initDesktop();
      });
    }

    loadSearchData();

    // SPA 导航后重新初始化
    document.addEventListener('astro:after-swap', function() {
      setTimeout(function() {
        // 重新获取元素引用
        const newForm = document.getElementById('search-form');
        const newInput = document.getElementById('search-input');
        const newModeToggle = document.getElementById('mode-toggle');
        const newModeLabel = document.getElementById('mode-label');
        const newResults = document.getElementById('search-results-container');
        const newToggle = document.getElementById('search-toggle');

        const newFormD = document.getElementById('search-form-desktop');
        const newInputD = document.getElementById('search-input-desktop');
        const newModeToggleD = document.getElementById('mode-toggle-desktop');
        const newModeLabelD = document.getElementById('mode-label-desktop');
        const newResultsD = document.getElementById('search-results-container-desktop');
        const newToggleD = document.getElementById('search-toggle-desktop');

        if (newForm && newInput) {
          mode = 'external';
          updateMode(mode, newForm, newInput, newModeLabel, newResults);
          newInput.oninput = function() {
            if (mode === 'internal') {
              const query = this.value.trim();
              if (!query) { clearResults(newResults); return; }
              const results = searchInternal(query);
              showResults(results, newResults);
            } else {
              clearResults(newResults);
            }
          };
          newToggle.onclick = function(e) { e.preventDefault(); newInput.focus(); };
          newModeToggle.onclick = function(e) {
            e.preventDefault();
            e.stopPropagation();
            const newMode = mode === 'external' ? 'internal' : 'external';
            mode = newMode;
            updateMode(mode, newForm, newInput, newModeLabel, newResults);
          };
        }

        if (newFormD && newInputD) {
          modeDesktop = 'external';
          updateMode(modeDesktop, newFormD, newInputD, newModeLabelD, newResultsD);
          newInputD.oninput = function() {
            if (modeDesktop === 'internal') {
              const query = this.value.trim();
              if (!query) { clearResults(newResultsD); return; }
              const results = searchInternal(query);
              showResults(results, newResultsD);
            } else {
              clearResults(newResultsD);
            }
          };
          newToggleD.onclick = function(e) { e.preventDefault(); newInputD.focus(); };
          newModeToggleD.onclick = function(e) {
            e.preventDefault();
            e.stopPropagation();
            const newMode = modeDesktop === 'external' ? 'internal' : 'external';
            modeDesktop = newMode;
            updateMode(modeDesktop, newFormD, newInputD, newModeLabelD, newResultsD);
          };
        }
      }, 50);
    });
  })();
</script>