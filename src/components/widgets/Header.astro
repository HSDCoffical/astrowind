---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { getHomePermalink } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

interface MenuGroup {
  text: string;
  links: Array<Link>;
}

export interface Props {
  id?: string;
  groups?: Array<MenuGroup>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  groups = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30 hsdc-header"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    /* =========================================================
       Header 基础
    ========================================================= */

    header#header {
      transition:
        background-color 280ms ease,
        border-color 280ms ease,
        box-shadow 280ms ease;
    }

    header#header * {
      background: transparent !important;
    }

    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }

    /* =========================================================
       Logo
    ========================================================= */

    .hsdc-brand {
      display: flex;
      align-items: center;
      flex-shrink: 0;

      text-decoration: none;

      transition:
        transform 220ms ease,
        opacity 220ms ease;
    }

    .hsdc-brand:hover {
      transform: translateY(-1px);
      opacity: 0.94;
    }

    /* =========================================================
       默认状态
    ========================================================= */

    .hsdc-mobile-header {
      display: flex;
      flex-direction: column;

      width: 100%;
    }

    .hsdc-mobile-bar {
      position: relative;
      z-index: 20;

      display: flex;
      align-items: center;

      width: 100%;
    }

    .hsdc-desktop-header {
      display: none;
    }

    /* =========================================================
       Mobile
    ========================================================= */

    @media (max-width: 767px) {
      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        overflow: visible;
      }

      .hsdc-mobile-header {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      .hsdc-mobile-bar {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 64px;
        box-sizing: border-box;
        position: relative;
        z-index: 30;
      }

      .hsdc-desktop-header {
        display: none !important;
      }

      .hsdc-mobile-nav {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;

        width: 100%;
        height: 100dvh;
        box-sizing: border-box;

        padding-top: var(
          --hsdc-mobile-header-height,
          72px
        );
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: max(
  88px,
  calc(
    64px + env(safe-area-inset-bottom)
  )
);

        display: flex !important;
        flex-direction: column;
        flex: none;

        overflow-x: hidden;
        overflow-y: auto;

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transform: translate3d(
          0,
          -14px,
          0
        );

        will-change:
          opacity,
          transform;

        background: transparent !important;

        transition:
          opacity 220ms ease,
          transform 420ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          visibility 0s linear 420ms;
      }

      header#header .hsdc-mobile-nav.expanded,
      header#header .hsdc-mobile-nav[data-expanded="true"] {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translate3d(
          0,
          0,
          0
        );

        transition:
          opacity 240ms ease,
          transform 420ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          visibility 0s linear 0s;
      }

      header#header [data-aw-toggle-menu] {
        transform: none !important;
        will-change: auto;
        position: relative;
        z-index: 40;
      }

      /* =====================================================
         Mobile 首页
      ===================================================== */

      .hsdc-mobile-home {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 48px;
        box-sizing: border-box;
        padding: 13px 16px;
        margin-bottom: 4px;
        font-size: 1.05rem;
        font-weight: 500;
        border-radius: 10px;

        transition:
          transform 180ms ease,
          opacity 180ms ease,
          background-color 200ms ease;
      }

      .hsdc-mobile-home:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      /* =====================================================
         Mobile 一级菜单
      ===================================================== */

      .hsdc-mobile-group {
        width: 100%;
        flex: 0 0 auto;
      }

      .hsdc-mobile-group-button {
        display: flex;
        align-items: center;
        justify-content: space-between;

        width: 100%;
        min-height: 48px;

        box-sizing: border-box;
        padding: 13px 16px;

        border: 0;
        outline: none;

        font-size: 1.05rem;
        font-weight: 500;
        color: inherit;

        cursor: pointer;
        text-align: left;

        transition:
          transform 180ms ease,
          opacity 180ms ease,
          background-color 200ms ease;
      }

      .hsdc-mobile-group-button:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-mobile-group-chevron {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 22px;
        height: 22px;
        flex: 0 0 22px;

        font-size: 25px;
        line-height: 1;

        transform: rotate(0deg);

        transition:
          transform 320ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          opacity 200ms ease;
      }

      .hsdc-mobile-group.is-open
        .hsdc-mobile-group-chevron {
        transform: rotate(90deg);
      }

      /* =====================================================
         Mobile 二级菜单
      ===================================================== */

      .hsdc-mobile-submenu {
        display: flex;
        flex-direction: column;

        width: 100%;
        max-height: 0;

        padding-left: 12px;
        padding-right: 12px;

        box-sizing: border-box;

        opacity: 0;
        overflow: hidden;
        pointer-events: none;

        transform: translate3d(
          0,
          -5px,
          0
        );

        will-change:
          max-height,
          opacity,
          transform;

        transition:
          max-height 440ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          opacity 280ms ease,
          transform 440ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          );
      }

      .hsdc-mobile-group.is-open
        .hsdc-mobile-submenu {
        opacity: 1;
        pointer-events: auto;

        transform: translate3d(
          0,
          0,
          0
        );
      }

      .hsdc-mobile-submenu a {
        display: flex;
        align-items: center;

        width: 100%;
        min-height: 42px;

        box-sizing: border-box;

        padding: 9px 16px;

        font-size: 0.96rem;
        color: inherit;

        border-radius: 10px;

        transition:
          transform 180ms ease,
          opacity 180ms ease,
          background-color 200ms ease;
      }

      .hsdc-mobile-submenu a:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      /* =====================================================
         Mobile 日间 / 夜间模式
      ===================================================== */

      .hsdc-mobile-theme {
  position: absolute;

  right: 20px;
  bottom: max(
    22px,
    env(safe-area-inset-bottom)
  );

  z-index: 50;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 44px;
  height: 44px;

  border-radius: 50%;

  box-sizing: border-box;

  background: rgba(
    255,
    255,
    255,
    0.16
  ) !important;

  border: 1px solid rgba(
    255,
    255,
    255,
    0.28
  );

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  box-shadow:
    0 6px 24px rgba(
      0,
      0,
      0,
      0.12
    );

  transition:
    transform 180ms ease,
    opacity 180ms ease;
}

.hsdc-mobile-theme button {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;

  padding: 0;

  border: 0;
  border-radius: 50%;

  color: inherit;

  background: transparent !important;
}

.hsdc-mobile-theme svg {
  width: 22px;
  height: 22px;
}

.hsdc-mobile-theme:active {
  transform: scale(0.92);
  opacity: 0.72;
}

      .hsdc-mobile-nav::-webkit-scrollbar {
        width: 4px;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-track {
        background: transparent !important;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-thumb {
        background: rgba(
          100,
          116,
          139,
          0.25
        );

        border-radius: 999px;
      }
    }

    /* =========================================================
       Desktop / Tablet
    ========================================================= */

    @media (min-width: 768px) {
      .hsdc-mobile-header {
        display: none !important;
      }

      .hsdc-desktop-header {
        display: flex;
      }

      .hsdc-desktop-nav {
        display: flex;
        align-items: center;
        justify-content: center;

        flex: 0 0 auto;

        margin: 0 1rem;
      }

      .hsdc-home-link,
      .hsdc-desktop-group-button {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 0.28rem;

        min-height: 42px;

        padding:
          0.55rem
          0.85rem;

        border: 0;
        border-radius: 10px;

        color: inherit;

        font-size: 0.9375rem;
        font-weight: 500;

        cursor: pointer;
        white-space: nowrap;

        transition:
          background-color 180ms ease,
          color 180ms ease,
          transform 180ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .hsdc-home-link:hover,
        .hsdc-desktop-group-button:hover {
          background: rgba(
            255,
            255,
            255,
            0.1
          ) !important;

          transform: translateY(-1px);
        }

        .dark .hsdc-home-link:hover,
        .dark
          .hsdc-desktop-group-button:hover {
          background: rgba(
            255,
            255,
            255,
            0.06
          ) !important;
        }
      }

      .hsdc-home-link:active,
      .hsdc-desktop-group-button:active {
        transform: scale(0.97);
      }

      .hsdc-desktop-group {
        position: relative;
      }

      .hsdc-chevron {
        transition:
          transform 280ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          opacity 180ms ease;
      }

      .hsdc-desktop-group.is-open
        .hsdc-chevron {
        transform: rotate(180deg);
      }

      .hsdc-desktop-group.is-open
        .hsdc-desktop-group-button {
        background: rgba(
          255,
          255,
          255,
          0.1
        ) !important;
      }

      .dark
        .hsdc-desktop-group.is-open
        .hsdc-desktop-group-button {
        background: rgba(
          255,
          255,
          255,
          0.06
        ) !important;
      }

      /* =====================================================
         Desktop 下拉菜单
      ===================================================== */

      .hsdc-desktop-dropdown {
        position: absolute;

        top: calc(100% + 7px);
        left: 50%;

        min-width: 178px;

        padding: 6px;

        border:
          1px solid
          rgba(
            148,
            163,
            184,
            0.22
          );

        border-radius: 12px;

        background: rgba(
          255,
          255,
          255,
          0.94
        ) !important;

        box-shadow:
          0 16px 40px
            rgba(
              15,
              23,
              42,
              0.12
            ),
          0 4px 12px
            rgba(
              15,
              23,
              42,
              0.06
            );

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transform:
          translate(-50%, -7px)
          scale(0.97);

        transform-origin: top center;

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          visibility 0s linear 220ms;
      }

      .dark
        .hsdc-desktop-dropdown {
        background: rgba(
          25,
          25,
          28,
          0.94
        ) !important;

        border-color: rgba(
          255,
          255,
          255,
          0.1
        );

        box-shadow:
          0 18px 45px
            rgba(
              0,
              0,
              0,
              0.35
            ),
          0 4px 14px
            rgba(
              0,
              0,
              0,
              0.2
            );
      }

      .hsdc-desktop-group.is-open
        .hsdc-desktop-dropdown {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;

        transform:
          translate(-50%, 0)
          scale(1);

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(
            0.22,
            1,
            0.36,
            1
          ),
          visibility 0s linear 0s;
      }

      .hsdc-desktop-dropdown a {
        display: flex;
        align-items: center;

        min-height: 38px;

        padding:
          0.45rem
          0.8rem;

        border-radius: 8px;

        font-size: 0.9rem;
        font-weight: 450;

        white-space: nowrap;

        transition:
          background-color 160ms ease,
          transform 160ms ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .hsdc-desktop-dropdown a:hover {
          background: rgba(
            100,
            116,
            139,
            0.09
          ) !important;

          transform: translateX(2px);
        }

        .dark
          .hsdc-desktop-dropdown
          a:hover {
          background: rgba(
            255,
            255,
            255,
            0.08
          ) !important;
        }
      }

      .hsdc-desktop-dropdown a:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        flex: 0 0 auto;
      }
    }

    /* =========================================================
       Reduced Motion
    ========================================================= */

    @media (prefers-reduced-motion: reduce) {
      .hsdc-brand,
      .hsdc-mobile-nav,
      .hsdc-mobile-group-button,
      .hsdc-mobile-group-chevron,
      .hsdc-mobile-submenu,
      .hsdc-mobile-submenu a,
      .hsdc-mobile-theme > *,
      .hsdc-desktop-group-button,
      .hsdc-chevron,
      .hsdc-desktop-dropdown,
      .hsdc-desktop-dropdown a,
      header#header [data-aw-toggle-menu] {
        transition: none !important;
      }
    }
  </style>

  <div
    class="absolute inset-0"
    style="background: transparent !important;"
  ></div>

  <!-- =======================================================
       Mobile Header
  ======================================================== -->

  <div
    class="hsdc-mobile-header relative text-default py-1.5 px-3 w-full"
  >
    <div class="hsdc-mobile-bar">
      <a
        class="hsdc-brand"
        href={getHomePermalink()}
        aria-label="返回首页"
      >
        <Logo />
      </a>

      <div class="ml-auto flex items-center shrink-0">
        <ToggleMenu />
      </div>
    </div>

    <nav
      class="hsdc-mobile-nav"
      aria-label="移动端主导航"
      data-expanded="false"
    >
      <a
        class="hsdc-mobile-home"
        href={getHomePermalink()}
      >
        首页
      </a>

      {
        groups?.map((group) => (
          <div class="hsdc-mobile-group">
            <button
              type="button"
              class="hsdc-mobile-group-button"
              aria-expanded="false"
            >
              <span>{group.text}</span>

              <span
                class="hsdc-mobile-group-chevron"
                aria-hidden="true"
              >
                ›
              </span>
            </button>

            <div class="hsdc-mobile-submenu">
              {
                group.links?.map((item) => (
                  <a
                    href={item.href}
                    target={item.target}
                    rel={
                      item.target === '_blank'
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    {item.text}
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }

      <!-- =====================================================
           Mobile Theme Toggle
           恢复原来的日间 / 夜间模式切换
      ====================================================== -->

      {
        showToggleTheme && (
          <div class="hsdc-mobile-theme">
            <ToggleTheme />
          </div>
        )
      }
    </nav>
  </div>

  <!-- =======================================================
       Desktop / Tablet Header
  ======================================================== -->

  <div
    class:list={[
      'hsdc-desktop-header',
      'relative',
      'mx-auto',
      'w-full',
      'px-4',
      'sm:px-6',
      'lg:px-8',
      'py-3',
    ]}
  >
    <div class="flex items-center w-full min-h-[64px]">
      <a
        class="hsdc-brand flex items-center shrink-0"
        href={getHomePermalink()}
        aria-label="返回首页"
      >
        <Logo />
      </a>

      <nav
        class="hsdc-desktop-nav"
        aria-label="主导航"
      >
        <a
          class="hsdc-home-link"
          href={getHomePermalink()}
        >
          首页
        </a>

        {
          groups?.map((group, index) => (
            <div
              class="hsdc-desktop-group"
              data-group-index={index}
            >
              <button
                type="button"
                class="hsdc-desktop-group-button"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{group.text}</span>

                <svg
                  class="hsdc-chevron"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>

              <div
                class="hsdc-desktop-dropdown"
                role="menu"
              >
                {
                  group.links?.map((item) => (
                    <a
                      href={item.href}
                      target={item.target}
                      rel={
                        item.target === '_blank'
                          ? 'noopener noreferrer'
                          : undefined
                      }
                      role="menuitem"
                    >
                      {item.text}
                    </a>
                  ))
                }
              </div>
            </div>
          ))
        }
      </nav>

      <div class="hsdc-header-right flex items-center ml-4 shrink-0">
        {
          showToggleTheme && (
            <ToggleTheme />
          )
        }

        {
          actions?.map((action) => (
            <a
              href={action.href}
              target={action.target}
              rel={
                action.target === '_blank'
                  ? 'noopener noreferrer'
                  : undefined
              }
              class="hsdc-action"
            >
              {action.text}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <script>
    (() => {
      let controller: AbortController | null =
        null;

      let closeTimer:
        | ReturnType<typeof setTimeout>
        | null = null;

      const initHeader = () => {
        controller?.abort();

        controller =
          new AbortController();

        const { signal } = controller;

        const header =
          document.querySelector<HTMLElement>(
            '#header'
          );

        if (!header) return;

        const mobileBar =
          header.querySelector<HTMLElement>(
            '.hsdc-mobile-bar'
          );

        const mobileNav =
          header.querySelector<HTMLElement>(
            '.hsdc-mobile-nav'
          );

        const toggleMenu =
          header.querySelector<HTMLElement>(
            '[data-aw-toggle-menu]'
          );

        const syncMobileHeaderHeight =
          () => {
            if (!mobileBar) return;

            const height =
              mobileBar.getBoundingClientRect()
                .height;

            if (height > 0) {
              header.style.setProperty(
                '--hsdc-mobile-header-height',
                `${height}px`
              );
            }
          };

        syncMobileHeaderHeight();

        window.addEventListener(
          'resize',
          syncMobileHeaderHeight,
          { signal }
        );

        /* =====================================================
           Desktop
        ===================================================== */

        const desktopGroups =
          Array.from(
            header.querySelectorAll<HTMLElement>(
              '.hsdc-desktop-group'
            )
          );

        const closeDesktopGroups =
          () => {
            desktopGroups.forEach(
              (group) => {
                group.classList.remove(
                  'is-open'
                );

                const button =
                  group.querySelector<HTMLButtonElement>(
                    '.hsdc-desktop-group-button'
                  );

                button?.setAttribute(
                  'aria-expanded',
                  'false'
                );
              }
            );
          };

        const toggleDesktopGroup =
          (
            currentGroup: HTMLElement
          ) => {
            const wasOpen =
              currentGroup.classList.contains(
                'is-open'
              );

            desktopGroups.forEach(
              (group) => {
                group.classList.remove(
                  'is-open'
                );

                const button =
                  group.querySelector<HTMLButtonElement>(
                    '.hsdc-desktop-group-button'
                  );

                button?.setAttribute(
                  'aria-expanded',
                  'false'
                );
              }
            );

            if (!wasOpen) {
              currentGroup.classList.add(
                'is-open'
              );

              const button =
                currentGroup.querySelector<HTMLButtonElement>(
                  '.hsdc-desktop-group-button'
                );

              button?.setAttribute(
                'aria-expanded',
                'true'
              );
            }
          };

        desktopGroups.forEach(
          (group) => {
            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-desktop-group-button'
              );

            if (!button) return;

            button.addEventListener(
              'click',
              (event) => {
                event.preventDefault();
                event.stopPropagation();

                toggleDesktopGroup(
                  group
                );
              },
              { signal }
            );
          }
        );

        document.addEventListener(
          'click',
          (event) => {
            const target =
              event.target as Node | null;

            if (!target) return;

            if (
              !header.contains(target)
            ) {
              closeDesktopGroups();
              return;
            }

            if (
              target instanceof Element &&
              !target.closest(
                '.hsdc-desktop-group'
              )
            ) {
              closeDesktopGroups();
            }
          },
          { signal }
        );

        document.addEventListener(
          'keydown',
          (event) => {
            if (
              event.key === 'Escape'
            ) {
              closeDesktopGroups();
            }
          },
          { signal }
        );

        /* =====================================================
           Mobile 二级菜单
        ===================================================== */

        const mobileGroups =
          Array.from(
            header.querySelectorAll<HTMLElement>(
              '.hsdc-mobile-group'
            )
          );

        const closeMobileGroups =
          (
            immediate = false
          ) => {
            mobileGroups.forEach(
              (group) => {
                const button =
                  group.querySelector<HTMLButtonElement>(
                    '.hsdc-mobile-group-button'
                  );

                const submenu =
                  group.querySelector<HTMLElement>(
                    '.hsdc-mobile-submenu'
                  );

                group.classList.remove(
                  'is-open'
                );

                button?.setAttribute(
                  'aria-expanded',
                  'false'
                );

                if (!submenu) return;

                if (immediate) {
                  submenu.style.transition =
                    'none';
                } else {
                  submenu.style.transition =
                    '';
                }

                submenu.style.maxHeight =
                  '0px';

                submenu.style.opacity =
                  '0';

                submenu.style.transform =
                  'translate3d(0, -5px, 0)';

                if (immediate) {
                  void submenu.offsetHeight;

                  submenu.style.transition =
                    '';
                }
              }
            );
          };

        const openMobileGroup =
          (
            currentGroup: HTMLElement
          ) => {
            const button =
              currentGroup.querySelector<HTMLButtonElement>(
                '.hsdc-mobile-group-button'
              );

            const submenu =
              currentGroup.querySelector<HTMLElement>(
                '.hsdc-mobile-submenu'
              );

            if (
              !button ||
              !submenu
            ) {
              return;
            }

            const isOpen =
              currentGroup.classList.contains(
                'is-open'
              );

            mobileGroups.forEach(
              (group) => {
                if (
                  group ===
                  currentGroup
                ) {
                  return;
                }

                const otherButton =
                  group.querySelector<HTMLButtonElement>(
                    '.hsdc-mobile-group-button'
                  );

                const otherSubmenu =
                  group.querySelector<HTMLElement>(
                    '.hsdc-mobile-submenu'
                  );

                group.classList.remove(
                  'is-open'
                );

                otherButton?.setAttribute(
                  'aria-expanded',
                  'false'
                );

                if (
                  otherSubmenu
                ) {
                  otherSubmenu.style.maxHeight =
                    '0px';

                  otherSubmenu.style.opacity =
                    '0';

                  otherSubmenu.style.transform =
                    'translate3d(0, -5px, 0)';
                }
              }
            );

            if (isOpen) {
              currentGroup.classList.remove(
                'is-open'
              );

              button.setAttribute(
                'aria-expanded',
                'false'
              );

              submenu.style.maxHeight =
                '0px';

              submenu.style.opacity =
                '0';

              submenu.style.transform =
                'translate3d(0, -5px, 0)';

              return;
            }

            currentGroup.classList.add(
              'is-open'
            );

            button.setAttribute(
              'aria-expanded',
              'true'
            );

            submenu.style.maxHeight =
              `${submenu.scrollHeight}px`;

            submenu.style.opacity =
              '1';

            submenu.style.transform =
              'translate3d(0, 0, 0)';
          };

        mobileGroups.forEach(
          (group) => {
            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-mobile-group-button'
              );

            if (!button) return;

            button.addEventListener(
              'click',
              (event) => {
                event.preventDefault();
                event.stopPropagation();

                openMobileGroup(
                  group
                );
              },
              { signal }
            );
          }
        );

        /* =====================================================
           Mobile 主菜单
        ===================================================== */

        const clearCloseTimer =
          () => {
            if (
              closeTimer !== null
            ) {
              window.clearTimeout(
                closeTimer
              );

              closeTimer = null;
            }
          };

        const setMobileHeaderOpen =
          () => {
            clearCloseTimer();

            if (!mobileNav) return;

            header.classList.add(
              'h-screen',
              'expanded',
              'bg-page'
            );

            document.body.classList.add(
              'overflow-hidden'
            );

            toggleMenu?.classList.add(
              'expanded'
            );

            toggleMenu?.setAttribute(
              'aria-expanded',
              'true'
            );

            mobileNav.classList.add(
              'expanded'
            );

            mobileNav.setAttribute(
              'data-expanded',
              'true'
            );

            syncMobileHeaderHeight();

            closeDesktopGroups();
          };

        const finishMobileHeaderClose =
          () => {
            clearCloseTimer();

            header.classList.remove(
              'h-screen',
              'expanded',
              'bg-page'
            );

            document.body.classList.remove(
              'overflow-hidden'
            );

            toggleMenu?.classList.remove(
              'expanded'
            );

            toggleMenu?.setAttribute(
              'aria-expanded',
              'false'
            );

            if (mobileNav) {
              mobileNav.classList.remove(
                'expanded'
              );

              mobileNav.setAttribute(
                'data-expanded',
                'false'
              );
            }

            closeMobileGroups(
              true
            );
          };

        const setMobileHeaderClosing =
          () => {
            clearCloseTimer();

            if (!mobileNav) {
              finishMobileHeaderClose();
              return;
            }

            toggleMenu?.classList.remove(
              'expanded'
            );

            toggleMenu?.setAttribute(
              'aria-expanded',
              'false'
            );

            closeMobileGroups(
              true
            );

            mobileNav.classList.remove(
              'expanded'
            );

            mobileNav.setAttribute(
              'data-expanded',
              'false'
            );

            closeTimer =
              window.setTimeout(
                () => {
                  finishMobileHeaderClose();
                },
                480
              );
          };

        mobileNav?.addEventListener(
          'transitionend',
          (event) => {
            if (
              !(
                event instanceof
                TransitionEvent
              )
            ) {
              return;
            }

            if (
              event.propertyName !==
                'opacity' &&
              event.propertyName !==
                'transform'
            ) {
              return;
            }

            if (
              mobileNav.classList.contains(
                'expanded'
              )
            ) {
              return;
            }

            finishMobileHeaderClose();
          },
          { signal }
        );

        /* =====================================================
           ToggleMenu
        ===================================================== */

        if (toggleMenu) {
          toggleMenu.addEventListener(
            'click',
            (event) => {
              event.preventDefault();

              event.stopImmediatePropagation();

              const expanded =
                toggleMenu.classList.contains(
                  'expanded'
                );

              if (expanded) {
                setMobileHeaderClosing();
              } else {
                setMobileHeaderOpen();
              }
            },
            {
              signal,
              capture: true,
            }
          );
        }

        /* =====================================================
           Mobile links
        ===================================================== */

        header
          .querySelectorAll<HTMLAnchorElement>(
            '.hsdc-mobile-submenu a'
          )
          .forEach((link) => {
            link.addEventListener(
              'click',
              () => {
                clearCloseTimer();
                finishMobileHeaderClose();
              },
              { signal }
            );
          });

        header
          .querySelectorAll<HTMLAnchorElement>(
            '.hsdc-mobile-home'
          )
          .forEach((link) => {
            link.addEventListener(
              'click',
              () => {
                clearCloseTimer();
                finishMobileHeaderClose();
              },
              { signal }
            );
          });

        /* =====================================================
           初始状态
        ===================================================== */

        closeDesktopGroups();

        clearCloseTimer();

        header.classList.remove(
          'h-screen',
          'expanded',
          'bg-page'
        );

        document.body.classList.remove(
          'overflow-hidden'
        );

        toggleMenu?.classList.remove(
          'expanded'
        );

        toggleMenu?.setAttribute(
          'aria-expanded',
          'false'
        );

        if (mobileNav) {
          mobileNav.classList.remove(
            'expanded'
          );

          mobileNav.setAttribute(
            'data-expanded',
            'false'
          );
        }

        closeMobileGroups(
          true
        );

        /* =====================================================
           Breakpoint
        ===================================================== */

        const mediaQuery =
          window.matchMedia(
            '(min-width: 768px)'
          );

        const handleMediaChange =
          () => {
            clearCloseTimer();

            if (
              mediaQuery.matches
            ) {
              finishMobileHeaderClose();
              closeDesktopGroups();
            } else {
              closeDesktopGroups();
              syncMobileHeaderHeight();
            }
          };

        mediaQuery.addEventListener(
          'change',
          handleMediaChange,
          { signal }
        );
      };

      initHeader();

      document.addEventListener(
        'astro:after-swap',
        () => {
          initHeader();
        }
      );

      document.addEventListener(
        'astro:before-swap',
        () => {
          const currentHeader =
            document.querySelector<HTMLElement>(
              '#header'
            );

          const currentToggle =
            currentHeader?.querySelector<HTMLElement>(
              '[data-aw-toggle-menu]'
            );

          const currentNav =
            currentHeader?.querySelector<HTMLElement>(
              '.hsdc-mobile-nav'
            );

          currentToggle?.classList.remove(
            'expanded'
          );

          currentToggle?.setAttribute(
            'aria-expanded',
            'false'
          );

          currentNav?.classList.remove(
            'expanded'
          );

          currentNav?.setAttribute(
            'data-expanded',
            'false'
          );

          currentHeader?.classList.remove(
            'h-screen',
            'expanded',
            'bg-page'
          );

          document.body.classList.remove(
            'overflow-hidden'
          );
        }
      );
    })();
  </script>
</header>