---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  style="background: rgba(255,255,255,0.25) !important; backdrop-filter: blur(12px) !important; -webkit-backdrop-filter: blur(12px) !important;"
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full transition-[opacity] ease-in-out border-b border-gray-200/30 dark:border-gray-700/30',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <style>
    header#header * {
      background: transparent !important;
    }
    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }
    header#header button:hover,
    header#header a:hover {
      background: rgba(255,255,255,0.1) !important;
    }
    .dark header#header button:hover,
    .dark header#header a:hover {
      background: rgba(255,255,255,0.05) !important;
    }

    /* 遮罩层 */
    #menu-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: transparent !important;
      z-index: 9998;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    #menu-overlay.open {
      pointer-events: auto;
    }

    /* 手机菜单 */
    #mobile-menu {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 280px;
      background: rgba(255,255,255,0.85) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: -4px 0 20px rgba(0,0,0,0.08);
      z-index: 9999;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 80px 24px 24px 24px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }
    .dark #mobile-menu {
      background: rgba(17, 24, 39, 0.85) !important;
    }
    #mobile-menu.open {
      transform: translateX(0);
    }

    /* 关闭按钮 */
    #menu-close-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      font-size: 24px;
      color: #333;
      background: none;
      border: none;
      cursor: pointer;
      z-index: 10000;
      padding: 4px 8px;
    }
    .dark #menu-close-btn {
      color: #eee;
    }

    /* 菜单底部 */
    #menu-footer {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid rgba(0,0,0,0.06);
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .dark #menu-footer {
      border-top-color: rgba(255,255,255,0.06);
    }

    /* 汉堡按钮始终可见 */
    .mobile-toggle {
      z-index: 10001 !important;
      position: relative;
    }

    @media (max-width: 767px) {
      .desktop-nav { display: none !important; }
      .mobile-toggle { display: flex !important; }
    }
    @media (min-width: 768px) {
      .desktop-nav { display: flex !important; }
      .mobile-toggle { display: none !important; }
    }
  </style>

  <div class="absolute inset-0" style="background: transparent !important;"></div>
  <div class="relative text-default py-3 px-3 md:px-6 mx-auto w-full flex items-center justify-between">
    <!-- Logo -->
    <a class="flex items-center" href={getHomePermalink()}>
      <Logo />
    </a>

    <!-- 桌面导航 -->
    <nav class="desktop-nav items-center md:flex md:mx-5 text-default" aria-label="Main navigation">
      <ul class="flex flex-row items-center text-[0.9375rem] font-medium gap-1">
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown relative' : ''}>
              {links?.length ? (
                <>
                  <button class="hover:text-link dark:hover:text-white px-3 py-2 flex items-center whitespace-nowrap">
                    {text}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5" />
                  </button>
                  <ul class="dropdown-menu absolute top-full left-0 hidden md:bg-white/90 dark:md:bg-dark rounded shadow-lg min-w-[180px] py-2">
                    {links.map(({ text: t, href: h }) => (
                      <li><a class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700" href={h}>{t}</a></li>
                    ))}
                  </ul>
                </>
              ) : (
                <a class="hover:text-link dark:hover:text-white px-3 py-2 block" href={href}>{text}</a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 右侧：桌面端联系按钮 + 手机端汉堡 -->
    <div class="flex items-center gap-2 flex-nowrap">
      <div class="hidden md:flex items-center gap-2">
        {
          actions?.length ? (
            actions.map((btnProps) => (
              <Button {...btnProps} class="py-1.5 px-4 text-sm font-semibold shadow-none" />
            ))
          ) : ''
        }
      </div>
      <div class="mobile-toggle flex items-center md:hidden">
        <ToggleMenu />
      </div>
    </div>
  </div>

  <!-- 遮罩层 -->
  <div id="menu-overlay"></div>

  <!-- 手机菜单 -->
  <div id="mobile-menu">
    <button id="menu-close-btn" aria-label="关闭菜单">✕</button>

    <ul class="flex flex-col w-full text-lg font-medium">
      {
        links.map(({ text, href, links }) => (
          <li class={links?.length ? 'dropdown' : ''}>
            {links?.length ? (
              <>
                <button class="hover:text-blue-600 dark:hover:text-blue-400 py-3 flex items-center w-full border-b border-gray-100 dark:border-gray-700">
                  {text}
                  <Icon name="tabler:chevron-down" class="w-4 h-4 ml-auto" />
                </button>
                <ul class="pl-4">
                  {links.map(({ text: t, href: h }) => (
                    <li><a class="block py-2 hover:text-blue-600 dark:hover:text-blue-400" href={h}>{t}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class="block py-3 border-b border-gray-100 dark:border-gray-700 hover:text-blue-600 dark:hover:text-blue-400" href={href}>{text}</a>
            )}
          </li>
        ))
      }
    </ul>

    <!-- 菜单底部：主题切换 + 联系我们 -->
    <div id="menu-footer">
      <!-- 主题切换按钮 -->
      <button
        id="theme-toggle"
        type="button"
        class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
        aria-label="切换主题"
      >
        <svg id="theme-icon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>
      {
        actions?.length ? (
          actions.map((btnProps) => (
            <Button {...btnProps} class="py-1.5 px-4 text-sm font-semibold shadow-none" />
          ))
        ) : ''
      }
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // ===== 菜单控制 =====
      const menu = document.getElementById('mobile-menu');
      const overlay = document.getElementById('menu-overlay');
      const toggle = document.querySelector('[data-aw-toggle-menu]');
      const closeBtn = document.getElementById('menu-close-btn');

      function openMenu() {
        menu.classList.add('open');
        overlay.classList.add('open');
        if (toggle) toggle.classList.add('expanded');
      }

      function closeMenu() {
        menu.classList.remove('open');
        overlay.classList.remove('open');
        if (toggle) toggle.classList.remove('expanded');
      }

      if (toggle) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          menu.classList.contains('open') ? closeMenu() : openMenu();
        });
      }

      if (closeBtn) closeBtn.addEventListener('click', closeMenu);
      if (overlay) overlay.addEventListener('click', closeMenu);

      if (menu) {
        menu.querySelectorAll('a, button:not(#menu-close-btn)').forEach(function(el) {
          el.addEventListener('click', closeMenu);
        });
      }

      // ===== 主题切换 =====
      function toggleTheme() {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
        updateIcon();
      }

      function updateIcon() {
        const isDark = document.documentElement.classList.contains('dark');
        const svg = document.getElementById('theme-icon');
        if (svg) {
          if (isDark) {
            svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />`;
          } else {
            svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />`;
          }
        }
      }

      // 初始化主题
      const saved = localStorage.getItem('theme');
      if (saved === 'dark') document.documentElement.classList.add('dark');
      else if (saved === 'light') document.documentElement.classList.remove('dark');
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
      updateIcon();

      document.getElementById('theme-toggle')?.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        toggleTheme();
      });
    });
  </script>
</header>