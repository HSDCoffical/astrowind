---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<!-- ===== 全屏固定容器（一个合成层） ===== -->
<div
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 bottom-0 z-40 pointer-events-none"
  style="background: transparent !important;"
>
  <!-- ===== 状态栏（顶部） ===== -->
  <header class="pointer-events-auto w-full border-b border-gray-200/30 dark:border-gray-700/30" style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;">
    <style>
      /* 所有原有样式保留 */
      header * {
        background: transparent !important;
      }
      header .bg-white,
      header .dark\:bg-gray-900,
      header .bg-gray-100,
      header .bg-gray-50,
      header [class*="bg-"] {
        background: transparent !important;
      }
      header button:hover,
      header a:hover {
        background: rgba(255,255,255,0.1) !important;
      }
      .dark header button:hover,
      .dark header a:hover {
        background: rgba(255,255,255,0.05) !important;
      }
      .menu-theme-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        margin-top: 0.5rem;
        border-top: 1px solid rgba(0,0,0,0.06);
        color: #666;
      }
      .dark .menu-theme-item {
        border-top-color: rgba(255,255,255,0.06);
        color: #aaa;
      }
      @media (min-width: 768px) {
        .menu-theme-item {
          display: none !important;
        }
      }

      /* 手机版禁用毛玻璃 */
      @media (max-width: 768px) {
        header {
          backdrop-filter: none !important;
          -webkit-backdrop-filter: none !important;
        }
      }
    </style>

    <div class="absolute inset-0" style="background: transparent !important;"></div>
    <div
      class:list={[
        'relative text-default py-1.5 px-3 md:px-6 mx-auto w-full',
        {
          'md:flex md:justify-between': position !== 'center',
        },
        {
          'md:grid md:grid-cols-3 md:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
        <a class="flex items-center" href={getHomePermalink()}>
          <Logo />
        </a>
        <div class="flex items-center md:hidden">
          <ToggleMenu />
        </div>
      </div>

      <!-- 导航菜单 -->
      <nav
        class="items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-visible md:justify-self-center"
        aria-label="Main navigation"
      >
        <ul
          class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
        >
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                    >
                      {text}{' '}
                      <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                    </button>
                    <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                              { 'aw-link-active': href2 === currentPath },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
          <li class="menu-theme-item">
            <ToggleTheme iconClass="w-5 h-5" />
            <span class="text-sm">切换主题</span>
          </li>
        </ul>
      </nav>

      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden md:self-center md:flex items-center md:mb-0 fixed w-full md:w-auto md:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0 md:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full md:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </header>

  <!-- ===== 底部搜索框（固定在底部，同一容器） ===== -->
  <div class="pointer-events-auto absolute bottom-0 left-0 right-0 px-4 pb-4 pt-2">
    <div class="max-w-2xl mx-auto">
      <form id="search-form" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
        <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
        <input
          id="search-input"
          type="text"
          name="q"
          placeholder="搜索本站内容..."
          class="w-full py-3 px-6 pl-12 bg-white/20 backdrop-blur-sm md:backdrop-blur-lg border border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg"
          autocomplete="off"
        />
        <button
          type="button"
          id="search-toggle"
          class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700 transition-colors"
          aria-label="聚焦搜索框"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <button
          type="button"
          id="mode-toggle"
          class="absolute right-4 top-1/2 transform -translate-y-1/2 text-xs text-gray-500 bg-white/30 backdrop-blur-sm px-2 py-1 rounded-full hover:bg-white/50 transition-colors"
        >
          <span id="mode-label">站外</span>
        </button>
      </form>
      <div id="search-results-container" class="mt-2 bg-white/20 backdrop-blur-lg border border-white/30 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
    </div>
  </div>
</div>

<script>
  (function() {
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const toggleBtn = document.getElementById('search-toggle');
    const modeToggle = document.getElementById('mode-toggle');
    const modeLabel = document.getElementById('mode-label');
    const resultsContainer = document.getElementById('search-results-container');

    if (!form || !input) return;

    let mode = 'external';
    let searchData = null;

    async function loadSearchData() {
      try {
        const resp = await fetch('/search.json');
        if (resp.ok) searchData = await resp.json();
      } catch (e) {}
    }

    function searchInternal(query) {
      if (!searchData || !query.trim()) return [];
      const q = query.toLowerCase().trim();
      return searchData
        .filter(page => {
          const title = page.title.toLowerCase();
          const desc = page.description.toLowerCase();
          const content = page.content.toLowerCase();
          return title.includes(q) || desc.includes(q) || content.includes(q);
        })
        .slice(0, 10);
    }

    function showResults(results) {
      resultsContainer.innerHTML = '';
      if (results.length === 0) { resultsContainer.classList.add('hidden'); return; }
      let html = '';
      for (const page of results) {
        html += `<a href="${page.url}" class="block px-4 py-2 hover:bg-white/20 transition-colors border-b border-white/10 last:border-0"><div class="font-medium text-gray-800">${page.title}</div><div class="text-sm text-gray-600 truncate">${page.description}</div></a>`;
      }
      resultsContainer.innerHTML = html;
      resultsContainer.classList.remove('hidden');
    }

    function clearResults() {
      resultsContainer.innerHTML = '';
      resultsContainer.classList.add('hidden');
    }

    function updateMode(newMode) {
      mode = newMode;
      clearResults();
      if (mode === 'external') {
        form.action = 'https://www.bing.com/search';
        form.target = '_blank';
        let hidden = form.querySelector('input[name="q1"]');
        if (!hidden) { hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = 'q1'; form.appendChild(hidden); }
        hidden.value = 'site:hsdc.dpdns.org';
        input.name = 'q';
        input.placeholder = '搜索本站内容...';
        modeLabel.textContent = '站外';
      } else {
        form.action = '#';
        form.target = '';
        const hidden = form.querySelector('input[name="q1"]');
        if (hidden) hidden.remove();
        input.name = '';
        input.placeholder = '输入关键词检索本站';
        modeLabel.textContent = '站内';
        if (input.value.trim()) { const results = searchInternal(input.value); showResults(results); }
      }
    }

    input.addEventListener('input', function() {
      if (mode === 'internal') {
        const query = this.value.trim();
        if (!query) { clearResults(); return; }
        const results = searchInternal(query);
        showResults(results);
      } else { clearResults(); }
    });

    document.addEventListener('click', function(e) {
      const container = document.querySelector('.absolute.bottom-0');
      if (container && !container.contains(e.target)) { clearResults(); }
    });

    modeToggle.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      const newMode = mode === 'external' ? 'internal' : 'external';
      updateMode(newMode);
    });

    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      input.focus();
    });

    updateMode('external');
    loadSearchData();
  })();
</script>