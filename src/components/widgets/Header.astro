---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  style="background: rgba(255,255,255,0.25) !important; backdrop-filter: blur(12px) !important; -webkit-backdrop-filter: blur(12px) !important;"
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full transition-[opacity] ease-in-out border-b border-gray-200/30 dark:border-gray-700/30',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <style>
    header#header * {
      background: transparent !important;
    }
    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }
    header#header button:hover,
    header#header a:hover {
      background: rgba(255,255,255,0.1) !important;
    }
    .dark header#header button:hover,
    .dark header#header a:hover {
      background: rgba(255,255,255,0.05) !important;
    }

    /* 自定义汉堡按钮 - 三条线变 X */
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 28px;
      height: 20px;
      cursor: pointer;
      background: transparent;
      border: none;
      padding: 0;
    }
    .hamburger span {
      display: block;
      height: 2.5px;
      width: 100%;
      background-color: currentColor;
      border-radius: 2px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform-origin: center;
    }
    .hamburger.expanded span:nth-child(1) {
      transform: translateY(8.5px) rotate(45deg);
    }
    .hamburger.expanded span:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }
    .hamburger.expanded span:nth-child(3) {
      transform: translateY(-8.5px) rotate(-45deg);
    }

    /* 手机端半覆盖菜单浮层 - 覆盖右侧75% */
    .mobile-nav-list {
      display: none;
      position: absolute;
      top: 100%;
      right: 0;
      left: auto;
      width: 75%;
      margin-top: 0;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 0 0 0 20px;
      box-shadow: -8px 12px 40px rgba(0,0,0,0.08);
      padding: 16px 0 12px 0;
      max-height: 70vh;
      overflow: hidden;
      z-index: 50;
    }
    .dark .mobile-nav-list {
      background: rgba(17, 24, 39, 0.92);
    }
    .mobile-nav-list.open {
      display: block;
    }

    .mobile-nav-scroll {
      max-height: calc(70vh - 80px);
      overflow-y: auto;
      padding: 0 0 4px 0;
    }

    .mobile-nav-list > div {
      padding: 0 16px;
      margin-bottom: 2px;
    }
    .mobile-nav-list a,
    .mobile-nav-list button {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      color: #333;
      font-weight: 500;
      font-size: 1rem;
      border-radius: 12px;
      background: rgba(0,0,0,0.02);
      transition: background 0.2s;
      width: 100%;
      border: none;
      cursor: pointer;
    }
    .dark .mobile-nav-list a,
    .dark .mobile-nav-list button {
      color: #eee;
      background: rgba(255,255,255,0.03);
    }
    .mobile-nav-list a:hover,
    .mobile-nav-list button:hover {
      background: rgba(0,0,0,0.06);
    }
    .dark .mobile-nav-list a:hover,
    .dark .mobile-nav-list button:hover {
      background: rgba(255,255,255,0.06);
    }

    .mobile-nav-list .dropdown-sub {
      padding-left: 20px;
      margin-top: 2px;
      display: none;
    }
    .mobile-nav-list .dropdown-sub.open {
      display: block;
    }
    .mobile-nav-list .dropdown-sub a {
      padding: 10px 16px;
      font-size: 0.95rem;
      font-weight: 400;
      border-radius: 10px;
      background: transparent;
    }
    .mobile-nav-list .dropdown-sub a:hover {
      background: rgba(0,0,0,0.04);
    }
    .dark .mobile-nav-list .dropdown-sub a:hover {
      background: rgba(255,255,255,0.04);
    }

    .menu-theme-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 12px 16px;
      margin: 0 16px;
      margin-top: 8px;
      border-top: 1px solid rgba(0,0,0,0.06);
      color: #666;
      border-radius: 12px;
    }
    .dark .menu-theme-item {
      border-top-color: rgba(255,255,255,0.06);
      color: #aaa;
    }
    .menu-theme-item span {
      font-size: 0.95rem;
      font-weight: 500;
    }

    @media (min-width: 768px) {
      .mobile-nav-list {
        display: none !important;
      }
      .menu-theme-item {
        display: none !important;
      }
    }
    @media (max-width: 767px) {
      .desktop-nav {
        display: none !important;
      }
    }
  </style>

  <div class="absolute inset-0" style="background: transparent !important;"></div>
  <div
    class="relative text-default py-3 px-3 md:px-6 mx-auto w-full"
    style="position: relative;"
  >
    <div class="flex items-center justify-between">
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center gap-2">
        <div class="hidden md:flex items-center gap-2">
          {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
          {
            actions?.length ? (
              actions.map((btnProps) => (
                <Button {...btnProps} class="py-1.5 px-4 text-sm font-semibold shadow-none" />
              ))
            ) : ''
          }
        </div>
        <!-- 自定义汉堡按钮 -->
        <button
          id="hamburger-btn"
          class="hamburger flex items-center md:hidden"
          aria-label="切换菜单"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- 桌面导航 -->
    <nav
      class="desktop-nav items-center w-full md:w-auto hidden md:flex md:mx-5 text-default overflow-y-auto overflow-x-hidden md:overflow-visible md:justify-self-center"
      aria-label="Main navigation"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline" />
                  </button>
                  <ul class="dropdown-menu md:backdrop-blur-md dark:md:bg-dark rounded md:absolute pl-4 md:pl-0 md:hidden font-medium md:bg-white/90 md:min-w-[200px] drop-shadow-xl">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b md:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-no-wrap',
                            { 'aw-link-active': href2 === currentPath },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': href === currentPath },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- 手机端半覆盖菜单浮层 -->
    <div id="mobile-nav" class="mobile-nav-list">
      <div class="mobile-nav-scroll">
        {
          links.map(({ text, href, links }) => (
            <div>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="flex items-center justify-between w-full"
                    onclick="this.nextElementSibling.classList.toggle('open')"
                  >
                    {text}
                    <Icon name="tabler:chevron-down" class="w-4 h-4 transition-transform" />
                  </button>
                  <div class="dropdown-sub">
                    {links.map(({ text: t, href: h }) => (
                      <a href={h} class="block">{t}</a>
                    ))}
                  </div>
                </>
              ) : (
                <a href={href}>{text}</a>
              )}
            </div>
          ))
        }
      </div>
      <div class="menu-theme-item">
        <ToggleTheme iconClass="w-5 h-5" />
        <span>切换主题</span>
      </div>
    </div>
  </div>

  <script>
    function initMobileMenu() {
      const hamburger = document.getElementById('hamburger-btn');
      const mobileNav = document.getElementById('mobile-nav');
      if (!hamburger || !mobileNav) return;

      // 移除之前可能绑定的监听器（防止重复）
      const toggleHandler = function(e) {
        e.stopPropagation();
        mobileNav.classList.toggle('open');
        hamburger.classList.toggle('expanded');
      };
      // 移除旧监听器（如果有）
      hamburger.removeEventListener('click', toggleHandler);
      hamburger.addEventListener('click', toggleHandler);

      const closeMenu = function() {
        mobileNav.classList.remove('open');
        hamburger.classList.remove('expanded');
      };

      // 为菜单内链接和按钮绑定关闭事件
      mobileNav.querySelectorAll('a, button').forEach(el => {
        // 移除旧监听器
        el.removeEventListener('click', closeMenu);
        el.addEventListener('click', function(e) {
          if (this.closest('.dropdown-sub')) return;
          closeMenu();
        });
      });

      // 点击外部关闭
      const outsideClose = function(e) {
        if (!mobileNav.contains(e.target) && !hamburger.contains(e.target)) {
          closeMenu();
        }
      };
      document.removeEventListener('click', outsideClose);
      document.addEventListener('click', outsideClose);

      // 当窗口 resize 到桌面时关闭菜单
      const resizeClose = function() {
        if (window.innerWidth >= 768 && mobileNav.classList.contains('open')) {
          closeMenu();
        }
      };
      window.removeEventListener('resize', resizeClose);
      window.addEventListener('resize', resizeClose);
    }

    // 首次加载时初始化
    document.addEventListener('DOMContentLoaded', initMobileMenu);
    // Astro 视图切换后重新初始化
    document.addEventListener('astro:after-swap', initMobileMenu);
  </script>
</header>