---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { getHomePermalink } from '~/utils/permalinks';

export interface Props {
  links?: Array<{
    text?: string;
    href?: string;
    links?: Array<{
      text?: string;
      href?: string;
      links?: Array<{
        text?: string;
        href?: string;
      }>;
    }>;
  }>;
  actions?: Array<{
    text?: string;
    href?: string;
    icon?: string;
  }>;
  isSticky?: boolean;
  isDark?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: 'left' | 'center' | 'right';
  isFullWidth?: boolean;
}

const {
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  showToggleTheme = true,
  showRssFeed = false,
  position = 'right',
  isFullWidth = false,
} = Astro.props;

const desktopFirstLinks = links.slice(0, 3);
const desktopSecondLinks = links.slice(3);
---

<header
  id="header"
  class:list={[
    'fixed top-0 z-40 w-full',
    {
      'sticky top-0': isSticky,
    },
  ]}
>
  <!-- ========================================================= -->
  <!-- 手机端：独立保留原来的 Header，不参与电脑端布局 -->
  <!-- ========================================================= -->

  <div class="hsdc-mobile-header md:hidden">
    <div
      class:list={[
        'relative text-default py-1.5 px-3',
        'mx-auto w-full',
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class="flex items-center justify-between">
        <!-- 手机端 Logo + 品牌名称 -->
        <div class="flex items-center min-w-0">
          <a
            class="flex items-center shrink-0"
            href={getHomePermalink()}
            aria-label="凉宫数据"
          >
            <Logo />
          </a>

          <span class="hsdc-mobile-brand-name">
            凉宫数据开放平台
          </span>
        </div>

        <!-- 手机端原来的菜单按钮 -->
        <div class="flex items-center">
          <ToggleMenu />
        </div>
      </div>

      <!-- 手机端导航 -->
      <nav
        id="hsdc-mobile-nav"
        aria-label="手机端主导航"
      >
        <ul class="flex flex-col gap-1 py-3">
          {
            links.map(({ text, href, links: childLinks }) => (
              <li>
                {childLinks && childLinks.length > 0 ? (
                  <details>
                    <summary class="hsdc-mobile-nav-link">
                      {text}
                      <Icon
                        name="tabler:chevron-down"
                        class="h-4 w-4 shrink-0"
                      />
                    </summary>

                    <ul class="pl-4 pt-1">
                      {childLinks.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="hsdc-mobile-nav-link"
                          >
                            {child.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={href}
                    class="hsdc-mobile-nav-link"
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }

          {
            showToggleTheme && (
              <li class="hsdc-mobile-theme">
                <ToggleTheme />
              </li>
            )
          }

          {
            showRssFeed && (
              <li>
                <a
                  href="/rss.xml"
                  class="hsdc-mobile-nav-link"
                >
                  RSS
                </a>
              </li>
            )
          }

          {
            actions.map((action) => (
              <li>
                <a
                  href={action.href}
                  class="hsdc-mobile-nav-link"
                >
                  {action.icon && (
                    <Icon
                      name={action.icon}
                      class="h-4 w-4"
                    />
                  )}
                  {action.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- 电脑端：完全独立的一套 Header -->
  <!-- ========================================================= -->

  <div class="hsdc-desktop-header hidden md:block">
    <div
      class:list={[
        'hsdc-desktop-inner',
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <!-- Logo + 品牌 -->
      <div class="hsdc-desktop-brand">
        <a
          href={getHomePermalink()}
          class="hsdc-desktop-logo"
          aria-label="凉宫数据"
        >
          <Logo />
        </a>

        <span class="hsdc-desktop-brand-name">
          凉宫数据开放平台
        </span>
      </div>

      <!-- 搜索框预留区域 -->
      <div
        class="hsdc-desktop-search-placeholder"
        aria-hidden="true"
      ></div>

      <!-- ===================================================== -->
      <!-- 电脑端导航 -->
      <!-- ===================================================== -->

      <div class="hsdc-desktop-navigation">
        <!-- 第一页 -->
        <div
          id="hsdc-desktop-page-one"
          class="hsdc-nav-page is-active"
        >
          {
            desktopFirstLinks.map(({ text, href }) => (
              <a
                href={href}
                class="hsdc-desktop-nav-link"
              >
                {text}
              </a>
            ))
          }
        </div>

        <!-- 第二页 -->
        <div
          id="hsdc-desktop-page-two"
          class="hsdc-nav-page"
          aria-hidden="true"
        >
          {
            desktopSecondLinks.map(({ text, href }) => (
              <a
                href={href}
                class="hsdc-desktop-nav-link"
              >
                {text}
              </a>
            ))
          }
        </div>
      </div>

      <!-- ===================================================== -->
      <!-- 左右切换 + 主题 -->
      <!-- ===================================================== -->

      <div class="hsdc-desktop-actions">
        <button
          id="hsdc-desktop-nav-switch"
          type="button"
          class="hsdc-nav-switch"
          aria-label="切换导航"
          aria-expanded="false"
        >
          <Icon
            id="hsdc-arrow-right"
            name="tabler:chevron-right"
            class="h-5 w-5"
          />

          <Icon
            id="hsdc-arrow-left"
            name="tabler:chevron-left"
            class="hsdc-arrow-hidden h-5 w-5"
          />
        </button>

        {
          showToggleTheme && (
            <div class="hsdc-desktop-theme">
              <ToggleTheme />
            </div>
          )
        }

        {
          showRssFeed && (
            <a
              href="/rss.xml"
              class="hsdc-desktop-rss"
              aria-label="RSS"
            >
              <Icon
                name="tabler:rss"
                class="h-5 w-5"
              />
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

<style>
  /* ========================================================= */
  /* 全局 Header 基础 */
  /* ========================================================= */

  header#header {
    width: 100%;
    background: transparent;
  }

  header#header * {
    box-sizing: border-box;
  }

  /* ========================================================= */
  /* 手机端 */
  /* ========================================================= */

  .hsdc-mobile-header {
    width: 100%;
    background: transparent;
  }

  .hsdc-mobile-brand-name {
    margin-left: 10px;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--aw-color-text-default, currentColor);
  }

  .hsdc-mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    width: 100%;
    min-height: 44px;

    padding: 10px 12px;

    border-radius: 12px;

    color: inherit;
    text-decoration: none;

    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .hsdc-mobile-nav-link:hover {
    background: rgba(127, 127, 127, 0.08);
  }

  .hsdc-mobile-nav-link:active {
    transform: scale(0.98);
  }

  .hsdc-mobile-theme {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
  }

  /*
   * 手机端菜单默认隐藏。
   * ToggleMenu 原有逻辑会给 Header / nav 添加 expanded 状态。
   */
  @media (max-width: 767px) {
    #hsdc-mobile-nav {
      display: block !important;
      width: 100%;

      max-height: 0;
      opacity: 0;
      overflow: hidden;

      transform: translateY(-8px);

      visibility: hidden;
      pointer-events: none;

      transition:
        max-height 0.35s ease,
        opacity 0.25s ease,
        transform 0.3s ease,
        visibility 0.35s ease;
    }

    header#header:has(.expanded) #hsdc-mobile-nav,
    header#header:has([aria-expanded='true']) #hsdc-mobile-nav,
    #hsdc-mobile-nav.expanded,
    #hsdc-mobile-nav[data-expanded='true'] {
      max-height: calc(100vh - 72px);

      opacity: 1;
      overflow-y: auto;

      transform: translateY(0);

      visibility: visible;
      pointer-events: auto;
    }
  }

  /* ========================================================= */
  /* 电脑端 Header */
  /* ========================================================= */

  .hsdc-desktop-header {
    width: 100%;

    background:
      linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.82),
        rgba(255, 255, 255, 0.62)
      );

    border-bottom: 1px solid rgba(100, 116, 139, 0.08);

    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }

  .dark .hsdc-desktop-header {
    background:
      linear-gradient(
        to bottom,
        rgba(15, 23, 42, 0.78),
        rgba(15, 23, 42, 0.58)
      );

    border-bottom-color: rgba(148, 163, 184, 0.08);
  }

  .hsdc-desktop-inner {
    width: 100%;
    min-height: 64px;

    margin: 0 auto;
    padding: 0 24px;

    display: flex;
    align-items: center;

    gap: 0;
  }

  /* ========================================================= */
  /* Logo + 品牌 */
  /* ========================================================= */

  .hsdc-desktop-brand {
    display: flex;
    align-items: center;

    flex: 0 0 auto;

    white-space: nowrap;
  }

  .hsdc-desktop-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;

    text-decoration: none;
  }

  .hsdc-desktop-brand-name {
    margin-left: 12px;

    font-size: 0.95rem;
    font-weight: 650;

    letter-spacing: -0.02em;

    color: var(--aw-color-text-default, currentColor);

    white-space: nowrap;
  }

  /* ========================================================= */
  /* 搜索框预留空间 */
  /* ========================================================= */

  .hsdc-desktop-search-placeholder {
    /*
     * 这里现在故意不放搜索框。
     * 以后真正做站内搜索时，直接替换这个区域即可。
     */
    flex: 1 1 auto;

    min-width: 40px;
    max-width: 240px;

    height: 40px;

    margin-left: 28px;
    margin-right: 24px;
  }

  /* ========================================================= */
  /* 电脑端导航容器 */
  /* ========================================================= */

  .hsdc-desktop-navigation {
    position: relative;

    display: flex;
    align-items: center;

    flex: 0 0 auto;

    min-width: 0;

    height: 42px;
  }

  .hsdc-nav-page {
    display: flex;
    align-items: center;
    gap: 3px;

    white-space: nowrap;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateX(8px);

    transition:
      opacity 0.22s ease,
      transform 0.28s ease,
      visibility 0.22s ease;
  }

  .hsdc-nav-page.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateX(0);
  }

  #hsdc-desktop-page-two {
    position: absolute;
    right: 0;
    top: 50%;

    transform: translate(8px, -50%);
  }

  #hsdc-desktop-page-two.is-active {
    transform: translate(0, -50%);
  }

  .hsdc-desktop-nav-link {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 38px;

    padding: 0 11px;

    border-radius: 10px;

    color: inherit;
    text-decoration: none;

    font-size: 0.86rem;
    font-weight: 500;

    white-space: nowrap;

    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .hsdc-desktop-nav-link:hover {
    background: rgba(127, 127, 127, 0.08);
  }

  .hsdc-desktop-nav-link:active {
    transform: scale(0.96);
  }

  /* ========================================================= */
  /* 右侧操作区 */
  /* ========================================================= */

  .hsdc-desktop-actions {
    display: flex;
    align-items: center;

    flex: 0 0 auto;

    margin-left: 7px;
  }

  .hsdc-nav-switch,
  .hsdc-desktop-rss {
    width: 38px;
    height: 38px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 0;
    border-radius: 10px;

    background: transparent;

    color: inherit;

    cursor: pointer;

    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .hsdc-nav-switch:hover,
  .hsdc-desktop-rss:hover {
    background: rgba(127, 127, 127, 0.08);
  }

  .hsdc-nav-switch:active,
  .hsdc-desktop-rss:active {
    transform: scale(0.88);
  }

  .hsdc-desktop-theme {
    display: flex;
    align-items: center;
    justify-content: center;

    margin-left: 3px;
  }

  .hsdc-arrow-hidden {
    display: none;
  }

  /* ========================================================= */
  /* 导航切换动画 */
  /* ========================================================= */

  .hsdc-nav-page.is-leaving {
    opacity: 0;
    transform: translateX(-8px);
  }

  .hsdc-nav-page.is-entering {
    opacity: 0;
    transform: translateX(8px);
  }

  /* ========================================================= */
  /* 深色模式 */
  /* ========================================================= */

  .dark .hsdc-desktop-nav-link:hover,
  .dark .hsdc-nav-switch:hover,
  .dark .hsdc-desktop-rss:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  /* ========================================================= */
  /* 桌面端较窄屏幕优化 */
  /* ========================================================= */

  @media (min-width: 768px) and (max-width: 1100px) {
    .hsdc-desktop-inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    .hsdc-desktop-brand-name {
      font-size: 0.86rem;
    }

    .hsdc-desktop-search-placeholder {
      min-width: 20px;
      max-width: 100px;

      margin-left: 16px;
      margin-right: 12px;
    }

    .hsdc-desktop-nav-link {
      padding-left: 7px;
      padding-right: 7px;

      font-size: 0.8rem;
    }

    .hsdc-nav-switch {
      width: 34px;
    }
  }

  /* ========================================================= */
  /* 手机端绝不显示电脑端 */
  /* ========================================================= */

  @media (max-width: 767px) {
    .hsdc-desktop-header {
      display: none !important;
    }

    .hsdc-mobile-header {
      display: block !important;
    }
  }

  /* ========================================================= */
  /* 电脑端绝不显示手机端 */
  /* ========================================================= */

  @media (min-width: 768px) {
    .hsdc-mobile-header {
      display: none !important;
    }

    .hsdc-desktop-header {
      display: block !important;
    }
  }

  /* ========================================================= */
  /* 减少动态效果 */
  /* ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .hsdc-nav-page,
    .hsdc-nav-link,
    .hsdc-nav-switch,
    .hsdc-desktop-nav-link,
    #hsdc-mobile-nav {
      transition: none !important;
    }
  }
</style>

<script>
  function initHSDCDesktopHeader() {
    const switchButton = document.querySelector<HTMLButtonElement>(
      '#hsdc-desktop-nav-switch'
    );

    const pageOne = document.querySelector<HTMLElement>(
      '#hsdc-desktop-page-one'
    );

    const pageTwo = document.querySelector<HTMLElement>(
      '#hsdc-desktop-page-two'
    );

    const arrowRight = document.querySelector<HTMLElement>(
      '#hsdc-arrow-right'
    );

    const arrowLeft = document.querySelector<HTMLElement>(
      '#hsdc-arrow-left'
    );

    if (
      !switchButton ||
      !pageOne ||
      !pageTwo ||
      !arrowRight ||
      !arrowLeft
    ) {
      return;
    }

    /*
     * 防止 Astro 页面切换 / 重复初始化时
     * 绑定多个 click 事件。
     */
    if (switchButton.dataset.initialized === 'true') {
      return;
    }

    switchButton.dataset.initialized = 'true';

    let secondPage = false;

    switchButton.addEventListener('click', () => {
      secondPage = !secondPage;

      if (secondPage) {
        pageOne.classList.remove('is-active');
        pageOne.classList.add('is-leaving');

        pageTwo.classList.add('is-entering');

        window.setTimeout(() => {
          pageTwo.classList.add('is-active');
          pageTwo.classList.remove('is-entering');

          pageOne.classList.remove('is-leaving');
        }, 90);

        arrowRight.classList.add('hsdc-arrow-hidden');
        arrowLeft.classList.remove('hsdc-arrow-hidden');

        switchButton.setAttribute('aria-expanded', 'true');
      } else {
        pageTwo.classList.remove('is-active');
        pageTwo.classList.add('is-leaving');

        pageOne.classList.add('is-entering');

        window.setTimeout(() => {
          pageOne.classList.add('is-active');
          pageOne.classList.remove('is-entering');

          pageTwo.classList.remove('is-leaving');
        }, 90);

        arrowLeft.classList.add('hsdc-arrow-hidden');
        arrowRight.classList.remove('hsdc-arrow-hidden');

        switchButton.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initHSDCDesktopHeader();

  document.addEventListener(
    'astro:after-swap',
    initHSDCDesktopHeader
  );
</script>