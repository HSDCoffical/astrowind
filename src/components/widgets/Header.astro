---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-40 flex-none mx-auto w-full border-b border-gray-200/30 dark:border-gray-700/30',
    'transform-gpu will-change-transform backface-hidden',
  ]}
  style="background: rgba(255,255,255,0.25) !important; backdrop-filter: blur(12px) !important; -webkit-backdrop-filter: blur(12px) !important;"
>
  <style>
    /* 原有样式保留 */
    header#header * {
      background: transparent !important;
    }
    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }
    header#header button:hover,
    header#header a:hover {
      background: rgba(255,255,255,0.1) !important;
    }
    .dark header#header button:hover,
    .dark header#header a:hover {
      background: rgba(255,255,255,0.05) !important;
    }
    .menu-theme-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      margin-top: 0.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      color: #666;
    }
    .dark .menu-theme-item {
      border-top-color: rgba(255,255,255,0.06);
      color: #aaa;
    }
    @media (min-width: 768px) {
      .menu-theme-item {
        display: none !important;
      }
    }

    /* ====== 新增修复 ====== */
    /* 禁用滚动锚定，防止浏览器自动调整滚动位置导致回弹 */
    html {
      overflow-anchor: none;
    }

    /* 让 header 独立合成层，并隔离布局影响，减少重绘 */
    header#header {
      contain: layout style;
      will-change: transform;
      transition: none; /* 确保没有任何过渡干扰 */
    }

    /* 移动端降低模糊强度，减少 GPU 压力（可选） */
    @media (max-width: 768px) {
      header#header {
        backdrop-filter: blur(8px) !important;
        -webkit-backdrop-filter: blur(8px) !important;
      }
    }
  </style>

  <!-- 以下所有 HTML 结构完全不变，省略显示，保持原样 -->
  <div class="absolute inset-0" style="background: transparent !important;"></div>
  <!-- ... 你的全部原有内容 ... -->
</header>