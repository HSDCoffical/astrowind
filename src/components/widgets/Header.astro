---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuGroup {
  text: string;
  links: Array<Link>;
}

export interface Props {
  id?: string;
  groups?: Array<MenuGroup>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  groups = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30 hsdc-header"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    /* =========================================================
       基础
    ========================================================= */

    header#header {
      transition:
        background-color 280ms ease,
        border-color 280ms ease,
        box-shadow 280ms ease;
    }

    header#header * {
      background: transparent !important;
    }

    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }


    /* =========================================================
       Logo / 品牌
    ========================================================= */

    .hsdc-brand {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      text-decoration: none;

      transition:
        transform 220ms ease,
        opacity 220ms ease;
    }

    .hsdc-brand:hover {
      transform: translateY(-1px);
      opacity: 0.94;
    }


    /* =========================================================
       手机 / 桌面端基础显示
    ========================================================= */

    .hsdc-mobile-header {
      display: flex;
    }

    .hsdc-desktop-header {
      display: none;
    }


    /* =========================================================
       手机端
    ========================================================= */

    @media (max-width: 767px) {

      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }

      .hsdc-mobile-header {
        display: flex;
      }

      .hsdc-desktop-header {
        display: none !important;
      }


      /* =====================================================
         手机主菜单
      ====================================================== */

      .hsdc-mobile-nav {
        display: block !important;

        width: 100%;
        max-height: 0;

        opacity: 0;
        overflow: hidden;

        transform: translateY(-8px);

        visibility: hidden;
        pointer-events: none;

        transition:
          max-height 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.22s ease,
          transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0.38s;
      }

      header#header .hsdc-mobile-nav.expanded,
      header#header .hsdc-mobile-nav[data-expanded="true"],
      header#header:has(.expanded) .hsdc-mobile-nav {
        max-height: calc(100vh - 72px);

        opacity: 1;

        transform: translateY(0);

        visibility: visible;
        pointer-events: auto;

        overflow-y: auto;

        transition:
          max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.25s ease,
          transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
      }


      /* =====================================================
         一级板块
      ====================================================== */

      .hsdc-mobile-groups {
        padding-top: 8px;
        padding-bottom: 12px;
      }

      .hsdc-mobile-group-item {
        opacity: 0;

        transform: translateY(-8px);

        transition:
          opacity 0.24s ease,
          transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      }

      header#header:has(.expanded) .hsdc-mobile-group-item {
        opacity: 1;
        transform: translateY(0);
      }

      header#header:has(.expanded) .hsdc-mobile-group-item:nth-child(1) {
        transition-delay: 0.04s;
      }

      header#header:has(.expanded) .hsdc-mobile-group-item:nth-child(2) {
        transition-delay: 0.08s;
      }

      header#header:has(.expanded) .hsdc-mobile-group-item:nth-child(3) {
        transition-delay: 0.12s;
      }


      /* =====================================================
         手机 details / summary
      ====================================================== */

      .hsdc-mobile-group {
        width: 100%;
      }

      .hsdc-mobile-group summary {
        list-style: none;
        cursor: pointer;
      }

      .hsdc-mobile-group summary::-webkit-details-marker {
        display: none;
      }

      .hsdc-mobile-group-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;

        width: 100%;
        box-sizing: border-box;

        padding: 13px 16px;

        font-size: 1.05rem;
        font-weight: 500;

        transition:
          transform 160ms ease,
          opacity 160ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-group-trigger:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-mobile-group-chevron {
        width: 18px;
        height: 18px;

        transition:
          transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-group-chevron {
        transform: rotate(180deg);
      }

      .hsdc-mobile-group.is-closing
      .hsdc-mobile-group-chevron {
        transform: rotate(0deg);
      }


      /* =====================================================
         手机二级菜单
      ====================================================== */

      .hsdc-mobile-submenu {
        display: grid;

        grid-template-rows: 0fr;

        opacity: 0;

        transform: translateY(-5px);

        pointer-events: none;

        transition:
          grid-template-rows 0.34s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.22s ease,
          transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu {
        grid-template-rows: 1fr;

        opacity: 1;

        transform: translateY(0);

        pointer-events: auto;
      }

      .hsdc-mobile-group.is-closing
      .hsdc-mobile-submenu {
        grid-template-rows: 0fr;

        opacity: 0;

        transform: translateY(-5px);

        pointer-events: none;
      }

      .hsdc-mobile-submenu-inner {
        overflow: hidden;
        min-height: 0;
      }

      .hsdc-mobile-submenu ul {
        padding: 0 0 6px 14px;
      }

      .hsdc-mobile-submenu li {
        opacity: 0;
        transform: translateY(-5px);

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li {
        opacity: 1;
        transform: translateY(0);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(1) {
        transition-delay: 0.04s;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(2) {
        transition-delay: 0.08s;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(3) {
        transition-delay: 0.12s;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(4) {
        transition-delay: 0.16s;
      }

      .hsdc-mobile-submenu a {
        display: flex;
        align-items: center;

        width: 100%;
        box-sizing: border-box;

        padding: 10px 16px;

        font-size: 0.96rem;

        color: inherit;

        border-radius: 10px;

        transition:
          transform 180ms ease,
          opacity 180ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-submenu a:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-mobile-submenu .aw-link-active {
        font-weight: 600;
      }


      /* =====================================================
         手机主题
      ====================================================== */

      .menu-theme-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        padding: 0.75rem 1rem;
        margin-top: 0.5rem;

        border-top: 1px solid rgba(0, 0, 0, 0.06);

        color: #666;
      }

      .dark .menu-theme-item {
        border-top-color: rgba(255, 255, 255, 0.06);
        color: #aaa;
      }


      /* =====================================================
         手机滚动条
      ====================================================== */

      .hsdc-mobile-nav::-webkit-scrollbar {
        width: 4px;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-track {
        background: transparent !important;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-thumb {
        background: rgba(100, 116, 139, 0.25);
        border-radius: 999px;
      }
    }


    /* =========================================================
       电脑 / 平板
    ========================================================= */

    @media (min-width: 768px) {

      .hsdc-mobile-header {
        display: none !important;
      }

      .hsdc-desktop-header {
        display: flex;
      }


      /* =====================================================
         中间导航
      ====================================================== */

      .hsdc-desktop-nav {
        display: flex;
        align-items: center;
        justify-content: center;

        flex: 0 0 auto;

        margin: 0 1rem;
      }

      .hsdc-desktop-groups {
        display: flex;
        align-items: center;

        gap: 2px;
      }

      .hsdc-desktop-group {
        position: relative;
      }


      /* =====================================================
         一级菜单按钮
      ====================================================== */

      .hsdc-desktop-group-trigger {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 0.28rem;

        min-height: 42px;

        padding: 0.55rem 0.85rem;

        border: 0;
        border-radius: 10px;

        color: inherit;

        font-size: 0.9375rem;
        font-weight: 500;

        cursor: pointer;
        white-space: nowrap;

        transition:
          background-color 180ms ease,
          color 180ms ease,
          transform 180ms ease;
      }

      @media (hover: hover) and (pointer: fine) {

        .hsdc-desktop-group-trigger:hover {
          background: rgba(255, 255, 255, 0.1) !important;

          transform: translateY(-1px);
        }

        .dark .hsdc-desktop-group-trigger:hover {
          background: rgba(255, 255, 255, 0.06) !important;
        }
      }

      .hsdc-desktop-group-trigger:active {
        transform: scale(0.97);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-group-trigger {
        background: rgba(255, 255, 255, 0.1) !important;
      }

      .dark .hsdc-desktop-group.is-open
      .hsdc-desktop-group-trigger {
        background: rgba(255, 255, 255, 0.06) !important;
      }


      /* =====================================================
         V 箭头
      ====================================================== */

      .hsdc-desktop-chevron {
        width: 15px;
        height: 15px;

        transition:
          transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-chevron {
        transform: rotate(180deg);
      }


      /* =====================================================
         Windows 式二级菜单
      ====================================================== */

      .hsdc-desktop-dropdown {
        position: absolute;

        top: calc(100% + 7px);
        left: 50%;

        min-width: 178px;

        padding: 6px;

        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 12px;

        background: rgba(255, 255, 255, 0.94) !important;

        box-shadow:
          0 16px 40px rgba(15, 23, 42, 0.12),
          0 4px 12px rgba(15, 23, 42, 0.06);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        opacity: 0;

        visibility: hidden;
        pointer-events: none;

        transform:
          translate(-50%, -7px)
          scale(0.97);

        transform-origin: top center;

        will-change: opacity, transform;

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 220ms;
      }

      .dark .hsdc-desktop-dropdown {
        background: rgba(25, 25, 28, 0.94) !important;

        border-color: rgba(255, 255, 255, 0.1);

        box-shadow:
          0 18px 45px rgba(0, 0, 0, 0.35),
          0 4px 14px rgba(0, 0, 0, 0.2);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown {
        opacity: 1;

        visibility: visible;
        pointer-events: auto;

        transform:
          translate(-50%, 0)
          scale(1);

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
      }


      /* =====================================================
         二级菜单项目
      ====================================================== */

      .hsdc-desktop-dropdown a {
        display: flex;
        align-items: center;

        min-height: 38px;

        padding: 0.45rem 0.8rem;

        border-radius: 8px;

        font-size: 0.9rem;
        font-weight: 450;

        white-space: nowrap;

        opacity: 0;
        transform: translateY(-3px);

        transition:
          background-color 160ms ease,
          transform 160ms ease,
          opacity 180ms ease;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a {
        opacity: 1;
        transform: translateY(0);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(1) {
        transition-delay: 0.025s;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(2) {
        transition-delay: 0.05s;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(3) {
        transition-delay: 0.075s;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(4) {
        transition-delay: 0.1s;
      }

      @media (hover: hover) and (pointer: fine) {

        .hsdc-desktop-dropdown a:hover {
          background: rgba(100, 116, 139, 0.09) !important;

          transform: translateX(2px);
        }

        .dark .hsdc-desktop-dropdown a:hover {
          background: rgba(255, 255, 255, 0.08) !important;
        }
      }

      .hsdc-desktop-dropdown a:active {
        transform: scale(0.975);

        opacity: 0.72;
      }

      .hsdc-desktop-dropdown .aw-link-active {
        font-weight: 600;
      }


      /* =====================================================
         搜索预留区域
      ====================================================== */

      .hsdc-desktop-search-space {
        flex: 1 1 auto;

        min-width: 80px;
      }


      /* =====================================================
         右侧功能
      ====================================================== */

      .hsdc-desktop-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        flex: 0 0 auto;
      }


      /* =====================================================
         减少动态效果
      ====================================================== */

      @media (prefers-reduced-motion: reduce) {

        .hsdc-desktop-group-trigger,
        .hsdc-desktop-chevron,
        .hsdc-desktop-dropdown,
        .hsdc-desktop-dropdown a,
        .hsdc-mobile-nav,
        .hsdc-mobile-group-item,
        .hsdc-mobile-group-trigger,
        .hsdc-mobile-group-chevron,
        .hsdc-mobile-submenu,
        .hsdc-mobile-submenu a,
        .hsdc-mobile-submenu li {
          transition: none !important;
        }
      }
    }


    /* =========================================================
       768px 以下隐藏桌面菜单
    ========================================================= */

    @media (max-width: 767px) {

      .hsdc-desktop-header {
        display: none !important;
      }
    }
  </style>


  <!-- =======================================================
       Header 背景
  ======================================================== -->

  <div
    class="absolute inset-0"
    style="background: transparent !important;"
  ></div>


  <!-- =======================================================
       手机端
  ======================================================== -->

  <div class="hsdc-mobile-header relative text-default py-1.5 px-3 w-full">

    <div class="flex items-center justify-between w-full">

      <a
        class="hsdc-brand"
        href={getHomePermalink()}
        aria-label="返回首页"
      >
        <Logo />
      </a>

      <div class="flex items-center translate-x-1">
        <ToggleMenu />
      </div>

    </div>


    <!-- =====================================================
         手机展开菜单
    ====================================================== -->

    <nav
      class="hsdc-mobile-nav"
      aria-label="移动端主导航"
    >
      <ul class="hsdc-mobile-groups">

        {
          groups.map((group) => (
            <li class="hsdc-mobile-group-item">

              <details class="hsdc-mobile-group">

                <summary class="hsdc-mobile-group-trigger">
                  <span>{group.text}</span>

                  <Icon
                    name="tabler:chevron-down"
                    class="hsdc-mobile-group-chevron"
                  />
                </summary>

                <div class="hsdc-mobile-submenu">
                  <div class="hsdc-mobile-submenu-inner">

                    <ul>
                      {
                        group.links.map((link) => (
                          <li>
                            <a
                              class:list={[
                                {
                                  'aw-link-active':
                                    link.href === currentPath,
                                },
                              ]}
                              href={link.href}
                            >
                              {link.text}
                            </a>
                          </li>
                        ))
                      }
                    </ul>

                  </div>
                </div>

              </details>

            </li>
          ))
        }


        <!-- 手机主题 -->

        <li class="menu-theme-item">

          <ToggleTheme iconClass="w-5 h-5" />

          <span class="text-sm">
            切换主题
          </span>

        </li>

      </ul>
    </nav>

  </div>


  <!-- =======================================================
       电脑 / 平板端
  ======================================================== -->

  <div
    class:list={[
      'hsdc-desktop-header relative text-default py-1.5 px-6 mx-auto w-full items-center',
      {
        'max-w-7xl': !isFullWidth,
      },
    ]}
  >

    <!-- Logo -->

    <a
      class="hsdc-brand"
      href={getHomePermalink()}
      aria-label="返回首页"
    >
      <Logo />
    </a>


    <!-- 搜索区域预留 -->

    <div class="hsdc-desktop-search-space"></div>


    <!-- =====================================================
         电脑 / 平板一级菜单
    ====================================================== -->

    <nav
      class="hsdc-desktop-nav"
      aria-label="主导航"
    >

      <ul class="hsdc-desktop-groups">

        {
          groups.map((group, index) => (
            <li
              class="hsdc-desktop-group"
              data-group-index={index}
            >

              <button
                type="button"
                class="hsdc-desktop-group-trigger"
                aria-expanded="false"
              >
                <span>{group.text}</span>

                <Icon
                  name="tabler:chevron-down"
                  class="hsdc-desktop-chevron"
                />
              </button>


              <!-- Windows 式二级菜单 -->

              <div
                class="hsdc-desktop-dropdown"
                role="menu"
              >
                {
                  group.links.map((link) => (
                    <a
                      href={link.href}
                      role="menuitem"
                      class:list={[
                        {
                          'aw-link-active':
                            link.href === currentPath,
                        },
                      ]}
                    >
                      {link.text}
                    </a>
                  ))
                }
              </div>

            </li>
          ))
        }

      </ul>

    </nav>


    <!-- =====================================================
         右侧功能
    ====================================================== -->

    <div class="hsdc-desktop-actions">

      <div class="flex items-center">

        {
          showToggleTheme && (
            <ToggleTheme
              iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block"
            />
          )
        }

        {
          showRssFeed && (
            <a
              class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
              aria-label="RSS Feed"
              href={getAsset('/rss.xml')}
            >
              <Icon
                name="tabler:rss"
                class="w-5 h-5"
              />
            </a>
          )
        }

        {
          actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {
                actions.map((btnProps) => (
                  <Button
                    {...btnProps}
                    class="ml-2 py-2.5 px-5.5 md:px-6 font-semibold shadow-none text-sm w-auto"
                  />
                ))
              }
            </span>
          ) : (
            ''
          )
        }

      </div>

    </div>

  </div>


  <!-- =======================================================
       菜单控制
  ======================================================== -->

  <script>
    /**
     * Header 导航控制
     *
     * 重点：
     *
     * 1. 不再使用 data-hsdcNavigationInitialized。
     *    Astro Client Router 页面切换后，旧 Header 的 DOM
     *    会被替换，新 Header 必须重新绑定事件。
     *
     * 2. 使用 AbortController。
     *    每次重新初始化之前，先取消上一轮 listener，
     *    避免出现一次点击触发多个 listener。
     *
     * 3. 手机 details 不使用浏览器默认 toggle。
     *    手动控制 open 状态，让关闭动画完成之后
     *    再真正移除 open，避免二级菜单突然跳出来。
     */

    const hsdcWindow = /** @type {Window & {
      __hsdcHeaderController?: AbortController;
      __hsdcHeaderLifecycleBound?: boolean;
    }} */ (window);


    const initHeaderNavigation = () => {

      const header = document.querySelector('#header');

      if (!header) return;


      /* =====================================================
         清理上一轮事件
      ====================================================== */

      hsdcWindow.__hsdcHeaderController?.abort();

      const controller = new AbortController();

      hsdcWindow.__hsdcHeaderController = controller;

      const { signal } = controller;


      /* =====================================================
         桌面菜单
      ====================================================== */

      const desktopGroups = Array.from(
        header.querySelectorAll('.hsdc-desktop-group')
      );


      const closeAllDesktopGroups = () => {

        desktopGroups.forEach((group) => {

          group.classList.remove('is-open');

          const button =
            group.querySelector(
              '.hsdc-desktop-group-trigger'
            );

          button?.setAttribute(
            'aria-expanded',
            'false'
          );
        });
      };


      desktopGroups.forEach((group) => {

        const button =
          group.querySelector(
            '.hsdc-desktop-group-trigger'
          );

        if (!button) return;


        button.addEventListener(
          'click',
          (event) => {

            event.preventDefault();
            event.stopPropagation();


            const wasOpen =
              group.classList.contains('is-open');


            if (wasOpen) {

              closeAllDesktopGroups();

              return;
            }


            closeAllDesktopGroups();


            group.classList.add('is-open');

            button.setAttribute(
              'aria-expanded',
              'true'
            );
          },
          {
            signal,
          }
        );
      });


      /* =====================================================
         点击桌面菜单以外区域
      ====================================================== */

      document.addEventListener(
        'click',
        (event) => {

          const target = event.target;

          if (
            target instanceof Node &&
            header.contains(target)
          ) {
            return;
          }

          closeAllDesktopGroups();
        },
        {
          signal,
        }
      );


      /* =====================================================
         ESC
      ====================================================== */

      document.addEventListener(
        'keydown',
        (event) => {

          if (event.key === 'Escape') {

            closeAllDesktopGroups();
          }
        },
        {
          signal,
        }
      );


      /* =====================================================
         手机菜单
      ====================================================== */

      const mobileGroups = Array.from(
        header.querySelectorAll('.hsdc-mobile-group')
      ).filter(
        (element) =>
          element instanceof HTMLDetailsElement
      );


      const mobileCloseTimers =
        new WeakMap();


      const clearMobileCloseTimer = (group) => {

        const timer =
          mobileCloseTimers.get(group);

        if (timer) {

          window.clearTimeout(timer);

          mobileCloseTimers.delete(group);
        }
      };


      const resetMobileGroup = (group) => {

        clearMobileCloseTimer(group);

        group.classList.remove(
          'is-open',
          'is-closing'
        );

        group.open = false;
      };


      const closeMobileGroup = (
        group,
        immediate = false
      ) => {

        clearMobileCloseTimer(group);


        if (!group.open) {

          group.classList.remove(
            'is-open',
            'is-closing'
          );

          return;
        }


        /* =================================================
           汉堡菜单整体关闭时：
           立即关闭 details，绝不让二级菜单
           在主菜单收起过程中重新占位。
        ================================================== */

        if (immediate) {

          resetMobileGroup(group);

          return;
        }


        group.classList.remove('is-open');

        group.classList.add('is-closing');


        const timer =
          window.setTimeout(
            () => {

              group.open = false;

              group.classList.remove(
                'is-closing'
              );

              mobileCloseTimers.delete(
                group
              );

            },
            340
          );


        mobileCloseTimers.set(
          group,
          timer
        );
      };


      const closeAllMobileGroups = (
        immediate = false
      ) => {

        mobileGroups.forEach(
          (group) => {

            closeMobileGroup(
              group,
              immediate
            );
          }
        );
      };


      const openMobileGroup = (group) => {

        /* 关闭其他二级菜单 */

        mobileGroups.forEach(
          (otherGroup) => {

            if (otherGroup !== group) {

              closeMobileGroup(
                otherGroup,
                true
              );
            }
          }
        );


        clearMobileCloseTimer(group);


        group.open = true;

        group.classList.remove(
          'is-closing'
        );


        /*
         * 下一帧再加入 is-open。
         *
         * 这样浏览器能明确识别：
         *
         * 0 → 1fr
         *
         * 从而触发展开动画，而不是直接出现。
         */

        requestAnimationFrame(() => {

          if (!group.open) return;

          group.classList.add(
            'is-open'
          );
        });
      };


      mobileGroups.forEach(
        (group) => {

          const summary =
            group.querySelector('summary');

          if (!summary) return;


          /*
           * 阻止 details 原生瞬间打开/关闭。
           */

          summary.addEventListener(
            'click',(event) => {

              event.preventDefault();
              event.stopPropagation();


              if (
                group.open &&
                !group.classList.contains(
                  'is-closing'
                )
              ) {

                closeMobileGroup(
                  group,
                  false
                );

                return;
              }


              openMobileGroup(group);
            },
            {
              signal,
            }
          );
        }
      );


      /* =====================================================
         汉堡按钮
      ====================================================== */

      const toggleMenu =
        header.querySelector(
          '[data-aw-toggle-menu]'
        );

      if (toggleMenu) {

        /*
         * capture=true
         *
         * 必须在 BasicScripts 的 toggle handler
         * 之前执行。
         *
         * 这样关闭主菜单时，二级菜单先被清掉，
         * 不会出现：
         *
         * 二级菜单跳出来
         * ↓
         * 主菜单才收回
         */

        toggleMenu.addEventListener(
          'click',
          () => {

            const isCurrentlyOpen =
              toggleMenu.classList.contains(
                'expanded'
              ) ||
              header.classList.contains(
                'expanded'
              ) ||
              header.querySelector(
                '.hsdc-mobile-nav.expanded'
              );


            if (isCurrentlyOpen) {

              closeAllMobileGroups(
                true
              );
            }
          },
          {
            signal,
            capture: true,
          }
        );
      }


      /* =====================================================
         点击手机二级菜单链接
      ====================================================== */

      header
        .querySelectorAll(
          '.hsdc-mobile-submenu a'
        )
        .forEach((link) => {

          link.addEventListener(
            'click',
            () => {

              /*
               * 页面即将进行 Astro Client Router
               * 切换，不需要在这里强制关闭动画。
               *
               * 新页面初始化时会自动 reset。
               */
            },
            {
              signal,
            }
          );
        });


      /* =====================================================
         页面切换 / 初始化
      ====================================================== */

      closeAllDesktopGroups();

      closeAllMobileGroups(true);


      /* =====================================================
         屏幕尺寸变化
      ====================================================== */

      const mediaQuery =
        window.matchMedia(
          '(min-width: 768px)'
        );


      mediaQuery.addEventListener(
        'change',
        () => {

          if (mediaQuery.matches) {

            closeAllMobileGroups(true);

          } else {

            closeAllDesktopGroups();
          }
        },
        {
          signal,
        }
      );
    };


    /* =======================================================
       初次加载
    ======================================================== */

    if (
      document.readyState ===
      'loading'
    ) {

      document.addEventListener(
        'DOMContentLoaded',
        initHeaderNavigation,
        {
          once: true,
        }
      );

    } else {

      initHeaderNavigation();
    }


    /* =======================================================
       Astro Client Router
    ======================================================== */

    if (
      !hsdcWindow.__hsdcHeaderLifecycleBound
    ) {

      hsdcWindow.__hsdcHeaderLifecycleBound =
        true;


      document.addEventListener(
        'astro:after-swap',
        () => {

          /*
           * 等新 Header DOM 完成替换后
           * 再重新绑定。
           */

          requestAnimationFrame(() => {

            initHeaderNavigation();

          });
        }
      );
    }
  </script>
</header>