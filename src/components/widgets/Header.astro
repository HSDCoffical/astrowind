---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<!-- ===== 状态栏改为 relative，跟随页面滚动 ===== -->
<header
  id={id}
  class="relative z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    header#header * {
      background: transparent !important;
    }
    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }
    header#header button:hover,
    header#header a:hover {
      background: rgba(255,255,255,0.1) !important;
    }
    .dark header#header button:hover,
    .dark header#header a:hover {
      background: rgba(255,255,255,0.05) !important;
    }
    .menu-theme-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      margin-top: 0.5rem;
      border-top: 1px solid rgba(0,0,0,0.06);
      color: #666;
    }
    .dark .menu-theme-item {
      border-top-color: rgba(255,255,255,0.06);
      color: #aaa;
    }
    @media (min-width: 768px) {
      .menu-theme-item {
        display: none !important;
      }
    }

    /* 手机版禁用毛玻璃 */
    @media (max-width: 768px) {
      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }
    }
  </style>

  <!-- ===== 简化导航结构（与原版功能一致） ===== -->
  <div class="relative text-default py-1.5 px-3 md:px-6 mx-auto w-full max-w-7xl">
    <div class="flex justify-between items-center w-full">
      <a class="flex items-center" href={getHomePermalink()}>
        <Logo />
      </a>
      <div class="flex items-center gap-2">
        {showToggleTheme && <ToggleTheme iconClass="w-5 h-5" />}
        <div class="md:hidden">
          <ToggleMenu />
        </div>
      </div>
    </div>

    <!-- 桌面端导航 -->
    <nav class="items-center w-full hidden md:flex text-sm font-medium justify-center gap-6">
      {
        links.map(({ text, href }) => (
          <a
            key={href}
            href={href}
            class={currentPath === href ? 'text-link' : 'hover:text-link'}
          >
            {text}
          </a>
        ))
      }
    </nav>
  </div>
</header>