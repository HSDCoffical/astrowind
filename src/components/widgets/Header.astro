---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';

import { getHomePermalink } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
  target?: string;
}

interface MenuGroup {
  text: string;
  links: Array<Link>;
}

export interface Props {
  id?: string;
  groups?: Array<MenuGroup>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  groups = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30 hsdc-header"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    /* =========================================================
       基础
    ========================================================= */

    header#header {
      transition:
        background-color 280ms ease,
        border-color 280ms ease,
        box-shadow 280ms ease;
    }

    header#header * {
      background: transparent !important;
    }

    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }


    /* =========================================================
       Logo
    ========================================================= */

    .hsdc-brand {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      text-decoration: none;

      transition:
        transform 220ms ease,
        opacity 220ms ease;
    }

    .hsdc-brand:hover {
      transform: translateY(-1px);
      opacity: 0.94;
    }


    /* =========================================================
       手机 / 桌面
    ========================================================= */

    .hsdc-mobile-header {
      display: flex;
    }

    .hsdc-desktop-header {
      display: none;
    }


    /* =========================================================
       手机端
    ========================================================= */

    @media (max-width: 767px) {

      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }

      .hsdc-mobile-header {
        display: flex;
      }

      .hsdc-desktop-header {
        display: none !important;
      }


      /* 手机主菜单 */

      .hsdc-mobile-nav {
        display: block !important;
        width: 100%;
        max-height: 0;

        opacity: 0;
        overflow: hidden;

        transform: translateY(-8px);

        visibility: hidden;
        pointer-events: none;

        transition:
          max-height 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.22s ease,
          transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0.38s;
      }

      /*
       * 唯一根据移动导航自身状态决定展开。
       * 不再使用 :has(.expanded)。
       */
      header#header .hsdc-mobile-nav.expanded,
      header#header .hsdc-mobile-nav[data-expanded="true"] {
        max-height: calc(100vh - 72px);

        opacity: 1;

        transform: translateY(0);

        visibility: visible;
        pointer-events: auto;

        overflow-y: auto;

        transition:
          max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.25s ease,
          transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
      }


      /* =====================================================
         汉堡“三”定位
         ===================================================== */

      /*
       * X 的位置保持原样。
       * 只有未展开状态的“三”向下 2px。
       *
       * transform 不影响按钮本身占位，
       * 因此不会导致 Header 高度变化。
       */

      header#header [data-aw-toggle-menu]:not(.expanded) {
        transform: translateY(2px);
      }

      header#header [data-aw-toggle-menu].expanded {
        transform: none;
      }


      /* 手机首页 */

      .hsdc-mobile-home {
        display: flex;
        align-items: center;

        width: 100%;
        box-sizing: border-box;

        padding: 13px 16px;

        font-size: 1.05rem;
        font-weight: 500;

        border-radius: 10px;

        transition:
          transform 160ms ease,
          opacity 160ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-home:active {
        transform: scale(0.975);
        opacity: 0.72;
      }


      /* 一级菜单 */

      .hsdc-mobile-group {
        width: 100%;
      }

      .hsdc-mobile-group-button {
        display: flex;
        align-items: center;
        justify-content: space-between;

        width: 100%;
        box-sizing: border-box;

        padding: 13px 16px;

        border: 0;
        outline: none;

        font-size: 1.05rem;
        font-weight: 500;

        color: inherit;

        cursor: pointer;

        transition:
          transform 160ms ease,
          opacity 160ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-group-button:active {
        transform: scale(0.975);
        opacity: 0.72;
      }


      /* 一级菜单箭头 */

      .hsdc-mobile-group-chevron {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        width: 20px;
        height: 20px;

        font-size: 25px;
        line-height: 1;

        transform: rotate(0deg);

        transition:
          transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-group-chevron {
        transform: rotate(90deg);
      }


      /* =====================================================
         二级菜单
         ===================================================== */

      .hsdc-mobile-submenu {
        display: flex;
        flex-direction: column;

        max-height: 0;

        padding-left: 12px;
        padding-right: 12px;

        opacity: 0;

        overflow: hidden;
        pointer-events: none;

        transform: translateY(-5px);

        transition:
          max-height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.22s ease,
          transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu {
        opacity: 1;

        pointer-events: auto;

        transform: translateY(0);
      }

      .hsdc-mobile-submenu a {
        display: flex;
        align-items: center;

        width: 100%;
        box-sizing: border-box;

        min-height: 42px;

        padding: 9px 16px;

        font-size: 0.96rem;

        color: inherit;

        border-radius: 10px;

        transition:
          transform 180ms ease,
          opacity 180ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-submenu a:active {
        transform: scale(0.975);
        opacity: 0.72;
      }


      /* =====================================================
         滚动条
         ===================================================== */

      .hsdc-mobile-nav::-webkit-scrollbar {
        width: 4px;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-track {
        background: transparent !important;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-thumb {
        background: rgba(100, 116, 139, 0.25);
        border-radius: 999px;
      }
    }


    /* =========================================================
       桌面 / 平板
    ========================================================= */

    @media (min-width: 768px) {

      .hsdc-mobile-header {
        display: none !important;
      }

      .hsdc-desktop-header {
        display: flex;
      }

      .hsdc-desktop-nav {
        display: flex;
        align-items: center;
        justify-content: center;

        flex: 0 0 auto;

        margin: 0 1rem;
      }

      .hsdc-home-link,
      .hsdc-desktop-group-button {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 0.28rem;

        min-height: 42px;

        padding: 0.55rem 0.85rem;

        border: 0;
        border-radius: 10px;

        color: inherit;

        font-size: 0.9375rem;
        font-weight: 500;

        cursor: pointer;
        white-space: nowrap;

        transition:
          background-color 180ms ease,
          color 180ms ease,
          transform 180ms ease;
      }

      @media (hover: hover) and (pointer: fine) {

        .hsdc-home-link:hover,
        .hsdc-desktop-group-button:hover {
          background: rgba(255, 255, 255, 0.1) !important;
          transform: translateY(-1px);
        }

        .dark .hsdc-home-link:hover,
        .dark .hsdc-desktop-group-button:hover {
          background: rgba(255, 255, 255, 0.06) !important;
        }
      }

      .hsdc-home-link:active,
      .hsdc-desktop-group-button:active {
        transform: scale(0.97);
      }

      .hsdc-desktop-group {
        position: relative;
      }

      .hsdc-chevron {
        transition:
          transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease;
      }

      .hsdc-desktop-group.is-open
      .hsdc-chevron {
        transform: rotate(180deg);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-group-button {
        background: rgba(255, 255, 255, 0.1) !important;
      }

      .dark .hsdc-desktop-group.is-open
      .hsdc-desktop-group-button {
        background: rgba(255, 255, 255, 0.06) !important;
      }

      .hsdc-desktop-dropdown {
        position: absolute;

        top: calc(100% + 7px);
        left: 50%;

        min-width: 178px;

        padding: 6px;

        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 12px;

        background: rgba(255, 255, 255, 0.94) !important;

        box-shadow:
          0 16px 40px rgba(15, 23, 42, 0.12),
          0 4px 12px rgba(15, 23, 42, 0.06);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transform:
          translate(-50%, -7px)
          scale(0.97);

        transform-origin: top center;

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 220ms;
      }

      .dark .hsdc-desktop-dropdown {
        background: rgba(25, 25, 28, 0.94) !important;
        border-color: rgba(255, 255, 255, 0.1);

        box-shadow:
          0 18px 45px rgba(0, 0, 0, 0.35),
          0 4px 14px rgba(0, 0, 0, 0.2);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;

        transform:
          translate(-50%, 0)
          scale(1);

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
      }

      .hsdc-desktop-dropdown a {
        display: flex;
        align-items: center;

        min-height: 38px;

        padding: 0.45rem 0.8rem;

        border-radius: 8px;

        font-size: 0.9rem;
        font-weight: 450;

        white-space: nowrap;

        transition:
          background-color 160ms ease,
          transform 160ms ease;
      }

      @media (hover: hover) and (pointer: fine) {

        .hsdc-desktop-dropdown a:hover {
          background: rgba(100, 116, 139, 0.09) !important;
          transform: translateX(2px);
        }

        .dark .hsdc-desktop-dropdown a:hover {
          background: rgba(255, 255, 255, 0.08) !important;
        }
      }

      .hsdc-desktop-dropdown a:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        flex: 0 0 auto;
      }
    }


    /* =========================================================
       减少动态效果
    ========================================================= */

    @media (prefers-reduced-motion: reduce) {

      .hsdc-brand,
      .hsdc-mobile-nav,
      .hsdc-mobile-group-button,
      .hsdc-mobile-group-chevron,
      .hsdc-mobile-submenu,
      .hsdc-mobile-submenu a,
      .hsdc-desktop-group-button,
      .hsdc-chevron,
      .hsdc-desktop-dropdown,
      .hsdc-desktop-dropdown a {
        transition: none !important;
      }
    }
  </style>
<div class="absolute inset-0" style="background: transparent !important;"></div>

  <!-- =========================
       移动端 Header
  ========================== -->
  <div class="hsdc-mobile-header relative text-default py-1.5 px-3 w-full">
    <div class="flex items-center justify-between w-full">
      <a
        class="hsdc-brand"
        href={getHomePermalink()}
        aria-label="返回首页"
      >
        <Logo />
      </a>

      <div class="flex items-center translate-x-1">
        <ToggleMenu />
      </div>
    </div>

    <nav
      class="hsdc-mobile-nav"
      aria-label="移动端主导航"
    >
      <a
        class="hsdc-mobile-home"
        href={getHomePermalink()}
      >
        首页
      </a>

      {
        groups?.map((group) => (
          <div class="hsdc-mobile-group">
            <button
              type="button"
              class="hsdc-mobile-group-button"
              aria-expanded="false"
            >
              <span>{group.text}</span>

              <span
                class="hsdc-mobile-group-chevron"
                aria-hidden="true"
              >
                ›
              </span>
            </button>

            <div class="hsdc-mobile-submenu">
              {
                group.links?.map((item) => (
                  <a
                    href={item.href}
                    target={item.target}
                    rel={
                      item.target === '_blank'
                        ? 'noopener noreferrer'
                        : undefined
                    }
                  >
                    {item.text}
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }
    </nav>
  </div>


  <!-- =========================
       桌面端 / 平板端 Header
  ========================== -->
  <div
    class:list={[
      'hsdc-desktop-header',
      'relative',
      'mx-auto',
      'w-full',
      'px-4',
      'sm:px-6',
      'lg:px-8',
      'py-3',
    ]}
  >
    <div class="flex items-center w-full min-h-[64px]">

      <!-- Logo -->
      <a
        class="hsdc-brand flex items-center shrink-0"
        href={getHomePermalink()}
        aria-label="返回首页"
      >
        <Logo />
      </a>


      <!-- 桌面导航 -->
      <nav
        class="hsdc-desktop-nav"
        aria-label="主导航"
      >
        <a
          class="hsdc-home-link"
          href={getHomePermalink()}
        >
          首页
        </a>

        {
          groups?.map((group, index) => (
            <div
              class="hsdc-desktop-group"
              data-group-index={index}
            >
              <button
                type="button"
                class="hsdc-desktop-group-button"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{group.text}</span>

                <svg
                  class="hsdc-chevron"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>

              <div
                class="hsdc-desktop-dropdown"
                role="menu"
              >
                {
                  group.links?.map((item) => (
                    <a
                      href={item.href}
                      target={item.target}
                      rel={
                        item.target === '_blank'
                          ? 'noopener noreferrer'
                          : undefined
                      }
                      role="menuitem"
                    >
                      {item.text}
                    </a>
                  ))
                }
              </div>
            </div>
          ))
        }
      </nav>


      <!-- 右侧 -->
      <div class="hsdc-header-right flex items-center ml-4 shrink-0">
        {
          showToggleTheme && (
            <ToggleTheme />
          )
        }

        {
          actions?.map((action) => (
            <a
              href={action.href}
              target={action.target}
              rel={
                action.target === '_blank'
                  ? 'noopener noreferrer'
                  : undefined
              }
              class="hsdc-action"
            >
              {action.text}
            </a>
          ))
        }
      </div>

    </div>
  </div>


  <script>
    (() => {
      let controller: AbortController | null = null;

      const initHeader = () => {
        controller?.abort();

        controller = new AbortController();

        const { signal } = controller;

        const header =
          document.querySelector<HTMLElement>('#header');

        if (!header) return;


        /* =====================================================
           桌面菜单
        ===================================================== */

        const desktopGroups =
          Array.from(
            header.querySelectorAll<HTMLElement>(
              '.hsdc-desktop-group'
            )
          );


        const closeDesktopGroups = () => {
          desktopGroups.forEach((group) => {
            group.classList.remove('is-open');

            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-desktop-group-button'
              );

            button?.setAttribute(
              'aria-expanded',
              'false'
            );
          });
        };


        const toggleDesktopGroup = (
          currentGroup: HTMLElement
        ) => {
          const wasOpen =
            currentGroup.classList.contains('is-open');

          desktopGroups.forEach((group) => {
            group.classList.remove('is-open');

            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-desktop-group-button'
              );

            button?.setAttribute(
              'aria-expanded',
              'false'
            );
          });

          if (!wasOpen) {
            currentGroup.classList.add('is-open');

            const button =
              currentGroup.querySelector<HTMLButtonElement>(
                '.hsdc-desktop-group-button'
              );

            button?.setAttribute(
              'aria-expanded',
              'true'
            );
          }
        };


        desktopGroups.forEach((group) => {
          const button =
            group.querySelector<HTMLButtonElement>(
              '.hsdc-desktop-group-button'
            );

          if (!button) return;

          button.addEventListener(
            'click',
            (event) => {
              event.preventDefault();
              event.stopPropagation();

              toggleDesktopGroup(group);
            },
            { signal }
          );
        });


        document.addEventListener(
          'click',
          (event) => {
            const target =
              event.target as Node | null;

            if (!target) return;

            if (!header.contains(target)) {
              closeDesktopGroups();
              return;
            }

            if (
              target instanceof Element &&
              !target.closest('.hsdc-desktop-group')
            ) {
              closeDesktopGroups();
            }
          },
          { signal }
        );


        document.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'Escape') {
              closeDesktopGroups();
            }
          },
          { signal }
        );


        /* =====================================================
           移动端二级菜单
        ===================================================== */

        const mobileGroups =
          Array.from(
            header.querySelectorAll<HTMLElement>(
              '.hsdc-mobile-group'
            )
          );


        const closeMobileGroups = (
          immediate = false
        ) => {
          mobileGroups.forEach((group) => {
            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-mobile-group-button'
              );

            const submenu =
              group.querySelector<HTMLElement>(
                '.hsdc-mobile-submenu'
              );

            group.classList.remove('is-open');

            button?.setAttribute(
              'aria-expanded',
              'false'
            );

            if (!submenu) return;

            if (immediate) {
              submenu.style.transition = 'none';
            } else {
              submenu.style.transition = '';
            }

            submenu.style.maxHeight = '0px';
            submenu.style.opacity = '0';
            submenu.style.transform =
              'translateY(-5px)';

            if (immediate) {
              /*
               * 强制浏览器完成一次布局，
               * 然后恢复 transition。
               *
               * 这样不会把下一次展开动画一起吃掉。
               */
              void submenu.offsetHeight;

              submenu.style.transition = '';
            }
          });
        };


        const openMobileGroup = (
          currentGroup: HTMLElement
        ) => {
          const button =
            currentGroup.querySelector<HTMLButtonElement>(
              '.hsdc-mobile-group-button'
            );

          const submenu =
            currentGroup.querySelector<HTMLElement>(
              '.hsdc-mobile-submenu'
            );

          if (!button || !submenu) return;

          const isOpen =
            currentGroup.classList.contains('is-open');


          /*
           * 先关闭其它二级菜单。
           */
          mobileGroups.forEach((group) => {
            if (group === currentGroup) return;

            const otherButton =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-mobile-group-button'
              );

            const otherSubmenu =
              group.querySelector<HTMLElement>(
                '.hsdc-mobile-submenu'
              );

            group.classList.remove('is-open');

            otherButton?.setAttribute(
              'aria-expanded',
              'false'
            );

            if (otherSubmenu) {
              otherSubmenu.style.maxHeight =
                '0px';

              otherSubmenu.style.opacity =
                '0';

              otherSubmenu.style.transform =
                'translateY(-5px)';
            }
          });


          /*
           * 当前菜单原本打开 → 收回。
           */
          if (isOpen) {
            currentGroup.classList.remove(
              'is-open'
            );

            button.setAttribute(
              'aria-expanded',
              'false'
            );

            submenu.style.maxHeight =
              '0px';

            submenu.style.opacity =
              '0';

            submenu.style.transform =
              'translateY(-5px)';

            return;
          }


          /*
           * 当前菜单展开。
           */
          currentGroup.classList.add(
            'is-open'
          );

          button.setAttribute(
            'aria-expanded',
            'true'
          );

          submenu.style.maxHeight =
            `${submenu.scrollHeight}px`;

          submenu.style.opacity =
            '1';

          submenu.style.transform =
            'translateY(0)';
        };


        mobileGroups.forEach((group) => {
          const button =
            group.querySelector<HTMLButtonElement>(
              '.hsdc-mobile-group-button'
            );

          if (!button) return;

          button.addEventListener(
            'click',
            (event) => {
              event.preventDefault();
              event.stopPropagation();

              openMobileGroup(group);
            },
            { signal }
          );
        });


        /* =====================================================
           关键修复
           
           Header 不再接管 ToggleMenu 的 expanded 状态。
           BasicScripts.astro 是唯一负责：
             三 ↔ X
             主菜单展开 ↔ 收回
           
           Header 这里只负责清理二级菜单。
        ===================================================== */

        const toggleMenu =
          header.querySelector<HTMLElement>(
            '[data-aw-toggle-menu]'
          );

        if (toggleMenu) {
          toggleMenu.addEventListener(
            'click',
            () => {
              /*
               * 不修改 expanded。
               *
               * 这里只在菜单正在收回时清掉二级菜单，
               * 防止 X → 收回过程中二级菜单重新参与布局。
               */
              if (
                toggleMenu.classList.contains(
                  'expanded'
                )
              ) {
                closeMobileGroups(true);
              }
            },
            {
              signal,
              capture: true,
            }
          );
        }


        /* =====================================================
           二级菜单链接
        ===================================================== */

        header
          .querySelectorAll<HTMLAnchorElement>(
            '.hsdc-mobile-submenu a'
          )
          .forEach((link) => {
            link.addEventListener(
              'click',
              () => {
                closeMobileGroups(true);
              },
              { signal }
            );
          });


        /* =====================================================
           初始化
        ===================================================== */

        closeDesktopGroups();
        closeMobileGroups(true);


        /* =====================================================
           横竖屏 / 尺寸切换
        ===================================================== */

        const mediaQuery =
          window.matchMedia(
            '(min-width: 768px)'
          );

        const handleMediaChange = () => {
          if (mediaQuery.matches) {
            closeMobileGroups(true);
            closeDesktopGroups();
          } else {
            closeDesktopGroups();
          }
        };

        mediaQuery.addEventListener(
          'change',
          handleMediaChange,
          { signal }
        );
      };


      initHeader();


      /* =======================================================
         Astro 页面切换后重新绑定
      ======================================================= */

      document.addEventListener(
        'astro:after-swap',
        () => {
          initHeader();
        }
      );
    })();
  </script>
</header>