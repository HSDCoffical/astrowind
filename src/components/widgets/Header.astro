---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuGroup {
  text: string;
  links: Array<Link>;
}

export interface Props {
  id?: string;
  groups?: Array<MenuGroup>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  groups = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  id={id}
  data-aw-sticky-header={isSticky ? true : undefined}
  class="fixed top-0 left-0 right-0 z-40 w-full border-b border-gray-200/30 dark:border-gray-700/30 hsdc-header"
  style="background: transparent !important; backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important;"
>
  <style>
    /* =========================================================
       基础
    ========================================================= */

    header#header {
      transition:
        background-color 280ms ease,
        border-color 280ms ease,
        box-shadow 280ms ease;
    }

    header#header * {
      background: transparent !important;
    }

    header#header .bg-white,
    header#header .dark\:bg-gray-900,
    header#header .bg-gray-100,
    header#header .bg-gray-50,
    header#header [class*="bg-"] {
      background: transparent !important;
    }


    /* =========================================================
       Logo / 品牌
    ========================================================= */

    .hsdc-brand {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      text-decoration: none;

      transition:
        transform 220ms ease,
        opacity 220ms ease;
    }

    .hsdc-brand:hover {
      transform: translateY(-1px);
      opacity: 0.94;
    }


    /* =========================================================
       手机 / 桌面端基础显示
    ========================================================= */

    .hsdc-mobile-header {
      display: flex;
    }

    .hsdc-desktop-header {
      display: none;
    }


    /* =========================================================
       手机端
    ========================================================= */

    @media (max-width: 767px) {

      header#header {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }

      .hsdc-mobile-header {
        display: flex;
      }

      .hsdc-desktop-header {
        display: none !important;
      }


      /* =====================================================
         手机主菜单
      ====================================================== */

      .hsdc-mobile-nav {
        display: block !important;

        width: 100%;
        max-height: 0;

        opacity: 0;
        overflow: hidden;

        transform: translateY(-8px);

        visibility: hidden;
        pointer-events: none;

        transition:
          max-height 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.22s ease,
          transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0.38s;
      }

      /*
       * 手机主菜单唯一状态源：
       *
       * 只根据 mobile-nav 自身的 expanded 状态控制。
       *
       * 不再使用：
       * header#header:has(.expanded)
       *
       * 避免关闭 X 时 Header / ToggleMenu / Nav
       * 三套状态同时变化造成闪动。
       */

      header#header .hsdc-mobile-nav.expanded,
      header#header .hsdc-mobile-nav[data-expanded="true"] {
        max-height: calc(100vh - 72px);

        opacity: 1;

        transform: translateY(0);

        visibility: visible;
        pointer-events: auto;

        overflow-y: auto;

        transition:
          max-height 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.25s ease,
          transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
      }


      /* =====================================================
         汉堡按钮“三”定位
      ====================================================== */

      /*
       * 以展开后的 X 为定位基准。
       *
       * X 保持原位置；
       * 未展开时的“三”仅做非常轻微的视觉下移。
       *
       * 不改变按钮占位高度。
       */

      header#header [data-aw-toggle-menu]:not(.expanded) {
        transform: translateY(2px);
      }

      header#header [data-aw-toggle-menu].expanded {
        transform: none;
      }


      /* =====================================================
         一级板块
      ====================================================== */

      .hsdc-mobile-groups {
        padding-top: 8px;
        padding-bottom: 12px;
      }

      .hsdc-mobile-group-item {
        opacity: 0;

        transform: translateY(-8px);

        transition:
          opacity 0.24s ease,
          transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /*
       * 一级菜单项目只跟随手机主导航状态。
       *
       * 不再使用 header:has(.expanded)。
       */

      header#header .hsdc-mobile-nav.expanded
      .hsdc-mobile-group-item,
      header#header .hsdc-mobile-nav[data-expanded="true"]
      .hsdc-mobile-group-item {
        opacity: 1;
        transform: translateY(0);
      }

      header#header .hsdc-mobile-nav.expanded
      .hsdc-mobile-group-item:nth-child(1),
      header#header .hsdc-mobile-nav[data-expanded="true"]
      .hsdc-mobile-group-item:nth-child(1) {
        transition-delay: 0.04s;
      }

      header#header .hsdc-mobile-nav.expanded
      .hsdc-mobile-group-item:nth-child(2),
      header#header .hsdc-mobile-nav[data-expanded="true"]
      .hsdc-mobile-group-item:nth-child(2) {
        transition-delay: 0.08s;
      }

      header#header .hsdc-mobile-nav.expanded
      .hsdc-mobile-group-item:nth-child(3),
      header#header .hsdc-mobile-nav[data-expanded="true"]
      .hsdc-mobile-group-item:nth-child(3) {
        transition-delay: 0.12s;
      }


      /* =====================================================
         手机 details / summary
      ====================================================== */

      .hsdc-mobile-group {
        width: 100%;
      }

      .hsdc-mobile-group summary {
        list-style: none;
        cursor: pointer;
      }

      .hsdc-mobile-group summary::-webkit-details-marker {
        display: none;
      }

      .hsdc-mobile-group-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;

        width: 100%;
        box-sizing: border-box;

        padding: 13px 16px;

        font-size: 1.05rem;
        font-weight: 500;

        transition:
          transform 160ms ease,
          opacity 160ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-group-trigger:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-mobile-group-chevron {
        width: 18px;
        height: 18px;

        transition:
          transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-group-chevron {
        transform: rotate(180deg);
      }

      .hsdc-mobile-group.is-closing
      .hsdc-mobile-group-chevron {
        transform: rotate(0deg);
      }


      /* =====================================================
         手机二级菜单
      ====================================================== */

      .hsdc-mobile-submenu {
        display: grid;

        grid-template-rows: 0fr;

        opacity: 0;

        transform: translateY(-5px);

        pointer-events: none;

        transition:
          grid-template-rows 0.34s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.22s ease,
          transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu {
        grid-template-rows: 1fr;

        opacity: 1;

        transform: translateY(0);

        pointer-events: auto;
      }

      .hsdc-mobile-group.is-closing
      .hsdc-mobile-submenu {
        grid-template-rows: 0fr;

        opacity: 0;

        transform: translateY(-5px);

        pointer-events: none;
      }

      .hsdc-mobile-submenu-inner {
        overflow: hidden;
        min-height: 0;
      }

      .hsdc-mobile-submenu ul {
        padding: 0 0 6px 14px;
      }

      .hsdc-mobile-submenu li {
        opacity: 0;
        transform: translateY(-5px);

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li {
        opacity: 1;
        transform: translateY(0);
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(1) {
        transition-delay: 0.04s;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(2) {
        transition-delay: 0.08s;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(3) {
        transition-delay: 0.12s;
      }

      .hsdc-mobile-group.is-open
      .hsdc-mobile-submenu li:nth-child(4) {
        transition-delay: 0.16s;
      }

      .hsdc-mobile-submenu a {
        display: flex;
        align-items: center;

        width: 100%;
        box-sizing: border-box;

        padding: 10px 16px;

        font-size: 0.96rem;

        color: inherit;

        border-radius: 10px;

        transition:
          transform 180ms ease,
          opacity 180ms ease,
          background-color 180ms ease;
      }

      .hsdc-mobile-submenu a:active {
        transform: scale(0.975);
        opacity: 0.72;
      }

      .hsdc-mobile-submenu .aw-link-active {
        font-weight: 600;
      }


      /* =====================================================
         手机主题
      ====================================================== */

      .menu-theme-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        padding: 0.75rem 1rem;
        margin-top: 0.5rem;

        border-top: 1px solid rgba(0, 0, 0, 0.06);

        color: #666;
      }

      .dark .menu-theme-item {
        border-top-color: rgba(255, 255, 255, 0.06);
        color: #aaa;
      }


      /* =====================================================
         手机滚动条
      ====================================================== */

      .hsdc-mobile-nav::-webkit-scrollbar {
        width: 4px;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-track {
        background: transparent !important;
      }

      .hsdc-mobile-nav::-webkit-scrollbar-thumb {
        background: rgba(100, 116, 139, 0.25);
        border-radius: 999px;
      }
    }


    /* =========================================================
       电脑 / 平板
    ========================================================= */

    @media (min-width: 768px) {

      .hsdc-mobile-header {
        display: none !important;
      }

      .hsdc-desktop-header {
        display: flex;
      }


      /* =====================================================
         中间导航
      ====================================================== */

      .hsdc-desktop-nav {
        display: flex;
        align-items: center;
        justify-content: center;

        flex: 0 0 auto;

        margin: 0 1rem;
      }

      .hsdc-desktop-groups {
        display: flex;
        align-items: center;

        gap: 2px;
      }

      .hsdc-desktop-group {
        position: relative;
      }


      /* =====================================================
         一级菜单按钮
      ====================================================== */

      .hsdc-desktop-group-trigger {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 0.28rem;

        min-height: 42px;

        padding: 0.55rem 0.85rem;

        border: 0;
        border-radius: 10px;

        color: inherit;

        font-size: 0.9375rem;
        font-weight: 500;

        cursor: pointer;
        white-space: nowrap;

        transition:
          background-color 180ms ease,
          color 180ms ease,
          transform 180ms ease;
      }

      @media (hover: hover) and (pointer: fine) {

        .hsdc-desktop-group-trigger:hover {
          background: rgba(255, 255, 255, 0.1) !important;

          transform: translateY(-1px);
        }

        .dark .hsdc-desktop-group-trigger:hover {
          background: rgba(255, 255, 255, 0.06) !important;
        }
      }

      .hsdc-desktop-group-trigger:active {
        transform: scale(0.97);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-group-trigger {
        background: rgba(255, 255, 255, 0.1) !important;
      }

      .dark .hsdc-desktop-group.is-open
      .hsdc-desktop-group-trigger {
        background: rgba(255, 255, 255, 0.06) !important;
      }


      /* =====================================================
         V 箭头
      ====================================================== */

      .hsdc-desktop-chevron {
        width: 15px;
        height: 15px;

        transition:
          transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-chevron {
        transform: rotate(180deg);
      }


      /* =====================================================
         Windows 式二级菜单
      ====================================================== */

      .hsdc-desktop-dropdown {
        position: absolute;

        top: calc(100% + 7px);
        left: 50%;

        min-width: 178px;

        padding: 6px;

        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 12px;

        background: rgba(255, 255, 255, 0.94) !important;

        box-shadow:
          0 16px 40px rgba(15, 23, 42, 0.12),
          0 4px 12px rgba(15, 23, 42, 0.06);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        opacity: 0;

        visibility: hidden;
        pointer-events: none;

        transform:
          translate(-50%, -7px)
          scale(0.97);

        transform-origin: top center;

        will-change: opacity, transform;

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 220ms;
      }

      .dark .hsdc-desktop-dropdown {
        background: rgba(25, 25, 28, 0.94) !important;

        border-color: rgba(255, 255, 255, 0.1);

        box-shadow:
          0 18px 45px rgba(0, 0, 0, 0.35),
          0 4px 14px rgba(0, 0, 0, 0.2);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown {
        opacity: 1;

        visibility: visible;
        pointer-events: auto;

        transform:
          translate(-50%, 0)
          scale(1);

        transition:
          opacity 180ms ease,
          transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
      }


      /* =====================================================
         二级菜单项目
      ====================================================== */

      .hsdc-desktop-dropdown a {
        display: flex;
        align-items: center;

        min-height: 38px;

        padding: 0.45rem 0.8rem;

        border-radius: 8px;

        font-size: 0.9rem;
        font-weight: 450;

        white-space: nowrap;

        opacity: 0;
        transform: translateY(-3px);

        transition:
          background-color 160ms ease,
          transform 160ms ease,
          opacity 180ms ease;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a {
        opacity: 1;
        transform: translateY(0);
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(1) {
        transition-delay: 0.025s;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(2) {
        transition-delay: 0.05s;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(3) {
        transition-delay: 0.075s;
      }

      .hsdc-desktop-group.is-open
      .hsdc-desktop-dropdown a:nth-child(4) {
        transition-delay: 0.1s;
      }

      @media (hover: hover) and (pointer: fine) {

        .hsdc-desktop-dropdown a:hover {
          background: rgba(100, 116, 139, 0.09) !important;

          transform: translateX(2px);
        }

        .dark .hsdc-desktop-dropdown a:hover {
          background: rgba(255, 255, 255, 0.08) !important;
        }
      }

      .hsdc-desktop-dropdown a:active {
        transform: scale(0.975);

        opacity: 0.72;
      }

      .hsdc-desktop-dropdown .aw-link-active {
        font-weight: 600;
      }


      /* =====================================================
         搜索预留区域
      ====================================================== */

      .hsdc-desktop-search-space {
        flex: 1 1 auto;

        min-width: 80px;
      }


      /* =====================================================
         右侧功能
      ====================================================== */

      .hsdc-desktop-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        flex: 0 0 auto;
      }


      /* =====================================================
         减少动态效果
      ====================================================== */

      @media (prefers-reduced-motion: reduce) {

        .hsdc-desktop-group-trigger,
        .hsdc-desktop-chevron,
        .hsdc-desktop-dropdown,
        .hsdc-desktop-dropdown a,
        .hsdc-mobile-nav,
        .hsdc-mobile-group-item,
        .hsdc-mobile-group-trigger,
        .hsdc-mobile-group-chevron,
        .hsdc-mobile-submenu,
        .hsdc-mobile-submenu a,
        .hsdc-mobile-submenu li {
          transition: none !important;
        }
      }
    }


    /* =========================================================
       768px 以下隐藏桌面菜单
    ========================================================= */

    @media (max-width: 767px) {

      .hsdc-desktop-header {
        display: none !important;
      }
    }
  </style></style>

<header id="header" class="hsdc-header">
  <div class="absolute inset-0" style="background: transparent !important;"></div>

  <!-- 移动端 -->
  <div class="hsdc-mobile-header relative text-default py-1.5 px-3 w-full">
    <div class="flex items-center justify-between w-full">
      <a class="hsdc-brand" href={getHomePermalink()} aria-label="返回首页">
        <Logo />
      </a>

      <div class="flex items-center translate-x-1">
        <ToggleMenu />
      </div>
    </div>

    <nav class="hsdc-mobile-nav" aria-label="移动端主导航">
      <a
        class="hsdc-mobile-home"
        href={getHomePermalink()}
      >
        首页
      </a>

      {
        groups?.map((group) => (
          <div class="hsdc-mobile-group">
            <button
              type="button"
              class="hsdc-mobile-group-button"
              aria-expanded="false"
            >
              <span>{group.text}</span>
              <span
                class="hsdc-mobile-group-chevron"
                aria-hidden="true"
              >
                ›
              </span>
            </button>

            <div class="hsdc-mobile-submenu">
              {group.links?.map((item) => (
                <a
                  href={item.href}
                  target={item.target}
                  rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                >
                  {item.text}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </nav>
  </div>

  <!-- 桌面端 / 平板端 -->
  <div
    class:list={[
      'hsdc-desktop-header',
      'relative',
      'mx-auto',
      'w-full',
      'px-4',
      'sm:px-6',
      'lg:px-8',
      'py-3',
    ]}
  >
    <div class="flex items-center w-full min-h-[64px]">
      <!-- Logo -->
      <a
        class="hsdc-brand flex items-center shrink-0"
        href={getHomePermalink()}
        aria-label="返回首页"
      >
        <Logo />
      </a>

      <!-- 桌面导航 -->
      <nav
        class="hsdc-desktop-nav flex items-center ml-auto"
        aria-label="主导航"
      >
        <a
          class="hsdc-home-link"
          href={getHomePermalink()}
        >
          首页
        </a>

        {
          groups?.map((group, index) => (
            <div
              class="hsdc-desktop-group"
              data-group-index={index}
            >
              <button
                type="button"
                class="hsdc-desktop-group-button"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{group.text}</span>

                <svg
                  class="hsdc-chevron"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>

              <div
                class="hsdc-desktop-dropdown"
                role="menu"
              >
                {
                  group.links?.map((item) => (
                    <a
                      href={item.href}
                      target={item.target}
                      rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                      role="menuitem"
                    >
                      {item.text}
                    </a>
                  ))
                }
              </div>
            </div>
          ))
        }
      </nav>

      <!-- 右侧预留区域 -->
      <div class="hsdc-header-right flex items-center ml-4 shrink-0">
        {showToggleTheme && <ToggleTheme />}

        {
          actions?.map((action) => (
            <a
              href={action.href}
              target={action.target}
              rel={action.target === '_blank' ? 'noopener noreferrer' : undefined}
              class="hsdc-action"
            >
              {action.text}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <script>
    (() => {
      let controller: AbortController | null = null;

      const initHeader = () => {
        controller?.abort();
        controller = new AbortController();

        const { signal } = controller;
        const header = document.querySelector('#header');

        if (!header) return;

        const desktopGroups = Array.from(
          header.querySelectorAll<HTMLElement>('.hsdc-desktop-group')
        );

        const mobileGroups = Array.from(
          header.querySelectorAll<HTMLElement>('.hsdc-mobile-group')
        );

        const mobileNav =
          header.querySelector<HTMLElement>('.hsdc-mobile-nav');

        const toggleMenu =
          header.querySelector<HTMLElement>('[data-aw-toggle-menu]');

        /*
         * ================================
         * 桌面端一级菜单
         * ================================
         */

        const closeDesktopGroups = () => {
          desktopGroups.forEach((group) => {
            group.classList.remove('is-open');

            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-desktop-group-button'
              );

            if (button) {
              button.setAttribute('aria-expanded', 'false');
            }
          });
        };

        const openDesktopGroup = (group: HTMLElement) => {
          desktopGroups.forEach((item) => {
            if (item !== group) {
              item.classList.remove('is-open');

              const button =
                item.querySelector<HTMLButtonElement>(
                  '.hsdc-desktop-group-button'
                );

              if (button) {
                button.setAttribute('aria-expanded', 'false');
              }
            }
          });

          const button =
            group.querySelector<HTMLButtonElement>(
              '.hsdc-desktop-group-button'
            );

          const isOpen = group.classList.contains('is-open');

          if (isOpen) {
            group.classList.remove('is-open');
            button?.setAttribute('aria-expanded', 'false');
          } else {
            group.classList.add('is-open');
            button?.setAttribute('aria-expanded', 'true');
          }
        };

        desktopGroups.forEach((group) => {
          const button =
            group.querySelector<HTMLButtonElement>(
              '.hsdc-desktop-group-button'
            );

          if (!button) return;

          button.addEventListener(
            'click',
            (event) => {
              event.preventDefault();
              event.stopPropagation();

              openDesktopGroup(group);
            },
            { signal }
          );
        });

        document.addEventListener(
          'click',
          (event) => {
            const target = event.target as Node | null;

            if (!target) return;

            if (!header.contains(target)) {
              closeDesktopGroups();
              return;
            }

            if (
              !(target instanceof Element) ||
              !target.closest('.hsdc-desktop-group')
            ) {
              closeDesktopGroups();
            }
          },
          { signal }
        );

        document.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'Escape') {
              closeDesktopGroups();
            }
          },
          { signal }
        );

        /*
         * ================================
         * 移动端二级菜单
         * ================================
         */

        const closeMobileGroups = (immediate = false) => {
          mobileGroups.forEach((group) => {
            const button =
              group.querySelector<HTMLButtonElement>(
                '.hsdc-mobile-group-button'
              );

            const submenu =
              group.querySelector<HTMLElement>(
                '.hsdc-mobile-submenu'
              );

            group.classList.remove('is-open');

            button?.setAttribute('aria-expanded', 'false');

            if (!submenu) return;

            submenu.style.transition = immediate
              ? 'none'
              : '';

            submenu.style.maxHeight = '0px';
            submenu.style.opacity = '0';
            submenu.style.transform = 'translateY(-4px)';
          });
        };

        const openMobileGroup = (group: HTMLElement) => {
          const button =
            group.querySelector<HTMLButtonElement>(
              '.hsdc-mobile-group-button'
            );

          const submenu =
            group.querySelector<HTMLElement>(
              '.hsdc-mobile-submenu'
            );

          if (!button || !submenu) return;

          const isOpen = group.classList.contains('is-open');

          /*
           * 先关闭其它二级菜单。
           * 这样移动端始终只展开一个菜单，
           * 同时避免多个 submenu 同时参与布局。
           */
          mobileGroups.forEach((item) => {
            if (item === group) return;

            const itemButton =
              item.querySelector<HTMLButtonElement>(
                '.hsdc-mobile-group-button'
              );

            const itemSubmenu =
              item.querySelector<HTMLElement>(
                '.hsdc-mobile-submenu'
              );

            item.classList.remove('is-open');
            itemButton?.setAttribute('aria-expanded', 'false');

            if (itemSubmenu) {
              itemSubmenu.style.maxHeight = '0px';
              itemSubmenu.style.opacity = '0';
              itemSubmenu.style.transform = 'translateY(-4px)';
            }
          });

          if (isOpen) {
            group.classList.remove('is-open');
            button.setAttribute('aria-expanded', 'false');

            submenu.style.maxHeight = '0px';
            submenu.style.opacity = '0';
            submenu.style.transform = 'translateY(-4px)';

            return;
          }

          group.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');

          /*
           * 读取真实高度，再展开。
           * 不直接写死高度，避免不同设备出现截断。
           */
          submenu.style.maxHeight = `${submenu.scrollHeight}px`;
          submenu.style.opacity = '1';
          submenu.style.transform = 'translateY(0)';
        };

        mobileGroups.forEach((group) => {
          const button =
            group.querySelector<HTMLButtonElement>(
              '.hsdc-mobile-group-button'
            );

          if (!button) return;

          button.addEventListener(
            'click',
            (event) => {
              event.preventDefault();
              event.stopPropagation();

              openMobileGroup(group);
            },
            { signal }
          );
        });

        /*
         * ================================
         * 汉堡菜单
         * ================================
         */

        if (toggleMenu) {
          toggleMenu.addEventListener(
            'click',
            (event) => {
              /*
               * 不在这里主动切换 expanded。
               * ToggleMenu / BasicScripts 负责主菜单状态，
               * Header 这里只负责清理二级菜单状态。
               */
              event.stopPropagation();

              const isExpanded =
                toggleMenu.classList.contains('expanded');

              if (isExpanded) {
                closeMobileGroups(true);
              }
            },
            {
              signal,
              capture: true,
            }
          );
        }

        /*
         * 点击移动端二级菜单后，
         * 立即清理所有展开状态。
         */
        header
          .querySelectorAll<HTMLAnchorElement>(
            '.hsdc-mobile-submenu a'
          )
          .forEach((link) => {
            link.addEventListener(
              'click',
              () => {
                closeMobileGroups(true);
              },
              { signal }
            );
          });

        /*
         * ================================
         * 初始状态
         * ================================
         */

        closeDesktopGroups();
        closeMobileGroups(true);

        /*
         * ================================
         * 屏幕尺寸变化
         * ================================
         */

        const mediaQuery = window.matchMedia('(min-width: 1024px)');

        const handleMediaChange = () => {
          if (mediaQuery.matches) {
            closeMobileGroups(true);

            if (mobileNav) {
              mobileNav.classList.remove('expanded');
              mobileNav.removeAttribute('data-expanded');
            }

            toggleMenu?.classList.remove('expanded');
          } else {
            closeDesktopGroups();
          }
        };

        mediaQuery.addEventListener('change', handleMediaChange, {
          signal,
        });
      };

      initHeader();

      document.addEventListener(
        'astro:after-swap',
        () => {
          initHeader();
        }
      );
    })();
  </script>
</header>