<!-- 独立的搜索框组件，用于动态注入 -->
<div 
  id="search-box-container"
  class="fixed bottom-0 left-0 right-0 z-50 px-4 pb-4 pt-2"
  style="background: rgba(255,255,255,0.10); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid rgba(255,255,255,0.15); box-shadow: 0 -4px 20px rgba(0,0,0,0.08);"
>
  <div class="max-w-2xl mx-auto">
    <form id="search-form" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
      <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
      <input
        id="search-input"
        type="text"
        name="q"
        placeholder="搜索本站内容..."
        class="w-full py-3 px-6 pl-12 bg-white/20 backdrop-blur-sm md:backdrop-blur-lg border border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg"
        autocomplete="off"
      />
      <button
        type="button"
        class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700 transition-colors"
        id="search-toggle"
        aria-label="聚焦搜索框"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button
        type="button"
        id="mode-toggle"
        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-xs text-gray-500 bg-white/30 backdrop-blur-sm px-2 py-1 rounded-full hover:bg-white/50 transition-colors"
      >
        <span id="mode-label">站外</span>
      </button>
    </form>
    <div id="search-results-container" class="mt-2 bg-white/20 backdrop-blur-lg border border-white/30 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
  </div>
</div>

<script>
  (function() {
    // 搜索逻辑（与之前相同）
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const modeToggle = document.getElementById('mode-toggle');
    const modeLabel = document.getElementById('mode-label');
    const resultsContainer = document.getElementById('search-results-container');
    const toggleBtn = document.getElementById('search-toggle');

    if (!form || !input) return;

    let mode = 'external';
    let searchData = null;

    async function loadSearchData() {
      try {
        const resp = await fetch('/search.json');
        if (resp.ok) searchData = await resp.json();
      } catch (e) {}
    }

    function searchInternal(query) {
      if (!searchData || !query.trim()) return [];
      const q = query.toLowerCase().trim();
      return searchData.filter(page => {
        const title = page.title.toLowerCase();
        const desc = page.description.toLowerCase();
        const content = page.content.toLowerCase();
        return title.includes(q) || desc.includes(q) || content.includes(q);
      }).slice(0, 10);
    }

    function showResults(results) {
      resultsContainer.innerHTML = '';
      if (results.length === 0) {
        resultsContainer.classList.add('hidden');
        return;
      }
      let html = '';
      for (const page of results) {
        html += `
          <a href="${page.url}" class="block px-4 py-2 hover:bg-white/20 transition-colors border-b border-white/10 last:border-0">
            <div class="font-medium text-gray-800">${page.title}</div>
            <div class="text-sm text-gray-600 truncate">${page.description}</div>
          </a>
        `;
      }
      resultsContainer.innerHTML = html;
      resultsContainer.classList.remove('hidden');
    }

    function clearResults() {
      resultsContainer.innerHTML = '';
      resultsContainer.classList.add('hidden');
    }

    function updateMode(newMode) {
      mode = newMode;
      clearResults();
      if (mode === 'external') {
        form.action = 'https://www.bing.com/search';
        form.target = '_blank';
        let hidden = form.querySelector('input[name="q1"]');
        if (!hidden) {
          hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'q1';
          form.appendChild(hidden);
        }
        hidden.value = 'site:hsdc.dpdns.org';
        input.name = 'q';
        input.placeholder = '搜索本站内容...';
        modeLabel.textContent = '站外';
      } else {
        form.action = '#';
        form.target = '';
        const hidden = form.querySelector('input[name="q1"]');
        if (hidden) hidden.remove();
        input.name = '';
        input.placeholder = '输入关键词检索本站';
        modeLabel.textContent = '站内';
        if (input.value.trim()) {
          const results = searchInternal(input.value);
          showResults(results);
        }
      }
    }

    input.addEventListener('input', function() {
      if (mode === 'internal') {
        const query = this.value.trim();
        if (!query) { clearResults(); return; }
        const results = searchInternal(query);
        showResults(results);
      } else {
        clearResults();
      }
    });

    document.addEventListener('click', function(e) {
      const container = document.getElementById('search-box-container');
      if (container && !container.contains(e.target)) {
        clearResults();
      }
    });

    modeToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const newMode = mode === 'external' ? 'internal' : 'external';
      updateMode(newMode);
    });

    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      input.focus();
    });

    updateMode('external');
    loadSearchData();
  })();
</script>

<style>
  /* 暗色模式适配 */
  .dark #search-box-container {
    background: rgba(0, 0, 0, 0.30);
    border-top-color: rgba(255, 255, 255, 0.05);
  }
  .dark #search-box-container input {
    background: rgba(31, 41, 55, 0.30);
    color: #f3f4f6;
    border-color: rgba(255, 255, 255, 0.10);
  }
  .dark #search-box-container input::placeholder {
    color: #6b7280;
  }
  .dark #search-box-container .icon-btn {
    color: #9ca3af;
  }
  .dark #search-box-container .mode-btn {
    background: rgba(55, 65, 81, 0.40);
    color: #d1d5db;
  }
  .dark #search-results-container {
    background: rgba(31, 41, 55, 0.30);
    border-color: rgba(255, 255, 255, 0.10);
  }
  .dark #search-results-container a {
    color: #f3f4f6;
  }
  .dark #search-results-container a:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .dark #search-results-container .text-gray-600 {
    color: #9ca3af !important;
  }
</style>