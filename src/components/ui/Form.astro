---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props;
---

<form action="https://formspree.io/f/mlgqvrnq" method="POST" id="contact-form">
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '' }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit" id="submit-btn">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }

  <!-- ===== 剩余条数显示（调用 Cloudflare KV） ===== -->
  <div id="remaining-display" class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
    本月剩余可用次数：<span id="remaining-count" class="font-bold text-blue-600 dark:text-blue-400">--</span> 次
  </div>
</form>

<script>
  (function() {
    const API_URL = '/api/count';

    async function fetchRemaining() {
      try {
        const resp = await fetch(API_URL);
        const data = await resp.json();
        const remaining = data.value || 0;
        const countEl = document.getElementById('remaining-count');
        if (countEl) countEl.textContent = remaining;
        updateUI(remaining);
        return remaining;
      } catch (e) {
        console.error('获取剩余次数失败', e);
        const countEl = document.getElementById('remaining-count');
        if (countEl) countEl.textContent = '?';
      }
    }

    function updateUI(remaining) {
      const btn = document.getElementById('submit-btn');
      const countEl = document.getElementById('remaining-count');
      if (remaining <= 0) {
        if (btn) { btn.disabled = true; btn.textContent = '额度已用完'; }
        if (countEl) {
          countEl.textContent = '0';
          countEl.className = 'font-bold text-red-600 dark:text-red-400';
        }
      } else {
        if (btn) btn.disabled = false;
        if (countEl) {
          countEl.className = 'font-bold text-blue-600 dark:text-blue-400';
        }
      }
    }

    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', async function(e) {
        let current = 0;
        try {
          const resp = await fetch(API_URL);
          const data = await resp.json();
          current = data.value || 0;
        } catch (e) {
          alert('无法验证剩余次数，请检查网络后重试');
          e.preventDefault();
          return;
        }

        if (current <= 0) {
          e.preventDefault();
          alert('本月额度已用完，请通过邮箱发送至：xuexiang@lianggong.dpdns.org');
          return;
        }

        try {
          const updateResp = await fetch(API_URL, { method: 'POST' });
          const updateData = await updateResp.json();
          if (updateData.error) {
            alert('更新失败：' + updateData.error);
            e.preventDefault();
            return;
          }
          const newValue = updateData.value;
          const countEl = document.getElementById('remaining-count');
          if (countEl) countEl.textContent = newValue;
          updateUI(newValue);
        } catch (e) {
          alert('更新计数失败，请稍后重试');
          e.preventDefault();
        }
      });
    }

    function init() {
      fetchRemaining();
    }
    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:after-swap', init);
    window.addEventListener('load', init);
  })();
</script>