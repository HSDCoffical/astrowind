---
import { DashboardLayout } from "~/components/DashboardLayout";
---

<DashboardLayout client:load>
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">消息中心</h1>
  </div>
  <div id="messages-list">
    <p>加载中...</p>
  </div>

  <script>
    const loadMessages = async () => {
      try {
        const res = await fetch('/api/messages', { credentials: 'include' });
        if (!res.ok) throw new Error('请求失败');
        const data = await res.json();
        if (data.length === 0) {
          document.getElementById('messages-list').innerHTML = '<p class="text-gray-500">暂无消息</p>';
          return;
        }
        document.getElementById('messages-list').innerHTML = data.map(m => `
          <div class="border rounded-lg p-4 ${!m.is_read ? 'bg-blue-50' : 'bg-white'} mb-2">
            <div class="flex justify-between items-start">
              <div>
                <p class="font-medium">${m.sender_id === 0 ? '系统通知' : (m.sender_name || '未知用户')}</p>
                <p class="text-sm text-gray-600">${m.content}</p>
              </div>
              <div class="text-xs text-gray-400 text-right">
                ${new Date(m.created_at + 'Z').toLocaleString()}
                ${!m.is_read ? `<button onclick="markRead(${m.id})" class="block mt-1 text-blue-600 underline">标为已读</button>` : ''}
              </div>
            </div>
          </div>
        `).join('');
      } catch {
        document.getElementById('messages-list').innerHTML = '<p class="text-red-500">加载失败，请刷新重试</p>';
      }
    };

    window.markRead = async (id) => {
      try {
        await fetch(`/api/messages/${id}/read`, { method: 'POST', credentials: 'include' });
        loadMessages();
      } catch {
        alert('操作失败');
      }
    };

    loadMessages();
  </script>
</DashboardLayout>