---
export const prerender = false;

import DashboardLayout from "~/components/DashboardLayout.astro";
import { getSession } from "~/lib/api";

const user = await getSession();
---

<DashboardLayout>
  <h1 class="text-2xl font-bold mb-4">概览</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
      <p class="text-gray-500">用户名</p>
      <p class="text-xl font-bold">{user?.username}</p>
    </div>
    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
      <p class="text-gray-500">邮箱</p>
      <p class="text-xl font-bold">{user?.email}</p>
    </div>
    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
      <p class="text-gray-500">角色</p>
      <p class="text-xl font-bold">{user?.role === "admin" ? "管理员" : "用户"}</p>
    </div>
  </div>
</DashboardLayout>