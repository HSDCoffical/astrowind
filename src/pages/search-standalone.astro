---
// 独立的搜索框页面，用于 iframe 嵌入
const API_URL = '/search.json';
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>搜索</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background: transparent !important;
        font-family: system-ui, -apple-system, sans-serif;
        padding: 8px 16px 12px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 76px;
        width: 100%;
      }
      #search-container {
        width: 100%;
        max-width: 672px;
        margin: 0 auto;
      }
      form {
        position: relative;
        width: 100%;
      }
      input[type="text"] {
        width: 100%;
        padding: 10px 48px 10px 48px;
        background: rgba(255, 255, 255, 0.20);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.30);
        border-radius: 9999px;
        color: #1f2937;
        font-size: 16px;
        outline: none;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        transition: border-color 0.2s;
      }
      input[type="text"]:focus {
        border-color: rgba(59, 130, 246, 0.5);
      }
      input[type="text"]::placeholder {
        color: #9ca3af;
      }
      .dark input[type="text"] {
        background: rgba(31, 41, 55, 0.30);
        color: #f3f4f6;
        border-color: rgba(255, 255, 255, 0.10);
      }
      .dark input[type="text"]::placeholder {
        color: #6b7280;
      }
      .icon-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #6b7280;
        padding: 4px;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .icon-btn:hover {
        color: #1f2937;
      }
      .dark .icon-btn {
        color: #9ca3af;
      }
      .dark .icon-btn:hover {
        color: #f3f4f6;
      }
      .icon-btn svg {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
      }
      .mode-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.30);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        border: none;
        padding: 2px 10px;
        border-radius: 9999px;
        font-size: 11px;
        color: #4b5563;
        cursor: pointer;
        transition: background 0.2s;
        line-height: 1.6;
      }
      .dark .mode-btn {
        background: rgba(55, 65, 81, 0.40);
        color: #d1d5db;
      }
      .mode-btn:hover {
        background: rgba(255, 255, 255, 0.50);
      }
      .dark .mode-btn:hover {
        background: rgba(75, 85, 99, 0.60);
      }
      #results {
        margin-top: 8px;
        background: rgba(255, 255, 255, 0.20);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.30);
        border-radius: 12px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        max-height: 240px;
        overflow-y: auto;
        display: none;
      }
      .dark #results {
        background: rgba(31, 41, 55, 0.30);
        border-color: rgba(255, 255, 255, 0.10);
      }
      #results a {
        display: block;
        padding: 8px 16px;
        color: #1f2937;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.10);
        transition: background 0.15s;
      }
      .dark #results a {
        color: #f3f4f6;
      }
      #results a:last-child {
        border-bottom: none;
      }
      #results a:hover {
        background: rgba(255, 255, 255, 0.20);
      }
      .dark #results a:hover {
        background: rgba(255, 255, 255, 0.05);
      }
      #results .title {
        font-weight: 500;
        font-size: 14px;
      }
      #results .desc {
        font-size: 12px;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .dark #results .desc {
        color: #9ca3af;
      }
      .hidden {
        display: none !important;
      }

      /* 夜间模式适配（由父页面控制，这里做个备用） */
      @media (prefers-color-scheme: dark) {
        body {
          background: transparent !important;
        }
        input[type="text"] {
          background: rgba(31, 41, 55, 0.30);
          color: #f3f4f6;
          border-color: rgba(255, 255, 255, 0.10);
        }
        input[type="text"]::placeholder {
          color: #6b7280;
        }
        .icon-btn {
          color: #9ca3af;
        }
        .icon-btn:hover {
          color: #f3f4f6;
        }
        .mode-btn {
          background: rgba(55, 65, 81, 0.40);
          color: #d1d5db;
        }
        .mode-btn:hover {
          background: rgba(75, 85, 99, 0.60);
        }
        #results {
          background: rgba(31, 41, 55, 0.30);
          border-color: rgba(255, 255, 255, 0.10);
        }
        #results a {
          color: #f3f4f6;
        }
        #results a:hover {
          background: rgba(255, 255, 255, 0.05);
        }
        #results .desc {
          color: #9ca3af;
        }
      }
    </style>
  </head>
  <body>
    <div id="search-container">
      <form id="search-form" action="https://www.bing.com/search" method="GET" target="_blank">
        <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
        <input
          id="search-input"
          type="text"
          name="q"
          placeholder="搜索本站内容..."
          autocomplete="off"
        />
        <button type="button" id="search-toggle" class="icon-btn" aria-label="聚焦搜索框">
          <svg viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <button type="button" id="mode-toggle" class="mode-btn"><span id="mode-label">站外</span></button>
      </form>
      <div id="results"></div>
    </div>

    <script>
      (function() {
        const form = document.getElementById('search-form');
        const input = document.getElementById('search-input');
        const toggleBtn = document.getElementById('search-toggle');
        const modeToggle = document.getElementById('mode-toggle');
        const modeLabel = document.getElementById('mode-label');
        const resultsContainer = document.getElementById('results');

        let mode = 'external';
        let searchData = null;

        async function loadSearchData() {
          try {
            const resp = await fetch('/search.json');
            if (resp.ok) {
              searchData = await resp.json();
            }
          } catch (e) {}
        }

        function searchInternal(query) {
          if (!searchData || !query.trim()) return [];
          const q = query.toLowerCase().trim();
          return searchData
            .filter(page => {
              const title = page.title.toLowerCase();
              const desc = page.description.toLowerCase();
              const content = page.content.toLowerCase();
              return title.includes(q) || desc.includes(q) || content.includes(q);
            })
            .slice(0, 10);
        }

        function showResults(results) {
          resultsContainer.innerHTML = '';
          if (results.length === 0) {
            resultsContainer.style.display = 'none';
            return;
          }
          let html = '';
          for (const page of results) {
            html += `
              <a href="${page.url}">
                <div class="title">${page.title}</div>
                <div class="desc">${page.description || ''}</div>
              </a>
            `;
          }
          resultsContainer.innerHTML = html;
          resultsContainer.style.display = 'block';
        }

        function clearResults() {
          resultsContainer.innerHTML = '';
          resultsContainer.style.display = 'none';
        }

        function updateMode(newMode) {
          mode = newMode;
          clearResults();
          if (mode === 'external') {
            form.action = 'https://www.bing.com/search';
            form.target = '_blank';
            let hidden = form.querySelector('input[name="q1"]');
            if (!hidden) {
              hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = 'q1';
              form.appendChild(hidden);
            }
            hidden.value = 'site:hsdc.dpdns.org';
            input.name = 'q';
            input.placeholder = '搜索本站内容...';
            modeLabel.textContent = '站外';
          } else {
            form.action = '#';
            form.target = '';
            const hidden = form.querySelector('input[name="q1"]');
            if (hidden) hidden.remove();
            input.name = '';
            input.placeholder = '输入关键词检索本站';
            modeLabel.textContent = '站内';
            if (input.value.trim()) {
              const results = searchInternal(input.value);
              showResults(results);
            }
          }
          input.focus();
        }

        input.addEventListener('input', function() {
          if (mode === 'internal') {
            const query = this.value.trim();
            if (!query) { clearResults(); return; }
            const results = searchInternal(query);
            showResults(results);
          } else {
            clearResults();
          }
        });

        // 点击外部清除结果
        document.addEventListener('click', function(e) {
          const container = document.getElementById('search-container');
          if (container && !container.contains(e.target)) {
            clearResults();
          }
        });

        modeToggle.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const newMode = mode === 'external' ? 'internal' : 'external';
          updateMode(newMode);
        });

        toggleBtn.addEventListener('click', function(e) {
          e.preventDefault();
          input.focus();
        });

        // 初始化
        updateMode('external');
        loadSearchData();

        // 监听父页面暗色模式变化（通过 class 检测）
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          document.body.classList.toggle('dark', isDark);
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        // 初始检测
        if (document.documentElement.classList.contains('dark')) {
          document.body.classList.add('dark');
        }
      })();
    </script>
  </body>
</html>