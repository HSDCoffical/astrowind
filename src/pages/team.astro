---
import PageLayout from '~/layouts/PageLayout.astro';

const people = [
  {
    name: '雪乡',
    position: '建设者',
  },

  // 后续增加人员直接复制：
  // {
  //   name: '姓名',
  //   position: '职位',
  // },
];

const metadata = {
  title: '人员介绍 | 凉宫数据',
  description: '凉宫数据人员介绍',
};
---

<PageLayout metadata={metadata}>
  <main class="team-page">
    <section class="team-container">
      <header class="team-header">
        <h1>人员介绍</h1>
      </header>

      <section class="people-list" aria-label="人员列表">
        {
          people.map((person) => (
            <article class="person">
              <div class="person-info">
                <h2>{person.name}</h2>
                <p>{person.position}</p>
              </div>
            </article>
          ))
        }
      </section>
    </section>
  </main>
</PageLayout>

<style>
  .team-page {
    min-height: 100vh;
    background: #fff;
    color: #111;
  }

  .team-container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 150px 0 120px;
  }

  .team-header {
    padding-bottom: 64px;
  }

  .team-header h1 {
    margin: 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.045em;
  }

  .people-list {
    border-top: 1px solid rgba(0, 0, 0, 0.14);
  }

  .person {
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
  }

  .person-info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
    padding: 34px 8px;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }

  .person h2 {
    margin: 0;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .person p {
    margin: 0;
    color: rgba(0, 0, 0, 0.55);
    font-size: 18px;
    line-height: 1.4;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .person-info:hover {
      transform: translateX(8px);
    }

    .person-info:hover h2 {
      opacity: 0.72;
    }
  }

  @media (max-width: 640px) {
    .team-container {
      width: min(100% - 32px, 1180px);
      padding: 120px 0 80px;
    }

    .team-header {
      padding-bottom: 48px;
    }

    .team-header h1 {
      font-size: 48px;
    }

    .person-info {
      display: block;
      padding: 28px 4px;
    }

    .person h2 {
      font-size: 30px;
    }

    .person p {
      margin-top: 8px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .person-info {
      transition: none;
    }
  }
</style>