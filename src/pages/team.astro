---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '人员介绍 | 凉宫数据',
  description: '了解凉宫数据的团队成员与建设者。',
};

// =====================================================
// 人员资料
// =====================================================
//
// 后续增加人员时，只需要在这里继续增加对象即可。
// 不需要修改下面的页面结构。
// =====================================================

const people = [
  {
    name: '雪乡',
    position: '建设者',
    department: '凉宫数据',
    description:
      '负责凉宫数据整体建设、产品规划与互联网项目开发，持续探索技术与产品之间更自然的连接。',
  },
];
---

<Layout metadata={metadata}>
  <main class="team-page">

    <!-- =================================================
         顶部 Hero
    ================================================== -->

    <section class="team-hero">
      <div class="team-hero-inner">

        <h1>
          我们的团队
        </h1>

      </div>
    </section>


    <!-- =================================================
         人员介绍
    ================================================== -->

    <section class="team-section">
      <div class="team-container">

        <!-- =================================================
             人员列表
        ================================================== -->

        <div class="team-list">

          {
            people.map((person, index) => (
              <article
                class:list={[
                  'team-person',
                  index % 2 === 1 && 'team-person-reverse',
                ]}
              >

                <!-- 人物信息 -->

                <div class="team-info">

                  <div class="team-number">
                    {String(index + 1).padStart(2, '0')}
                  </div>

                  <div class="team-info-line"></div>

                  <div class="team-department">
                    {person.department}
                  </div>

                  <h3>
                    {person.name}
                  </h3>

                  <div class="team-position">
                    {person.position}
                  </div>

                  <p>
                    {person.description}
                  </p>

                </div>

              </article>
            ))
          }

        </div>

      </div>
    </section>

  </main>
</Layout>


<style>
  /* =========================================================
     页面基础
  ========================================================= */

  .team-page {
    min-height: 100vh;
    background: #fff;
    color: #111;
  }


  /* =========================================================
     顶部 Hero
  ========================================================= */

  .team-hero {
    position: relative;
    overflow: hidden;

    padding:
      150px
      24px
      55px;

    background:
      linear-gradient(
        180deg,
        #f5f5f7 0%,
        #ffffff 100%
      );
  }


  .team-hero-inner {
    width: min(1200px, 100%);
    margin: 0 auto;
  }


  .team-hero h1 {
    margin: 0;

    font-size: clamp(
      52px,
      8vw,
      96px
    );

    line-height: 0.98;

    font-weight: 700;

    letter-spacing: -0.055em;
  }


  /* =========================================================
     人员区域
  ========================================================= */

  .team-section {
    padding:
      55px
      24px
      150px;

    background: #fff;
  }


  .team-container {
    width: min(1200px, 100%);
    margin: 0 auto;
  }


  /* =========================================================
     人员布局
  ========================================================= */

  .team-list {
    display: flex;

    flex-direction: column;

    gap: 160px;
  }


  .team-person {
    display: block;

    width: 100%;
  }


  /* =========================================================
     人物信息
  ========================================================= */

  .team-info {
    max-width: 650px;
  }


  .team-number {
    margin-bottom: 24px;

    font-size: 14px;

    font-weight: 600;

    color: #86868b;

    letter-spacing: 0.08em;
  }


  .team-info-line {
    width: 48px;
    height: 2px;

    margin-bottom: 32px;

    background: #0071e3;
  }


  .team-department {
    margin-bottom: 12px;

    font-size: 16px;

    font-weight: 600;

    color: #0071e3;
  }


  .team-info h3 {
    margin: 0;

    font-size: clamp(
      42px,
      5vw,
      64px
    );

    line-height: 1;

    letter-spacing: -0.045em;

    font-weight: 700;
  }


  .team-position {
    margin-top: 18px;

    font-size: 22px;

    font-weight: 500;

    color: #6e6e73;
  }


  .team-info p {
    margin-top: 32px;

    font-size: 18px;

    line-height: 1.8;

    color: #6e6e73;
  }


  /* =========================================================
     手机
  ========================================================= */

  @media (max-width: 767px) {

    .team-hero {
      padding:
        105px
        22px
        40px;
    }


    .team-hero h1 {
      font-size: clamp(
        48px,
        14vw,
        70px
      );
    }


    .team-section {
      padding:
        40px
        22px
        100px;
    }


    .team-list {
      gap: 90px;
    }


    .team-info h3 {
      font-size: 48px;
    }


    .team-position {
      font-size: 20px;
    }


    .team-info p {
      font-size: 17px;

      line-height: 1.75;
    }

  }


  /* =========================================================
     减少动态效果
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .team-page {
      scroll-behavior: auto;
    }

  }
</style>