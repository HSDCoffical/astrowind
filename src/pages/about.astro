---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于我们',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="——凉宫技术——"
    image={{
      src: '/06.png',
      alt: '凉宫数据',
    }}
  >
    <Fragment slot="title">
      凉宫数据 <br />
    </Fragment>

    <Fragment slot="subtitle">
      -凉宫数据，一家创新型互联网企业
      -我们秉持着以民为本作为我们的核心
      -同时，也欢迎各位的访问和支持
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="我们的数据中心"
    stats={[
      { title: '国家', amount: '3' },
      { title: '技术提供', amount: '5' },
      { title: '技术支持', amount: '1' },
      { title: '人员建设', amount: '1' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="开放平台"
    subtitle="科兴·高新"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: '企业行政管理员',
        description:
          '领导企业',
        icon: 'tabler:template',
      },
      {
        title: '项目管理员',
        description:
          '负责项目',
        icon: 'tabler:template',
      },
      {
        title: '安全管理员',
        description:
          '维护数据安全',
        icon: 'tabler:template',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: '区域管理员',
        description:
          '负责管理自己的区域',
        icon: 'tabler:template',
      },
      {
        title: '组长',
        description:
          '管理本组成员',
        icon: 'tabler:template',
      },
      {
        title: '新媒体编辑',
        description:
          '媒体流平台技术提供',
        icon: 'tabler:template',
      },
      {
        title: '成员',
        description:
          '企业主要板块',
        icon: 'tabler:template',
      },
      {
        title: '行政管理员',
        description:
          '管理行政部门',
        icon: 'tabler:template',
      },
      {
        title: '勤务',
        description:
          '文件/资料整理',
        icon: 'tabler:template',
      },
    ]}
    image={{
      src: '/07.png',
      alt: '凉宫数据',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="我们的流媒体平台"
    subtitle="短视频平台"
    items={[
      {
        title: '抖音',
        description:
          '建设',
      },
      {
        title: '快手',
        description:
          '建设',
      },
      {
        title: 'BillBill',
        description:
          '建设',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="更多"
    subtitle="凉宫技术支持"
    isReversed={true}
    callToAction={{
      text: '首页',
      href: '/',
    }}
    items={[
      {
        title: '技术端',
        description: 'Phone/Computer',
        icon: 'tabler:globe',
      },
      {
        title: '服务端',
        description:
          'Linux',
        icon: 'tabler:message-star',
      },
      {
        title: '架构',
        description:
          '托管型',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Ai同镜"
    tagline="——我们——"
    columns={4}
    items={[
      {
        title: 'DeepSeek',
        description: 'https://www.deepseek.com/',
      },
      {
        title: '豆包',
        description: 'https://www.doubao.com/chat/',
      },
      {
        title: '通义',
        description: 'https://tongyi.aliyun.com/',
      },
      {
        title: 'Gemini',
        description: 'https://gemini.google.com/app',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="互联网"
    tagline="联系我们"
    columns={2}
    items={[
      {
        title: '在线聊天',
        description:
          '正在建设',
        icon: 'tabler:messages',
      },
      {
        title: '邮件传递',
        description:
          '通过首页获取邮件地址',
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- ===== 修复 Hero 背景拦截滚轮 ===== -->
  <script>
    (function() {
      function fixHeroScroll() {
        const hero = document.querySelector('[class*="Hero"]');
        if (!hero) return;
        
        // 让所有背景层不拦截鼠标事件
        const bgLayers = hero.querySelectorAll('.absolute.inset-0, [class*="absolute"][class*="inset-0"]');
        bgLayers.forEach(el => {
          el.style.pointerEvents = 'none';
        });
        
        // 确保按钮和链接可点击
        const content = hero.querySelectorAll('a, button, [role="button"]');
        content.forEach(el => {
          el.style.pointerEvents = 'auto';
        });
        
        console.log('✅ 关于我们 Hero 背景已修复，滚轮可穿透');
      }
      
      if (document.readyState === 'complete') {
        fixHeroScroll();
      } else {
        window.addEventListener('load', fixHeroScroll);
      }
      
      document.addEventListener('astro:after-swap', function() {
        setTimeout(fixHeroScroll, 100);
      });
    })();
  </script>
</Layout>