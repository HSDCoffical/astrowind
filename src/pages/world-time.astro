---
import Layout from '~/layouts/PageLayout.astro';
---
<Layout title="世界时间 - 通信中心">
  <section class="mx-auto max-w-6xl px-4 pt-28 pb-12">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-gray-800 mb-2">世界时间</h1>
      <p class="text-gray-500">多时区实时时钟与本地时差对比</p>
    </div>

    <!-- 搜索框 -->
    <div class="mb-8 max-w-md mx-auto">
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </span>
        <input type="text" id="search-input" placeholder="搜索国家或城市（如：美国、东京）..." class="w-full pl-10 pr-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm text-gray-700">
      </div>
    </div>

    <!-- 加载提示 (隐藏显示) -->
    <div id="status-msg" class="text-center text-gray-400 py-4 text-sm hidden">正在加载全球时区数据...</div>

    <!-- 时钟卡片容器 -->
    <div id="time-container" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <script>
    const container = document.getElementById('time-container');
    const statusMsg = document.getElementById('status-msg');
    const searchInput = document.getElementById('search-input');
    const localTz = Intl.DateTimeFormat().resolvedOptions().timeZone;

    let allCities = [];       
    let displayedCities = []; 
    const MAX_RESULTS = 30;   

    // 1. 本地兜底数据（如果所有云端接口都挂了，显示这些保证页面不空）
    const fallbackData = [
      { name: '北京', country_name: '中国', timezone: 'Asia/Shanghai' },
      { name: '东京', country_name: '日本', timezone: 'Asia/Tokyo' },
      { name: '纽约', country_name: '美国', timezone: 'America/New_York' },
      { name: '洛杉矶', country_name: '美国', timezone: 'America/Los_Angeles' },
      { name: '伦敦', country_name: '英国', timezone: 'Europe/London' },
      { name: '巴黎', country_name: '法国', timezone: 'Europe/Paris' },
      { name: '悉尼', country_name: '澳大利亚', timezone: 'Australia/Sydney' },
      { name: '迪拜', country_name: '阿联酋', timezone: 'Asia/Dubai' },
      { name: '莫斯科', country_name: '俄罗斯', timezone: 'Europe/Moscow' },
      { name: '墨西哥城', country_name: '墨西哥', timezone: 'America/Mexico_City' },
    ];

    // 2. 定义多个备用 CDN 节点 (降级策略)
    const CDN_NODES = [
      'https://jsd.cdn.zzko.cn/npm/geo-data-api@1.0.3/dist/api/v1',
      'https://cdn.jsdmirror.com/npm/geo-data-api@1.0.3/dist/api/v1',
      'https://cdn.jsdelivr.net/npm/geo-data-api@1.0.3/dist/api/v1'
    ];

    // 3. 数据加载函数 (带自动重试和降级)
    async function loadCityData() {
      statusMsg.classList.remove('hidden');
      
      for (let i = 0; i < CDN_NODES.length; i++) {
        try {
          const url = `${CDN_NODES[i]}/search/cities.json`;
          const res = await fetch(url, { signal: AbortSignal.timeout(5000) }); // 5秒超时
          if (!res.ok) throw new Error('Network response was not ok');
          
          const json = await res.json();
          allCities = json.data || [];
          
          if (allCities.length > 0) {
            statusMsg.classList.add('hidden');
            initRender();
            return; // 成功获取则退出循环
          }
        } catch (err) {
          console.warn(`CDN 节点 ${i + 1} 加载失败，尝试下一个...`);
        }
      }

      // 如果所有 CDN 都失败，使用本地兜底数据
      console.warn('所有云端节点加载失败，切换至本地兜底数据');
      allCities = fallbackData;
      statusMsg.classList.add('hidden');
      initRender();
    }

    // 4. 初始化渲染
    function initRender() {
      // 如果数据里没有中文，我们做一些简单的英文到中文的映射增强搜索
      const defaults = ['北京', '东京', '纽约', '伦敦', 'Beijing', 'Tokyo', 'New York', 'London'];
      let defaultList = allCities.filter(c => defaults.includes(c.name));
      
      // 如果匹配不到，就取前 8 个
      if (defaultList.length === 0) {
        defaultList = allCities.slice(0, 8);
      }
      
      renderCards(defaultList);
    }

    // 5. 渲染卡片
    function renderCards(cityList) {
      displayedCities = cityList;
      container.innerHTML = '';

      if (cityList.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center text-gray-400 py-10">未找到相关地区</div>`;
        return;
      }

      cityList.forEach((city, index) => {
        if (!city.timezone) return;

        const id = `city-${index}`;
        // 兼容不同数据源的字段名
        const displayName = city.name || city.city || '未知';
        const countryName = city.country_name || city.country || '';
        
        // 如果名称是纯英文，可以尝试美化一下展示
        let subtitle = `${countryName ? countryName + ' · ' : ''}${city.timezone}`;

        container.innerHTML += `
          <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h2 class="text-xl font-bold text-gray-800">${displayName}</h2>
                <p class="text-xs text-gray-400 mt-1">${subtitle}</p>
              </div>
              <span class="bg-gray-100 text-gray-600 text-xs font-bold px-2 py-1 rounded" id="utc-label-${id}">--</span>
            </div>
            <p id="time-${id}" class="text-4xl font-mono font-bold text-gray-800 tracking-widest mb-3">--:--:--</p>
            <div class="border-t border-gray-100 pt-3">
              <p id="diff-${id}" class="text-sm text-gray-500 font-medium">计算时差中...</p>
            </div>
          </div>
        `;

        const timeEl = document.getElementById(`time-${id}`);
        if (timeEl) {
          timeEl.dataset.tz = city.timezone;
        }
      });

      updateAllTimes();
    }

    // 6. 实时更新所有可见卡片的时间
    function updateAllTimes() {
      const now = new Date();
      const localOffset = now.getTimezoneOffset() * -1; 

      displayedCities.forEach((city, index) => {
        if (!city.timezone) return;
        const id = `city-${index}`;

        const timeEl = document.getElementById(`time-${id}`);
        const diffEl = document.getElementById(`diff-${id}`);
        const utcLabel = document.getElementById(`utc-label-${id}`);
        if (!timeEl || !diffEl) return;

        try {
          const timeFormatter = new Intl.DateTimeFormat('zh-CN', {
            timeZone: city.timezone,
            hour12: false,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
          });
          timeEl.innerText = timeFormatter.format(now);

          const parts = new Intl.DateTimeFormat('en-US', {
            timeZone: city.timezone,
            timeZoneName: 'longOffset'
          }).formatToParts(now);
          
          const offsetStr = parts.find(p => p.type === 'timeZoneName')?.value || 'GMT';
          
          if (utcLabel) {
            utcLabel.innerText = offsetStr.replace('GMT', 'UTC').replace(':00', '');
          }

          const match = offsetStr.match(/GMT([+-])(\d{2}):(\d{2})/);
          if (match) {
            const sign = match[1] === '+' ? 1 : -1;
            const targetOffset = sign * (parseInt(match[2]) * 60 + parseInt(match[3]));
            const diffMins = targetOffset - localOffset;

            if (diffMins === 0) {
              diffEl.innerText = '与本地时间一致';
            } else {
              const hours = Math.floor(Math.abs(diffMins) / 60);
              const mins = Math.abs(diffMins) % 60;
              diffEl.innerText = `比本地${diffMins > 0 ? '快' : '慢'} ${hours} 小时${mins > 0 ? ` ${mins} 分钟` : ''}`;
            }
          }
        } catch (e) {
          timeEl.innerText = '时区错误';
        }
      });
    }

    // 7. 增强版搜索逻辑 (支持中英文模糊匹配)
    searchInput.addEventListener('input', (e) => {
      const kw = e.target.value.trim().toLowerCase();
      if (!kw) {
        initRender();
        return;
      }

      // 常见中文到英文的映射（因为有的云端数据库只有英文）
      const aliasMap = {
        '美国': ['united states', 'usa', 'america'],
        '中国': ['china'],
        '日本': ['japan'],
        '英国': ['united kingdom', 'uk', 'britain'],
        '法国': ['france'],
        '德国': ['germany'],
        '俄罗斯': ['russia'],
        '澳大利亚': ['australia'],
        '加拿大': ['canada']
      };

      let searchKeywords = [kw];
      // 如果用户搜的是中文，把对应的英文也加进搜索词里
      Object.keys(aliasMap).forEach(zhKey => {
        if (zhKey.includes(kw) || kw.includes(zhKey)) {
          searchKeywords = searchKeywords.concat(aliasMap[zhKey]);
        }
      });

      const matches = allCities.filter(city => {
        const name = (city.name || city.city || '').toLowerCase();
        const country = (city.country_name || city.country || '').toLowerCase();
        
        return searchKeywords.some(keyword => 
          name.includes(keyword) || country.includes(keyword)
        );
      }).slice(0, MAX_RESULTS);

      renderCards(matches);
    });

    // 启动
    loadCityData();
    setInterval(updateAllTimes, 1000);
  </script>
</Layout>