      { name: '吉隆坡', country: '马来西亚', tz: 'Asia/Kuala_Lumpur' },
      { name: '雅加达', country: '印尼', tz: 'Asia/Jakarta' },
      { name: '马尼拉', country: '菲律宾', tz: 'Asia/Manila' },
      { name: '河内', country: '越南', tz: 'Asia/Ho_Chi_Minh' },
      { name: '新德里', country: '印度', tz: 'Asia/Kolkata' },
      { name: '孟买', country: '印度', tz: 'Asia/Kolkata' },
      { name: '迪拜', country: '阿联酋', tz: 'Asia/Dubai' },
      { name: '阿布扎比', country: '阿联酋', tz: 'Asia/Dubai' },
      { name: '利雅得', country: '沙特', tz: 'Asia/Riyadh' },
      { name: '特拉维夫', country: '以色列', tz: 'Asia/Jerusalem' },
      { name: '德黑兰', country: '伊朗', tz: 'Asia/Tehran' },
      { name: '卡拉奇', country: '巴基斯坦', tz: 'Asia/Karachi' },
      { name: '达卡', country: '孟加拉国', tz: 'Asia/Dhaka' },
      { name: '加德满都', country: '尼泊尔', tz: 'Asia/Kathmandu' },
      
      // 欧洲 (Europe)
      { name: '伦敦', country: '英国', tz: 'Europe/London' },
      { name: '巴黎', country: '法国', tz: 'Europe/Paris' },
      { name: '柏林', country: '德国', tz: 'Europe/Berlin' },
      { name: '慕尼黑', country: '德国', tz: 'Europe/Berlin' },
      { name: '罗马', country: '意大利', tz: 'Europe/Rome' },
      { name: '马德里', country: '西班牙', tz: 'Europe/Madrid' },
      { name: '巴塞罗那', country: '西班牙', tz: 'Europe/Madrid' },
      { name: '阿姆斯特丹', country: '荷兰', tz: 'Europe/Amsterdam' },
      { name: '布鲁塞尔', country: '比利时', tz: 'Europe/Brussels' },
      { name: '苏黎世', country: '瑞士', tz: 'Europe/Zurich' },
      { name: '维也纳', country: '奥地利', tz: 'Europe/Vienna' },
      { name: '斯德哥尔摩', country: '瑞典', tz: 'Europe/Stockholm' },
      { name: '奥斯陆', country: '挪威', tz: 'Europe/Oslo' },
      { name: '哥本哈根', country: '丹麦', tz: 'Europe/Copenhagen' },
      { name: '赫尔辛基', country: '芬兰', tz: 'Europe/Helsinki' },
      { name: '莫斯科', country: '俄罗斯', tz: 'Europe/Moscow' },
      { name: '基辅', country: '乌克兰', tz: 'Europe/Kyiv' },
      { name: '华沙', country: '波兰', tz: 'Europe/Warsaw' },
      { name: '布拉格', country: '捷克', tz: 'Europe/Prague' },
      { name: '雅典', country: '希腊', tz: 'Europe/Athens' },
      { name: '伊斯坦布尔', country: '土耳其', tz: 'Europe/Istanbul' },
      { name: '里斯本', country: '葡萄牙', tz: 'Europe/Lisbon' },
      { name: '都柏林', country: '爱尔兰', tz: 'Europe/Dublin' },

      // 北美洲 (North America)
      { name: '纽约', country: '美国', tz: 'America/New_York' },
      { name: '华盛顿', country: '美国', tz: 'America/New_York' },
      { name: '波士顿', country: '美国', tz: 'America/New_York' },
      { name: '迈阿密', country: '美国', tz: 'America/New_York' },
      { name: '芝加哥', country: '美国', tz: 'America/Chicago' },
      { name: '休斯顿', country: '美国', tz: 'America/Chicago' },
      { name: '达拉斯', country: '美国', tz: 'America/Chicago' },
      { name: '丹佛', country: '美国', tz: 'America/Denver' },
      { name: '凤凰城', country: '美国', tz: 'America/Phoenix' },
      { name: '洛杉矶', country: '美国', tz: 'America/Los_Angeles' },
      { name: '旧金山', country: '美国', tz: 'America/Los_Angeles' },
      { name: '西雅图', country: '美国', tz: 'America/Los_Angeles' },
      { name: '拉斯维加斯', country: '美国', tz: 'America/Los_Angeles' },
      { name: '多伦多', country: '加拿大', tz: 'America/Toronto' },
      { name: '温哥华', country: '加拿大', tz: 'America/Vancouver' },
      { name: '蒙特利尔', country: '加拿大', tz: 'America/Toronto' },
      { name: '墨西哥城', country: '墨西哥', tz: 'America/Mexico_City' },
      { name: '哈瓦那', country: '古巴', tz: 'America/Havana' },
      { name: '巴拿马城', country: '巴拿马', tz: 'America/Panama' },

      // 南美洲 (South America)
      { name: '圣保罗', country: '巴西', tz: 'America/Sao_Paulo' },
      { name: '里约热内卢', country: '巴西', tz: 'America/Sao_Paulo' },
      { name: '布宜诺斯艾利斯', country: '阿根廷', tz: 'America/Argentina/Buenos_Aires' },
      { name: '圣地亚哥', country: '智利', tz: 'America/Santiago' },
      { name: '利马', country: '秘鲁', tz: 'America/Lima' },
      { name: '波哥大', country: '哥伦比亚', tz: 'America/Bogota' },
      { name: '加拉加斯', country: '委内瑞拉', tz: 'America/Caracas' },

      // 大洋洲 (Oceania)
      { name: '悉尼', country: '澳大利亚', tz: 'Australia/Sydney' },
      { name: '墨尔本', country: '澳大利亚', tz: 'Australia/Melbourne' },
      { name: '布里斯班', country: '澳大利亚', tz: 'Australia/Brisbane' },
      { name: '珀斯', country: '澳大利亚', tz: 'Australia/Perth' },
      { name: '阿德莱德', country: '澳大利亚', tz: 'Australia/Adelaide' },
      { name: '奥克兰', country: '新西兰', tz: 'Pacific/Auckland' },
      { name: '惠灵顿', country: '新西兰', tz: 'Pacific/Auckland' },
      { name: '斐济', country: '斐济', tz: 'Pacific/Fiji' },

      // 非洲 (Africa)
      { name: '开罗', country: '埃及', tz: 'Africa/Cairo' },
      { name: '约翰内斯堡', country: '南非', tz: 'Africa/Johannesburg' },
      { name: '开普敦', country: '南非', tz: 'Africa/Johannesburg' },
      { name: '内罗毕', country: '肯尼亚', tz: 'Africa/Nairobi' },
      { name: '拉各斯', country: '尼日利亚', tz: 'Africa/Lagos' },
      { name: '卡萨布兰卡', country: '摩洛哥', tz: 'Africa/Casablanca' },
      { name: '阿尔及尔', country: '阿尔及利亚', tz: 'Africa/Algiers' },
      { name: '亚的斯亚贝巴', country: '埃塞俄比亚', tz: 'Africa/Addis_Ababa' },
    ];

    const container = document.getElementById('time-container');
    const searchInput = document.getElementById('search-input');
    let displayedCities = []; 

    // 2. 渲染卡片
    function renderCards(cityList) {
      displayedCities = cityList;
      container.innerHTML = '';

      if (cityList.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center text-gray-400 py-10">未找到相关地区</div>`;
        return;
      }

      cityList.forEach((city, index) => {
        const id = `city-${index}`;
        container.innerHTML += `
          <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h2 class="text-xl font-bold text-gray-800">${city.name}</h2>
                <p class="text-xs text-gray-400 mt-1">${city.country} · ${city.tz}</p>
              </div>
              <span class="bg-gray-100 text-gray-600 text-xs font-bold px-2 py-1 rounded" id="utc-label-${id}">--</span>
            </div>
            <p id="time-${id}" class="text-4xl font-mono font-bold text-gray-800 tracking-widest mb-3">--:--:--</p>
            <div class="border-t border-gray-100 pt-3">
              <!-- 调整了这里的字体样式，给长文本留出空间 -->
              <p id="diff-${id}" class="text-xs text-gray-500 font-medium leading-relaxed">计算时差中...</p>
            </div>
          </div>
        `;
      });

      updateAllTimes();
    }

    // 3. 实时更新并计算精确到秒的时差
    function updateAllTimes() {
      const now = new Date();
      
      displayedCities.forEach((city, index) => {
        const id = `city-${index}`;
        const timeEl = document.getElementById(`time-${id}`);
        const diffEl = document.getElementById(`diff-${id}`);
        const utcLabel = document.getElementById(`utc-label-${id}`);
        if (!timeEl || !diffEl) return;

        try {
          // 格式化时间
          const timeFormatter = new Intl.DateTimeFormat('zh-CN', {
            timeZone: city.tz, hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit'
          });
          timeEl.innerText = timeFormatter.format(now);

          // 获取 UTC 标签
          const parts = new Intl.DateTimeFormat('en-US', {
            timeZone: city.tz, timeZoneName: 'longOffset'
          }).formatToParts(now);
          const offsetStr = parts.find(p => p.type === 'timeZoneName')?.value || 'GMT';
          
          if (utcLabel) {
            utcLabel.innerText = offsetStr.replace('GMT', 'UTC').replace(':00', '');
          }

          // ====== 高精度秒级时差计算 ======
          // 提取目标时区的年月日时分秒
          const targetParts = new Intl.DateTimeFormat('en-US', {
            timeZone: city.tz,
            year: 'numeric', month: 'numeric', day: 'numeric',
            hour: 'numeric', minute: 'numeric', second: 'numeric',
            hour12: false
          }).formatToParts(now);

          const getVal = (type) => parseInt(targetParts.find(p => p.type === type).value, 10);
          
          const targetDate = new Date(
            getVal('year'), getVal('month') - 1, getVal('day'),
            getVal('hour'), getVal('minute'), getVal('second')
          );
          
          // 将两个时间转化为绝对毫秒数
          const localMs = new Date(
            now.getFullYear(), now.getMonth(), now.getDate(),
            now.getHours(), now.getMinutes(), now.getSeconds()
          ).getTime();
          
          const targetMs = targetDate.getTime();
          let diffMs = targetMs - localMs;

          // 处理跨天导致的毫秒差异（因为去掉了日期只对比时分秒）
          if (diffMs > 12 * 60 * 60 * 1000) diffMs -= 24 * 60 * 60 * 1000;
          if (diffMs < -12 * 60 * 60 * 1000) diffMs += 24 * 60 * 60 * 1000;

          if (diffMs === 0) {
            diffEl.innerText = '与当前地区时间一致';
            diffEl.className = 'text-xs text-gray-500 font-medium leading-relaxed';
          } else {
            const isAhead = diffMs > 0;
            const absMs = Math.abs(diffMs);
            
            const h = Math.floor(absMs / 3600000);
            const m = Math.floor((absMs % 3600000) / 60000);
            const s = Math.floor((absMs % 60000) / 1000);
            
            let timeStr = '';
            if (h > 0) timeStr += `${h} 小时 `;
            if (m > 0) timeStr += `${m} 分钟 `;
            if (s > 0 || timeStr === '') timeStr += `${s} 秒`;

            diffEl.innerText = `比当前地区${isAhead ? '提前' : '晚'} ${timeStr.trim()}`;
            
            // 加一点颜色区分
            diffEl.className = isAhead 
              ? 'text-xs text-orange-500 font-medium leading-relaxed'
              : 'text-xs text-blue-500 font-medium leading-relaxed';
          }
        } catch (e) {
          timeEl.innerText = '解析错误';
          diffEl.innerText = '';
        }
      });
    }

    // 4. 搜索过滤
    searchInput.addEventListener('input', (e) => {
      const kw = e.target.value.trim().toLowerCase();
      if (!kw) {
        renderCards(allCities.slice(0, 12)); // 默认展示前12个热门
        return;
      }

      const matches = allCities.filter(city => {
        return city.name.toLowerCase().includes(kw) || 
               city.country.toLowerCase().includes(kw) ||
               city.tz.toLowerCase().includes(kw);
      });

      renderCards(matches);
    });

    // 初始化
    renderCards(allCities.slice(0, 12));
    setInterval(updateAllTimes, 1000);
  </script>
</Layout>