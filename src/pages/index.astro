---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '凉宫数据',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <div class="pt-4 md:pt-8">
    <Hero
      actions={[
        {
          variant: 'primary',
          text: '联系我们',
          href: '/contact',
          icon: 'tabler:download',
        },
        {
          text: '了解更多',
          href: '#features',
          style: 'background-color: white !important; color: black !important; border: 1px solid #d1d5db !important; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05) !important; font-weight: 600 !important;',
        }
      ]}
      image={{ src: '/new.png', alt: '凉宫数据 ' }}
      bgImage={true}
      bgOpacity={30}
    >
      <Fragment slot="title">
        <span id="hero-greeting">凉宫数据欢迎您！</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="hidden sm:inline">
          凉宫数据提供
        </span>
        <span class="block mb-1 sm:hidden font-bold text-blue-600">
          凉宫数据office提供
        </span>
        创新型互联网企业
      </Fragment>
    </Hero>
  </div>

  <!-- 中间 Widget 保持不变（省略，实际完整） -->
  <Note title="我们的理念" description="创新·高新" />
  <!-- ... 所有中间内容 ... -->

  <!-- ===== 邮箱地址 ===== -->
  <section class="px-6 sm:px-6 py-8 sm:py-12 pb-24 sm:pb-28 mx-auto max-w-4xl text-center">
    <div class="bg-gray-50 dark:bg-gray-800/50 rounded-2xl p-6 sm:p-8 border border-gray-200 dark:border-gray-700">
      <p class="text-gray-600 dark:text-gray-300 text-sm mb-3">联系我们</p>
      <a
        href="电子邮件地址"
        class="text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400 hover:underline hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
      >
        电子邮箱地址
      </a>
      <p class="text-gray-400 dark:text-gray-500 text-xs mt-3">
        xuexiang@lianggongoffice.dpdns.org
      </p>
    </div>
  </section>

  <!-- ===== 底部固定搜索框（手机端纯色背景，桌面端毛玻璃） ===== -->
  <div 
    class="fixed bottom-4 left-0 right-0 z-50 px-4"
    style="overscroll-behavior: none; overflow-anchor: none; touch-action: pan-y; pointer-events: none; will-change: transform; transform: translateZ(0);"
  >
    <div class="max-w-2xl mx-auto pointer-events-auto">
      <form id="search-form" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
        <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
        <input
          id="search-input"
          type="text"
          name="q"
          placeholder="搜索本站内容..."
          class="w-full py-3 px-6 pl-12 bg-white/90 md:bg-white/20 border border-gray-300 md:border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg md:backdrop-blur-lg"
        />
        <button
          id="search-toggle"
          type="button"
          class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700 transition-colors"
          aria-label="聚焦搜索框"
        >
          <svg id="search-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <button
          id="mode-toggle"
          type="button"
          class="absolute right-4 top-1/2 transform -translate-y-1/2 text-xs text-gray-500 bg-white/30 backdrop-blur-sm px-2 py-1 rounded-full cursor-pointer hover:bg-white/50 transition-colors"
        >
          <span id="mode-label">站外</span>
        </button>
      </form>
      <div id="search-results-container" class="mt-2 bg-white/20 backdrop-blur-lg border border-white/30 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
    </div>
  </div>

  <!-- ===== 搜索框脚本 ===== -->
  <script>
    function initSearch() {
      const form = document.getElementById('search-form');
      const input = document.getElementById('search-input');
      const toggleBtn = document.getElementById('search-toggle');
      const modeToggle = document.getElementById('mode-toggle');
      const modeLabel = document.getElementById('mode-label');
      const searchIcon = document.getElementById('search-icon');
      const resultsContainer = document.getElementById('search-results-container');

      if (!form || !input) return;

      let mode = 'external';
      let searchData = null;

      async function loadSearchData() {
        try {
          const resp = await fetch('/search.json');
          if (resp.ok) {
            searchData = await resp.json();
            console.log('✅ 搜索索引已加载:', searchData.length, '个页面');
          } else {
            console.warn('⚠️ 搜索索引加载失败，状态码:', resp.status);
          }
        } catch (e) {
          console.warn('⚠️ 搜索索引加载失败:', e);
        }
      }

      function searchInternal(query) {
        if (!searchData || !query.trim()) return [];
        const q = query.toLowerCase().trim();
        if (!q) return [];
        return searchData
          .filter(page => {
            const title = page.title.toLowerCase();
            const desc = page.description.toLowerCase();
            const content = page.content.toLowerCase();
            return title.includes(q) || desc.includes(q) || content.includes(q);
          })
          .slice(0, 10);
      }

      function showInternalResults(results) {
        resultsContainer.innerHTML = '';
        if (results.length === 0) {
          resultsContainer.classList.add('hidden');
          return;
        }
        let html = '';
        for (const page of results) {
          html += `
            <a href="${page.url}" class="block px-4 py-2 hover:bg-white/20 transition-colors border-b border-white/10 last:border-0">
              <div class="font-medium text-gray-800">${page.title}</div>
              <div class="text-sm text-gray-600 truncate">${page.description}</div>
            </a>
          `;
        }
        resultsContainer.innerHTML = html;
        resultsContainer.classList.remove('hidden');
      }

      function clearResults() {
        resultsContainer.innerHTML = '';
        resultsContainer.classList.add('hidden');
      }

      function updateMode(newMode) {
        mode = newMode;
        clearResults();

        if (mode === 'external') {
          form.action = 'https://www.bing.com/search';
          form.target = '_blank';
          let hiddenInput = form.querySelector('input[name="q1"]');
          if (!hiddenInput) {
            hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'q1';
            form.appendChild(hiddenInput);
          }
          hiddenInput.value = 'site:hsdc.dpdns.org';
          input.name = 'q';
          input.disabled = false;
          input.placeholder = '输入关键字以联网检索';
          input.className = 'w-full py-3 px-6 pl-12 bg-white/90 md:bg-white/20 border border-gray-300 md:border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg md:backdrop-blur-lg';
          modeLabel.textContent = '必应搜索';
          searchIcon.setAttribute('d', 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z');
        } else {
          form.action = '#';
          form.target = '';
          const hiddenInput = form.querySelector('input[name="q1"]');
          if (hiddenInput) hiddenInput.remove();
          input.name = '';
          input.disabled = false;
          input.placeholder = '输入关键词检索本站';
          input.className = 'w-full py-3 px-6 pl-12 bg-white/90 md:bg-white/20 border border-gray-300 md:border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg md:backdrop-blur-lg';
          modeLabel.textContent = '站内检索';
          searchIcon.setAttribute('d', 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z');
          if (input.value.trim()) {
            const results = searchInternal(input.value);
            showInternalResults(results);
          }
        }
        input.focus();
      }

      input.oninput = function() {
        if (mode === 'internal') {
          const query = this.value.trim();
          if (!query) {
            clearResults();
            return;
          }
          const results = searchInternal(query);
          showInternalResults(results);
        } else {
          clearResults();
        }
      };

      modeToggle.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        const newMode = mode === 'external' ? 'internal' : 'external';
        updateMode(newMode);
      };

      toggleBtn.onclick = function(e) {
        e.preventDefault();
        input.focus();
      };

      document.addEventListener('click', function(e) {
        const searchArea = document.querySelector('.fixed.bottom-4');
        if (searchArea && !searchArea.contains(e.target)) {
          clearResults();
        }
      });

      updateMode('external');
      loadSearchData();
    }

    initSearch();
    document.addEventListener('astro:after-swap', function() {
      setTimeout(initSearch, 50);
    });
  </script>

  <!-- ===== Hero 背景滚轮修复 ===== -->
  <script>
    (function() {
      function fixHeroScroll() {
        const hero = document.querySelector('[class*="Hero"]');
        if (!hero) return;
        const bgLayers = hero.querySelectorAll('.absolute.inset-0, [class*="absolute"][class*="inset-0"]');
        bgLayers.forEach(el => {
          el.style.pointerEvents = 'none';
        });
        const content = hero.querySelectorAll('a, button, [role="button"]');
        content.forEach(el => {
          el.style.pointerEvents = 'auto';
        });
        console.log('✅ Hero 背景已修复');
      }
      if (document.readyState === 'complete') {
        fixHeroScroll();
      } else {
        window.addEventListener('load', fixHeroScroll);
      }
      document.addEventListener('astro:after-swap', function() {
        setTimeout(fixHeroScroll, 100);
      });
    })();
  </script>

  <!-- ===== 用户名接收（Cookie 有效期 4 个月 = 10368000 秒） ===== -->
  <script>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const encodedUsername = urlParams.get('username');

      function getGreeting() {
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 9) return '早上好';
        if (hour >= 9 && hour < 12) return '上午好';
        if (hour >= 12 && hour < 14) return '中午好';
        if (hour >= 14 && hour < 18) return '下午好';
        if (hour >= 18 && hour < 21) return '傍晚好';
        return '晚上好';
      }

      function updateGreeting(username) {
        const el = document.getElementById('hero-greeting');
        if (el) {
          el.textContent = `${username}，${getGreeting()}`;
        }
      }

      function setUsername(username) {
        try {
          localStorage.setItem('username', username);
        } catch (e) {}
        document.cookie = `username=${encodeURIComponent(username)}; path=/; max-age=10368000`;
      }

      function getUsername() {
        try {
          const stored = localStorage.getItem('username');
          if (stored) return stored;
        } catch (e) {}
        const cookie = document.cookie.split('; ').find(row => row.startsWith('username='));
        if (cookie) return decodeURIComponent(cookie.split('=')[1]);
        return null;
      }

      if (encodedUsername) {
        try {
          const username = decodeURIComponent(encodedUsername);
          if (username) {
            setUsername(username);
            updateGreeting(username);
            window.history.replaceState({}, document.title, '/');
            console.log(`✅ 欢迎语已更新: ${username}，${getGreeting()}`);
          }
        } catch (e) {
          console.log('解码用户名失败:', e);
        }
      }

      const storedUsername = getUsername();
      if (storedUsername) {
        updateGreeting(storedUsername);
      }
    })();
  </script>

</Layout>