      },
      {
        title: '[3]: <span class="font-medium">专属编号</span>',
        description:
          '中心下发专属邮件地址，并下发独立的编号',
        icon: 'tabler:paint',
      },
      {
        title: '成功，欢迎您加入凉宫数据！',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '/04.png',
      alt: '凉宫数据',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="加入我们"
    subtitle="成为我们的一员，并和我们一起发展进步"
    tagline="——团队协作——"
    items={[
      {
        title: '团队协作',
        description: "多团队协作需要每个成员之间相互理解包容，在每一次协作时不断磨合，最终达成高效的协作能力",
        icon: 'flat-color-icons:template',
      },
      {
        title: '团队建设',
        description:
          "在一个大集体中，不存在高低之分，所有人都是一份子，从凉宫数据诞生之日起[公平]便是刻进企业骨子里的原则",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: '团队意识',
        description:
          '抛弃传统的硬磨合，每一位成员都应该有自己的主见，无论是谁，都应该需要了解每一位员工的意见',
        icon: 'flat-color-icons:approval',
      },
      {
        title: '团队整体',
        description:
          "在大型表决会议中，每一位员工都应该表达自己的主见，不以职位高低评价一个人，不以富贵贫穷区分等级",
        icon: 'flat-color-icons:document',
      },
      {
        title: '团队专业',
        description:
          '作为一个合作性大集体，新员工都会由老员工带领，加入我们这个团体不会视而不见，每一位员工都值得被尊敬',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: '团队意识',
        description: '团队意识秉持着创立时的初衷[以民为本]，只有团队之间相互理解包容，才能在这条路上越走越远',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: '团队精神',
        description: '走好每一步，让每一位成员都走好每一步，不需要急促的发展，需要每一位员工的参与，团队在此刻才会彰显出意义',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: '团队协调',
        description:
          '团队中的每一位都是不可缺少的一份子，只有每一位参与，协调才会更加强大',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: '团队衷心',
        description: "有付出那么也会有收获",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="信息中心"
    information={`资讯/实时
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="更多事项"
    subtitle="凉宫数据相关问题"
    tagline="凉宫架构"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '我该如何辨认是不是企业发布?',
        description:
          "首先，发送申请后回执报告由xuexiang@lianggong.dpdns.org转发，如果源邮箱不对，请联系该邮箱获取帮助或视为冒充邮件",
      },
      {
        title: '没有经验可以加入吗?',
        description:
          '先说答案，可以，因为我们本身就是刚起步的小行业，只要愿意，欢迎您加入我们',
      },
      {
        title: '为什么有时网页加载很慢或报错?',
        description:
          "网页由Cloudflare托管，加载时间要按服务器响应时间来看，如果一直不行，请科学上网",
      },
      {
        title: "凉宫数据是干什么的?",
        description:
          "凉宫数据是一家创新型互联网企业，我们会在Ai，数字数据等高新技术方面进行发展",
      },
      {
        title: '为什么市面上没有凉宫数据?',
        description:
          "凉宫数据作为刚起步的小型企业，我们选择保守性，即等规模宏大了便注册实体资质",
      },
      {
        title: '它能带来什么?',
        description:
          "对于新手来说，它能让你了解到互联网行业，对于老手来说，温故而知新，对于管理来说，是一次自我锻炼的机会",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: '管理员', amount: '1名' },
      { title: '建设者', amount: '1名' },
      { title: '贡献者', amount: '1名' },
      { title: '企业人数', amount: '1名' },
    ]}
  />

  <CallToAction
  actions={[]}
>
</CallToAction>

<!-- ===== 直接显示邮箱地址 ===== -->
<section class="px-6 sm:px-6 py-8 sm:py-12 mx-auto max-w-4xl text-center">
  <div class="bg-gray-50 dark:bg-gray-800/50 rounded-2xl p-6 sm:p-8 border border-gray-200 dark:border-gray-700">
    <p class="text-gray-600 dark:text-gray-300 text-sm mb-3">联系我们</p>
    <a
      href="电子邮件地址"
      class="text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400 hover:underline hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
    >
      电子邮箱地址
    </a>
    <p class="text-gray-400 dark:text-gray-500 text-xs mt-3">
      xuexiang@lianggongoffice.dpdns.org
    </p>
  </div>
</section>

<!-- ===== 底部固定搜索框 ===== -->
<div class="fixed bottom-4 left-0 right-0 z-50 px-4">
  <div class="max-w-2xl mx-auto">
    <form id="search-form" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
      <!-- 站外搜索限定本站 -->
      <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
      <input
        id="search-input"
        type="text"
        name="q"
        placeholder="搜索本站内容..."
        class="w-full py-3 px-6 pl-12 bg-white/20 backdrop-blur-lg border border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg"
      />
      <!-- 放大镜图标：点击仅聚焦输入框（不再切换模式） -->
      <button
        id="search-toggle"
        type="button"
        class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700 transition-colors"
        aria-label="聚焦搜索框"
      >
        <svg id="search-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <!-- 模式切换按钮（右侧） -->
      <button
        id="mode-toggle"
        type="button"
        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-xs text-gray-500 bg-white/30 backdrop-blur-sm px-2 py-1 rounded-full cursor-pointer hover:bg-white/50 transition-colors"
      >
        <span id="mode-label">站外</span>
      </button>
    </form>
    <!-- 搜索结果容器（站内模式使用） -->
    <div id="search-results-container" class="mt-2 bg-white/20 backdrop-blur-lg border border-white/30 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
  </div>
</div>

<script>
  (function() {
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const toggleBtn = document.getElementById('search-toggle');
    const modeToggle = document.getElementById('mode-toggle');
    const modeLabel = document.getElementById('mode-label');
    const searchIcon = document.getElementById('search-icon');
    const resultsContainer = document.getElementById('search-results-container');

    let mode = 'external'; // 'external' 或 'internal'
    let searchData = null; // 缓存搜索索引

    // 加载搜索索引
    async function loadSearchData() {
      try {
        const resp = await fetch('/search.json');
        if (resp.ok) {
          searchData = await resp.json();
          console.log('✅ 搜索索引已加载:', searchData.length, '个页面');
        } else {
          console.warn('⚠️ 搜索索引加载失败，状态码:', resp.status);
        }
      } catch (e) {
        console.warn('⚠️ 搜索索引加载失败:', e);
      }
    }

    // 站内搜索
    function searchInternal(query) {
      if (!searchData || !query.trim()) return [];
      const q = query.toLowerCase().trim();
      if (!q) return [];
      
      return searchData
        .filter(page => {
          const title = page.title.toLowerCase();
          const desc = page.description.toLowerCase();
          const content = page.content.toLowerCase();
          return title.includes(q) || desc.includes(q) || content.includes(q);
        })
        .slice(0, 10);
    }

    // 显示站内搜索结果
    function showInternalResults(results) {
      resultsContainer.innerHTML = '';
      if (results.length === 0) {
        resultsContainer.classList.add('hidden');
        return;
      }

      let html = '';
      for (const page of results) {
        html += `
          <a href="${page.url}" class="block px-4 py-2 hover:bg-white/20 transition-colors border-b border-white/10 last:border-0">
            <div class="font-medium text-gray-800">${page.title}</div>
            <div class="text-sm text-gray-600 truncate">${page.description}</div>
          </a>
        `;
      }
      resultsContainer.innerHTML = html;
      resultsContainer.classList.remove('hidden');
    }

    function clearResults() {
      resultsContainer.innerHTML = '';
      resultsContainer.classList.add('hidden');
    }

    function updateMode(newMode) {
      mode = newMode;
      clearResults();

      if (mode === 'external') {
        // 站外模式
        form.action = 'https://www.bing.com/search';
        form.target = '_blank';
        let hiddenInput = form.querySelector('input[name="q1"]');
        if (!hiddenInput) {
          hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = 'q1';
          form.appendChild(hiddenInput);
        }
        hiddenInput.value = 'site:hsdc.dpdns.org';
        input.name = 'q';
        input.disabled = false;
        input.placeholder = '输入关键字继续';
        input.className = 'w-full py-3 px-6 pl-12 bg-white/20 backdrop-blur-lg border border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg';
        modeLabel.textContent = '必应搜索';
        searchIcon.setAttribute('d', 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z');
      } else {
        // 站内模式
        form.action = '#';
        form.target = '';
        const hiddenInput = form.querySelector('input[name="q1"]');
        if (hiddenInput) hiddenInput.remove();
        input.name = '';
        input.disabled = false;
        input.placeholder = '输入关键词以检索本站.';
        input.className = 'w-full py-3 px-6 pl-12 bg-white/20 backdrop-blur-lg border border-white/30 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none shadow-lg';
        modeLabel.textContent = '站内检索';
        searchIcon.setAttribute('d', 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z');
        // 如果已有输入，触发站内搜索
        if (input.value.trim()) {
          const results = searchInternal(input.value);
          showInternalResults(results);
        }
      }
      // 保持输入框焦点
      input.focus();
    }

    // 输入事件（站内模式实时搜索）
    input.addEventListener('input', function() {
      if (mode === 'internal') {
        const query = this.value.trim();
        if (!query) {
          clearResults();
          return;
        }
        const results = searchInternal(query);
        showInternalResults(results);
      } else {
        clearResults();
      }
    });

    // 点击其他地方清除结果
    document.addEventListener('click', function(e) {
      const searchArea = document.querySelector('.fixed.bottom-4');
      if (searchArea && !searchArea.contains(e.target)) {
        clearResults();
      }
    });

    // 点击右侧模式按钮切换
    modeToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const newMode = mode === 'external' ? 'internal' : 'external';
      updateMode(newMode);
    });

    // 点击放大镜仅聚焦输入框（不切换模式）
    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      input.focus();
    });

    // 初始化：站外模式，加载搜索索引
    updateMode('external');
    loadSearchData();
  })();
</script>

</Layout>