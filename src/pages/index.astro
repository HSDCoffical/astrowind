---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '凉宫数据',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 所有 Widget 内容完全保留（你的 Hero、Note、Features 等全部保留） -->
  <!-- ... 此处省略，请保留你原有的所有 Widget ... -->

  <!-- ===== 邮箱地址 ===== -->
  <section class="px-6 sm:px-6 py-8 sm:py-12 mx-auto max-w-4xl text-center">
    <div class="bg-gray-50 dark:bg-gray-800/50 rounded-2xl p-6 sm:p-8 border border-gray-200 dark:border-gray-700">
      <p class="text-gray-600 dark:text-gray-300 text-sm mb-3">联系我们</p>
      <a
        href="电子邮件地址"
        class="text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400 hover:underline hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
      >
        电子邮箱地址
      </a>
      <p class="text-gray-400 dark:text-gray-500 text-xs mt-3">
        xuexiang@lianggongoffice.dpdns.org
      </p>
    </div>
  </section>

  <!-- ===== 搜索框（普通流式布局，不固定，跟随页面滚动） ===== -->
  <section class="px-4 pb-8 max-w-2xl mx-auto">
    <div class="bg-white/20 backdrop-blur-lg border border-white/30 rounded-2xl p-4 shadow-lg">
      <form id="search-form" class="relative" action="https://www.bing.com/search" method="GET" target="_blank">
        <input type="hidden" name="q1" value="site:hsdc.dpdns.org">
        <input
          id="search-input"
          type="text"
          name="q"
          placeholder="搜索本站内容..."
          class="w-full py-3 px-6 pl-12 bg-white/30 border border-white/50 rounded-full text-gray-800 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
        <button
          id="search-toggle"
          type="button"
          class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-600 hover:text-gray-900 transition-colors"
          aria-label="聚焦搜索框"
        >
          <svg id="search-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <button
          id="mode-toggle"
          type="button"
          class="absolute right-4 top-1/2 transform -translate-y-1/2 text-xs text-gray-700 bg-white/40 backdrop-blur-sm px-2 py-1 rounded-full hover:bg-white/60 transition-colors"
        >
          <span id="mode-label">站外</span>
        </button>
      </form>
      <div id="search-results-container" class="mt-3 max-h-60 overflow-y-auto hidden bg-white/30 backdrop-blur-sm rounded-xl border border-white/30"></div>
    </div>
  </section>

  <script>
    (function() {
      const form = document.getElementById('search-form');
      const input = document.getElementById('search-input');
      const toggleBtn = document.getElementById('search-toggle');
      const modeToggle = document.getElementById('mode-toggle');
      const modeLabel = document.getElementById('mode-label');
      const searchIcon = document.getElementById('search-icon');
      const resultsContainer = document.getElementById('search-results-container');

      let mode = 'external';
      let searchData = null;

      async function loadSearchData() {
        try {
          const resp = await fetch('/search.json');
          if (resp.ok) {
            searchData = await resp.json();
            console.log('✅ 搜索索引已加载:', searchData.length);
          } else {
            console.warn('⚠️ 搜索索引加载失败');
          }
        } catch (e) {
          console.warn('⚠️ 搜索索引加载失败:', e);
        }
      }

      function searchInternal(query) {
        if (!searchData || !query.trim()) return [];
        const q = query.toLowerCase().trim();
        if (!q) return [];
        return searchData
          .filter(page => {
            const title = page.title.toLowerCase();
            const desc = page.description.toLowerCase();
            const content = page.content.toLowerCase();
            return title.includes(q) || desc.includes(q) || content.includes(q);
          })
          .slice(0, 10);
      }

      function showInternalResults(results) {
        resultsContainer.innerHTML = '';
        if (results.length === 0) {
          resultsContainer.classList.add('hidden');
          return;
        }
        let html = '';
        for (const page of results) {
          html += `
            <a href="${page.url}" class="block px-4 py-2 hover:bg-white/20 transition-colors border-b border-white/10 last:border-0">
              <div class="font-medium text-gray-800">${page.title}</div>
              <div class="text-sm text-gray-600 truncate">${page.description}</div>
            </a>
          `;
        }
        resultsContainer.innerHTML = html;
        resultsContainer.classList.remove('hidden');
      }

      function clearResults() {
        resultsContainer.innerHTML = '';
        resultsContainer.classList.add('hidden');
      }

      function updateMode(newMode) {
        mode = newMode;
        clearResults();
        if (mode === 'external') {
          form.action = 'https://www.bing.com/search';
          form.target = '_blank';
          let hidden = form.querySelector('input[name="q1"]');
          if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'q1';
            form.appendChild(hidden);
          }
          hidden.value = 'site:hsdc.dpdns.org';
          input.name = 'q';
          input.placeholder = '输入关键词以继续';
          modeLabel.textContent = '站外';
        } else {
          form.action = '#';
          form.target = '';
          const hidden = form.querySelector('input[name="q1"]');
          if (hidden) hidden.remove();
          input.name = '';
          input.placeholder = '输入关键词检索站内';
          modeLabel.textContent = '站内';
          if (input.value.trim()) {
            const results = searchInternal(input.value);
            showInternalResults(results);
          }
        }
        input.focus();
      }

      input.addEventListener('input', function() {
        if (mode === 'internal') {
          const query = this.value.trim();
          if (!query) { clearResults(); return; }
          const results = searchInternal(query);
          showInternalResults(results);
        } else {
          clearResults();
        }
      });

      document.addEventListener('click', function(e) {
        const container = document.querySelector('.max-w-2xl.mx-auto');
        if (container && !container.contains(e.target)) {
          clearResults();
        }
      });

      modeToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const newMode = mode === 'external' ? 'internal' : 'external';
        updateMode(newMode);
      });

      toggleBtn.addEventListener('click', function(e) {
        e.preventDefault();
        input.focus();
      });

      updateMode('external');
      loadSearchData();
    })();
  </script>
</Layout>