---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '凉宫数据',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  actions={[
    {
      variant: 'primary',
      text: '联系我们',
      href: '/contact',
      icon: 'tabler:download',
    },
    { text: '了解更多', href: '#features' },
  ]}
  image={{ src: '/new.png', alt: '凉宫数据 ' }}   <!-- 这里改成你的图片名 -->
bgImage={true}
bgOpacity={30}
>
  <Fragment slot="title">
     凉宫数据欢迎您！
  </Fragment>

  <Fragment slot="subtitle">
    <span class="hidden sm:inline">
      凉宫数据提供
    </span>
    <span class="block mb-1 sm:hidden font-bold text-blue-600">
      凉宫数据office提供
    </span>
    创新型互联网企业
  </Fragment>
</Hero>

  <!-- Note Widget ******************* -->

  <Note title="我们的理念" description="创新·高新" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="凉宫数据"
    title="新方向·新发展"
    items={[
      {
        title: '我们的理念',
        description:
          '创新，当代互联网高新技术产业已处于饱和状态，作为创新型企业，则必然需要开拓新型市场以及高新产业',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: '我们的发展',
        description:
          '我们于2026/4/17成立，届时，我们一共发布了三个中心，其中，凉宫数据中央行政中心为最高管理中心',
        icon: 'tabler:components',
      },
      {
        title: '我们的目标',
        description:
          '我们正在不断的发展，拓展各个互联网方向，在发展的同时也在不断提升自我，以达到看一步，走一步，稳一步的效果',
        icon: 'tabler:list-check',
      },
      {
        title: '我们的数据',
        description:
          '凉宫数据现采用Cloudflare作为防火墙，后续将逐步改善，提高用户的浏览效率',
        icon: 'tabler:rocket',
      },
      {
        title: '我们的Ai',
        description:
          "凉宫数据现已完成移动端Ai项目部署，完成了主流平台的聊天/分析等功能，现逐步完善到网页端",
        icon: 'tabler:arrows-right-left',
      },
      {
        title: '我们的人员',
        description:
          '凉宫数据现有一名中央行政员，同时也欢迎各位加入我们，我们将会不断开放更多福利',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="——数据板块——"
    title="凉宫数据数字安全化"
    items={[
      {
        title: '安全性',
        description:
          '数据采用端到端加密的方式，任何人不能获取到私人信息，并且定期有安全管理员进行安全核查',
      },
      {
        title: '时效性',
        description:
          '除验证码等具有时效性的数据，其他数据均有长期时效性，给用户提供更长时效性的数字化服务',
      },
      {
        title: '链接性',
        description:
          '所有的数据直接发送到云端数据库，避免二次转发，达到更高销量的数据高效化',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">新数据化</h3>
     多效化 
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '中国',
       '国内主要服务端，大部分云端服务由国内提供技术服务`,
      },
      {
        title: '美国',
        description:
          '防火墙提供商Cloudflare主干服务器位于美国，其安全性由该企业提供技术支持',
      },
      {
        title: '新加坡',
        description:
          "Ai服务端联网信息获取资源网站，由其提供的联网Api获取实时资讯",
      },
      {
        title: '未知',
        description:
          '待后续开放',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content">全球数据分布</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: '子企总行政管理员',
        description:
          '凉宫数据中央行政中心作为主导中心，旗下还有“凉宫数据数字发行中心”及“凉宫数据硬件发行中心”，两个子企业也需要领导人，带领企业逐步发展',
      },
      {
        title: '项目管理员',
        description:
          '负责中心下发的项目开发，完善等，带领团队高效的完成发布的项目，获取你的荣誉称号',
      },
      {
        title: '新媒体运营',
        description:
          '即管理公司对外媒体运营账号，包含短视频账号，资讯类平台等，同时也及时了解用户反馈及建议',
      },
      {
        title: '职员',
        description: `作为职员，只需要完成中心下发的信息即可，入职时，会发放你的专属邮箱地址，并在辞职时回收`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">加入我们</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="入职流程"
    items={[
      {
        title: '[1]: <span class="font-medium">Download</span>',
        description:
          "向中心发送入职申请，中心会在一周内通过原邮件地址返回报告",
        icon: 'tabler:package',
      },
      {
        title: '[2]: <span class="font-medium">Add content</span>',
        description:
          "审核通过后会附赠一个联系人，添加联系人，并咨询",
        icon: 'tabler:letter-case',
      },
      {
        title: '[3]: <span class="font-medium">Customize styles</span>',
        description:
          '中心下发专属邮件地址，并下发独立的编号',
        icon: 'tabler:paint',
      },
      {
        title: '成功，欢迎您加入凉宫数据！',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="加入我们"
    subtitle="成为我们的一员，并和我们一起发展进步"
    tagline="——团队协作——"
    items={[
      {
        title: '团队协作',
        description: "多团队协作需要每个成员之间相互理解包容，在每一次协作时不断磨合，最终达成高效的协作能力",
        icon: 'flat-color-icons:template',
      },
      {
        title: '团队建设',
        description:
          "在一个大集体中，不存在高低之分，所有人都是一份子，从凉宫数据诞生之日起[公平]便是刻进企业骨子里的原则",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: '团队意识',
        description:
          '抛弃传统的硬磨合，每一位成员都应该有自己的主见，无论是谁，都应该需要了解每一位员工的意见',
        icon: 'flat-color-icons:approval',
      },
      {
        title: '团队整体',
        description:
          "在大型表决会议中，每一位员工都应该表达自己的主见，不以职位高低评价一个人，不以富贵贫穷区分等级",
        icon: 'flat-color-icons:document',
      },
      {
        title: '团队专业',
        description:
          '作为一个合作性大集体，新员工都会由老员工带领，加入我们这个团体不会视而不见，每一位员工都值得被尊敬',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: '团队意识',
        description: '团队意识秉持着创立时的初衷[以民为本]，只有团队之间相互理解包容，才能在这条路上越走越远',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: '团队精神',
        description: '走好每一步，让每一位成员都走好每一步，不需要急促的发展，需要每一位员工的参与，团队在此刻才会彰显出意义',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: '团队协调',
        description:
          '团队中的每一位都是不可缺少的一份子，只有每一位参与，协调才会更加强大',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: '团队衷心',
        description: "有付出那么也会有收获",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro v6 + Tailwind CSS v4.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into the powerful features that AstroWind offers and how it can elevate your web development journey."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why AstroWind?',
        description:
          "Michael Knight a young loner on a crusade to champion the cause of the innocent. The helpless. The powerless in a world of criminals who operate above the law. Here he comes Here comes Speed Racer. He's a demon on wheels.",
      },
      {
        title: 'What do I need to start?',
        description:
          'Space, the final frontier. These are the voyages of the Starship Enterprise. Its five-year mission: to explore strange new worlds. Many say exploration is part of our destiny, but it’s actually our duty to future generations.',
      },
      {
        title: 'How to install the Astro + Tailwind CSS template?',
        description:
          "Well, the way they make shows is, they make one show. That show's called a pilot. Then they show that show to the people who make shows, and on the strength of that one show they decide if they're going to make more shows.",
      },
      {
        title: "What's something that you don't understand?",
        description:
          "A flower in my garden, a mystery in my panties. Heart attack never stopped old Big Bear. I didn't even know we were calling him Big Bear.",
      },
      {
        title: 'What is something that you would like to try again?',
        description:
          "A business big enough that it could be listed on the NASDAQ goes belly up. Disappears! It ceases to exist without me. No, you clearly don't know who you're talking to, so let me clue you in.",
      },
      {
        title: 'If you could only ask one question to each person you meet, what would that question be?',
        description:
          "This is not about revenge. This is about justice. A lot of things can change in twelve years, Admiral. Well, that's certainly good to know. About four years. I got tired of hearing how young I looked.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Downloads', amount: '132K' },
      { title: 'Stars', amount: '24.8K' },
      { title: 'Forks', amount: '10.3K' },
      { title: 'Users', amount: '48.4K' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Astro&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Tailwind CSS</span>
    </Fragment>

    <Fragment slot="subtitle">
      Be very surprised by these huge fake numbers you are seeing on this page. <br class="hidden md:inline" />Don't
      waste more time! :P
    </Fragment>
  </CallToAction>
</Layout>
