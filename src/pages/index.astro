---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '凉宫数据',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <div class="pt-4 md:pt-8">
    <Hero
      actions={[
        {
          variant: 'primary',
          text: '联系我们',
          href: '/contact',
          icon: 'tabler:download',
        },
        {
          text: '了解更多',
          href: '#features',
          style: 'background-color: white !important; color: black !important; border: 1px solid #d1d5db !important; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05) !important; font-weight: 600 !important;',
        }
      ]}
      image={{ src: '/new.png', alt: '凉宫数据 ' }}
      bgImage={true}
      bgOpacity={30}
    >
      <Fragment slot="title">
        <span id="hero-greeting">凉宫数据欢迎您！</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="hidden sm:inline">
          凉宫数据提供
        </span>
        <span class="block mb-1 sm:hidden font-bold text-blue-600">
          凉宫数据office提供
        </span>
        创新型互联网企业
      </Fragment>
    </Hero>
  </div>

  <!-- 后续 Widget 保持不变（省略） -->
  <!-- ... 完整内容见下方脚本 ... -->

  <!-- ===== 接收用户名 + 双重存储 ===== -->
  <script>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const encodedUsername = urlParams.get('username');

      function getGreeting() {
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 9) return '早上好';
        if (hour >= 9 && hour < 12) return '上午好';
        if (hour >= 12 && hour < 14) return '中午好';
        if (hour >= 14 && hour < 18) return '下午好';
        if (hour >= 18 && hour < 21) return '傍晚好';
        return '晚上好';
      }

      function updateGreeting(username) {
        const el = document.getElementById('hero-greeting');
        if (el) {
          el.textContent = `${username}，${getGreeting()}`;
        }
      }

      // 存储用户名（localStorage + Cookie）
      function setUsername(username) {
        try {
          localStorage.setItem('username', username);
        } catch (e) {}
        document.cookie = `username=${encodeURIComponent(username)}; path=/; max-age=2592000`; // 30天
      }

      function getUsername() {
        // 先从 localStorage 读取
        try {
          const stored = localStorage.getItem('username');
          if (stored) return stored;
        } catch (e) {}
        // 从 Cookie 读取
        const cookie = document.cookie.split('; ').find(row => row.startsWith('username='));
        if (cookie) return decodeURIComponent(cookie.split('=')[1]);
        return null;
      }

      // 1. 有 URL 参数（从社区登录跳转）
      if (encodedUsername) {
        try {
          const username = decodeURIComponent(encodedUsername);
          if (username) {
            setUsername(username);
            updateGreeting(username);
            // 清除 URL 参数
            window.history.replaceState({}, document.title, '/');
            console.log(`✅ 欢迎语已更新: ${username}，${getGreeting()}`);
          }
        } catch (e) {
          console.log('解码用户名失败:', e);
        }
      }

      // 2. 无参数，从存储读取
      const storedUsername = getUsername();
      if (storedUsername) {
        updateGreeting(storedUsername);
      }
    })();
  </script>
</Layout>