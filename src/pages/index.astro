---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '凉宫数据',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '联系我们',
        href: '/contact',
        icon: 'tabler:download',
      },
      {
        text: '了解更多',
        href: '#features',
        style: 'background-color: white !important; color: black !important; border: 1px solid #d1d5db !important; box-shadow: 0 1px 2px 0 rgba(0,0,0,0.05) !important; font-weight: 600 !important;',
      }
    ]}
    image={{ src: '/new.png', alt: '凉宫数据 ' }}
    bgImage={true}
    bgOpacity={30}
  >
    <Fragment slot="title">
      凉宫数据欢迎您！
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        凉宫数据提供
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">
        凉宫数据office提供
      </span>
      创新型互联网企业
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="我们的理念" description="创新·高新" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="凉宫数据"
    title="新方向·新发展"
    items={[
      {
        title: '我们的理念',
        description:
          '创新，当代互联网高新技术产业已处于饱和状态，作为创新型企业，则必然需要开拓新型市场以及高新产业',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: '我们的发展',
        description:
          '我们于2026/4/17成立，届时，我们一共发布了三个中心，其中，凉宫数据中央行政中心为最高管理中心',
        icon: 'tabler:components',
      },
      {
        title: '我们的目标',
        description:
          '我们正在不断的发展，拓展各个互联网方向，在发展的同时也在不断提升自我，以达到看一步，走一步，稳一步的效果',
        icon: 'tabler:list-check',
      },
      {
        title: '我们的数据',
        description:
          '凉宫数据现采用Cloudflare作为防火墙，后续将逐步改善，提高用户的浏览效率',
        icon: 'tabler:rocket',
      },
      {
        title: '我们的Ai',
        description:
          "凉宫数据现已完成移动端Ai项目部署，完成了主流平台的聊天/分析等功能，现逐步完善到网页端",
        icon: 'tabler:arrows-right-left',
      },
      {
        title: '我们的人员',
        description:
          '凉宫数据现有一名中央行政员，同时也欢迎各位加入我们，我们将会不断开放更多福利',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="——数据板块——"
    title="凉宫数据数字安全化"
    items={[
      {
        title: '安全性',
        description:
          '数据采用端到端加密的方式，任何人不能获取到私人信息，并且定期有安全管理员进行安全核查',
      },
      {
        title: '时效性',
        description:
          '除验证码等具有时效性的数据，其他数据均有长期时效性，给用户提供更长时效性的数字化服务',
      },
      {
        title: '链接性',
        description:
          '所有的数据直接发送到云端数据库，避免二次转发，达到更高销量的数据高效化',
      },
    ]}
    image={{
      src: '/01.png',
      alt: '凉宫数据',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">新数据化</h3>
      多效化 
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '中国',
        description:'国内主要服务端，大部分云端服务由国内提供技术服务',
      },
      {
        title: '美国',
        description:
          '防火墙提供商Cloudflare主干服务器位于美国，其安全性由该企业提供技术支持',
