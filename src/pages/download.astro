---
import PageLayout from '~/layouts/PageLayout.astro';

const software = {
  id: 'hsdc-studio',
  name: 'HSDC Studio',
  version: '1.0.0',
  platform: 'Android',
  description: 'HSDC Studio 是由 HSDC 开发的 Android 代码编辑器，提供轻量、便捷的移动端代码编辑体验。',
  icon: 'https://raw.githubusercontent.com/HSDCoffical/HSDC-Code-for-Android/main/1791050171702.png',
  download: 'https://github.com/HSDCoffical/HSDC-Code-for-Android/releases/download/v1.0.0/CodeEditor_1.0.0.apk',
  release: 'https://github.com/HSDCoffical/HSDC-Code-for-Android/releases/tag/v1.0.0',
  repository: 'https://github.com/HSDCoffical/HSDC-Code-for-Android',
  changelog: [
    '首次发布 HSDC Studio Android 版本',
    '提供基础代码编辑功能',
    '优化移动端使用体验',
  ],
};
---

<PageLayout
  title="下载中心"
  description="下载 HSDC 开发的软件与应用。"
>
  <!-- 顶部留出空间防止被导航栏遮挡 -->
  <main class="download-page" style="padding-top: 120px; padding-bottom: 60px;">
    <div class="container">

      <!-- 移除了图一的 Hero 区域，直接进入软件列表 -->

      <div class="section-heading" style="margin-bottom: 24px;">
        <div>
          <div class="section-label">
            SOFTWARE
          </div>
          <h2>
            软件产品
          </h2>
        </div>
        <p>
          通过 GitHub Release 发布正式版本。
        </p>
      </div>


      <!-- =========================
           HSDC Studio 软件卡片
      ========================== -->
      <article class="software-card">
        <div class="card-header">
          <!-- 保留的大图标 -->
          <div class="icon-box">
            <img
              src={software.icon}
              alt={`${software.name} 图标`}
              width="88"
              height="88"
            />
          </div>

          <div class="product-info">
            <div class="product-status">
              LATEST
            </div>
            <!-- 移除了文字左侧的小 logo，仅保留文字 -->
            <h3>
              {software.name}
            </h3>
            <div class="version">
              v{software.version}
            </div>
          </div>
        </div>

        <p class="description">
          {software.description}
        </p>

        <div class="tags">
          <span>{software.platform}</span>
          <span>Open Source</span>
        </div>

        <!-- 版本与下载量信息 -->
        <div class="release-info" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
          <div>
            <span>VERSION</span>
            <strong>v{software.version}</strong>
          </div>
          <div>
            <span>PLATFORM</span>
            <strong>{software.platform}</strong>
          </div>
          <div>
            <span>本机下载量</span>
            <strong id="download-count" style="color: rgb(14, 165, 233); transition: transform 0.2s ease;">
              0 次
            </strong>
          </div>
        </div>

        <!-- 更新日志 -->
        <div class="updates">
          <div class="updates-header">
            <strong>最新更新</strong>
            <a href={software.release} target="_blank" rel="noopener noreferrer">
              查看完整 Release →
            </a>
          </div>
          <ul>
            {software.changelog.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <!-- 操作按钮 -->
        <div class="actions">
          <a
            id="download-btn"
            class="download-button"
            href={software.download}
            target="_blank"
            rel="noopener noreferrer"
          >
            下载 APK
          </a>
          <a
            class="secondary-button"
            href={software.repository}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub →
          </a>
        </div>
      </article>

      <!-- 移除了图三的底部版本信息提示框 -->

    </div>
  </main>

  <script define:vars={{ softwareId: software.id }}>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('download-btn');
      const countEl = document.getElementById('download-count');
      const storageKey = `download_count_${softwareId}`;

      let count = parseInt(localStorage.getItem(storageKey) || '0', 10);
      countEl.innerText = `${count} 次`;

      if (btn) {
        btn.addEventListener('click', () => {
          count += 1;
          localStorage.setItem(storageKey, count.toString());
          countEl.innerText = `${count} 次`;
          
          countEl.style.transform = 'scale(1.1)';
          setTimeout(() => countEl.style.transform = 'scale(1)', 200);
        });
      }
    });
  </script>
</PageLayout>

<style>
/* 基础 */
.download-page {
  width: 100%;
  background-color: rgb(248, 250, 252); /* 增加一点极浅的灰色背景，让白色卡片更突出 */
  min-height: 100vh;
}

.container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

/* Section 标题 */
.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
}

.section-heading h2 {
  margin: 8px 0 0;
  font-size: clamp(2rem, 5vw, 3rem);
  line-height: 1.1;
  letter-spacing: -0.04em;
  color: rgb(15, 23, 42);
}

.section-heading > p {
  margin: 0;
  color: rgb(100, 116, 139);
}

.section-label {
  color: rgb(14, 165, 233);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

/* 软件卡片 */
.software-card {
  width: 100%;
  box-sizing: border-box;
  padding: 30px;
  border: 1px solid rgba(100, 116, 139, 0.16);
  border-radius: 24px;
  background: #ffffff;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
}

/* 软件头部 */
.card-header {
  display: flex;
  align-items: center;
  gap: 20px;
}

.icon-box {
  width: 88px;
  height: 88px;
  flex: 0 0 88px;
  overflow: hidden;
  border-radius: 20px;
  background: rgb(241, 245, 249);
}

.icon-box img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-status {
  display: inline-block;
  color: rgb(22, 163, 74);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.product-info h3 {
  margin: 5px 0 3px;
  font-size: 1.8rem;
  letter-spacing: -0.035em;
  color: rgb(15, 23, 42);
}

.version {
  color: rgb(100, 116, 139);
  font-size: 0.85rem;
}

/* 描述 */
.description {
  max-width: 760px;
  margin: 25px 0 0;
  color: rgb(71, 85, 105);
  line-height: 1.8;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 20px;
}

.tags span {
  padding: 6px 10px;
  border: 1px solid rgba(100, 116, 139, 0.15);
  border-radius: 999px;
  color: rgb(71, 85, 105);
  background: rgb(248, 250, 252);
  font-size: 0.75rem;
}

/* 版本信息 */
.release-info {
  display: grid;
  gap: 12px;
  margin-top: 24px;
}

.release-info div {
  padding: 14px;
  border-radius: 14px;
  background: rgb(248, 250, 252);
}

.release-info span {
  display: block;
  margin-bottom: 5px;
  color: rgb(148, 163, 184);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.release-info strong {
  font-size: 0.9rem;
  color: rgb(15, 23, 42);
  display: inline-block;
}

/* 更新日志 */
.updates {
  margin-top: 28px;
  padding-top: 22px;
  border-top: 1px solid rgba(100, 116, 139, 0.12);
}

.updates-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.updates-header strong {
  font-size: 0.9rem;
  color: rgb(15, 23, 42);
}

.updates-header a {
  color: rgb(14, 165, 233);
  font-size: 0.8rem;
  text-decoration: none;
}

.updates ul {
  margin: 12px 0 0;
  padding-left: 20px;
}

.updates li {
  margin-top: 7px;
  color: rgb(71, 85, 105);
  font-size: 0.86rem;
  line-height: 1.6;
}

/* 按钮 */
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}

.download-button,
.secondary-button {
  min-height: 48px;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22px;
  border-radius: 13px;
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 700;
}

.download-button {
  color: white;
  background: rgb(15, 23, 42);
}

.secondary-button {
  color: rgb(15, 23, 42);
  border: 1px solid rgba(100, 116, 139, 0.2);
  background: transparent;
}

/* 手机端适配 */
@media (max-width: 640px) {
  .container {
    width: calc(100% - 32px);
  }
  
  .download-page {
    padding-top: 100px !important; 
  }

  .section-heading {
    display: block;
  }

  .section-heading > p {
    margin-top: 12px;
  }

  .software-card {
    padding: 22px;
    border-radius: 20px;
  }

  .card-header {
    align-items: flex-start;
  }

  .icon-box {
    width: 68px;
    height: 68px;
    flex-basis: 68px;
    border-radius: 16px;
  }

  .product-info h3 {
    font-size: 1.45rem;
  }

  .release-info {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
  
  .release-info div:nth-child(3) {
    grid-column: span 2;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .download-button,
  .secondary-button {
    width: 100%;
  }
}
</style>