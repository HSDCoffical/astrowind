---
import PageLayout from '~/layouts/PageLayout.astro';

const software = {
  name: 'HSDC Studio',
  version: '1.0.0',
  platform: 'Android',

  description:
    'HSDC Studio 是由 HSDC 开发的 Android 代码编辑器，提供轻量、便捷的移动端代码编辑体验。',

  icon: 'https://raw.githubusercontent.com/HSDCoffical/HSDC-Code-for-Android/main/1791050171702.png',

  download:
    'https://github.com/HSDCoffical/HSDC-Code-for-Android/releases/download/v1.0.0/CodeEditor_1.0.0.apk',

  release:
    'https://github.com/HSDCoffical/HSDC-Code-for-Android/releases/tag/v1.0.0',

  repository:
    'https://github.com/HSDCoffical/HSDC-Code-for-Android',

  changelog: [
    '首次发布 HSDC Studio Android 版本',
    '提供基础代码编辑功能',
    '优化移动端使用体验',
  ],
};
---

<PageLayout
  title="下载中心"
  description="下载 HSDC 开发的软件与应用。"
>
  <main class="download-page">

    <!-- =========================
         Hero
    ========================== -->

    <section class="hero">
      <div class="container">

        <div class="eyebrow">
          HSDC SOFTWARE
        </div>

        <h1>
          下载中心
        </h1>

        <p class="hero-subtitle">
          Download Center
        </p>

        <p class="hero-description">
          探索 HSDC 开发的软件与应用。<br />
          获取最新版本、更新日志以及项目源代码。
        </p>

        <div class="stats">

          <div class="stat">
            <strong>1</strong>
            <span>软件产品</span>
          </div>

          <div class="stat">
            <strong>1</strong>
            <span>支持平台</span>
          </div>

          <div class="stat">
            <strong>GitHub</strong>
            <span>开源发布</span>
          </div>

        </div>

      </div>
    </section>


    <!-- =========================
         Software
    ========================== -->

    <section class="products">
      <div class="container">

        <div class="section-heading">

          <div>
            <div class="section-label">
              SOFTWARE
            </div>

            <h2>
              软件产品
            </h2>
          </div>

          <p>
            通过 GitHub Release 发布正式版本。
          </p>

        </div>


        <!-- =========================
             HSDC Studio
        ========================== -->

        <article class="software-card">

          <div class="card-header">

            <div class="icon-box">

              <img
                src={software.icon}
                alt={`${software.name} 图标`}
                width="88"
                height="88"
              />

            </div>


            <div class="product-info">

              <div class="product-status">
                LATEST
              </div>

              <h3>
                {software.name}
              </h3>

              <div class="version">
                v{software.version}
              </div>

            </div>

          </div>


          <p class="description">
            {software.description}
          </p>


          <div class="tags">

            <span>
              {software.platform}
            </span>

            <span>
              Open Source
            </span>

          </div>


          <!-- 版本信息 -->

          <div class="release-info">

            <div>
              <span>
                VERSION
              </span>

              <strong>
                v{software.version}
              </strong>
            </div>


            <div>
              <span>
                PLATFORM
              </span>

              <strong>
                {software.platform}
              </strong>
            </div>

          </div>


          <!-- 更新日志 -->

          <div class="updates">

            <div class="updates-header">

              <strong>
                最新更新
              </strong>

              <a
                href={software.release}
                target="_blank"
                rel="noopener noreferrer"
              >
                查看完整 Release →
              </a>

            </div>


            <ul>

              {software.changelog.map((item) => (
                <li>
                  {item}
                </li>
              ))}

            </ul>

          </div>


          <!-- 操作按钮 -->

          <div class="actions">

            <a
              class="download-button"
              href={software.download}
              target="_blank"
              rel="noopener noreferrer"
            >
              下载 APK
            </a>


            <a
              class="secondary-button"
              href={software.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub →
            </a>

          </div>

        </article>


        <!-- =========================
             Release information
        ========================== -->

        <div class="release-note">

          <strong>
            版本信息
          </strong>

          <p>
            软件安装包、源代码和完整更新日志均通过
            GitHub Release 管理。
          </p>

        </div>

      </div>
    </section>

  </main>
</PageLayout>


<style>

/* =========================================================
   基础
========================================================= */

.download-page {
  width: 100%;
}


/* =========================================================
   容器
========================================================= */

.container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}


/* =========================================================
   Hero
========================================================= */

.hero {
  border-bottom: 1px solid rgba(100, 116, 139, 0.14);

  background: linear-gradient(
    180deg,
    rgba(224, 242, 254, 0.72) 0%,
    rgba(248, 250, 252, 0.35) 100%
  );
}


.hero .container {
  padding: 86px 0 82px;
}


/* =========================================================
   标签
========================================================= */

.eyebrow,
.section-label {
  color: rgb(14, 165, 233);

  font-size: 0.75rem;

  font-weight: 700;

  letter-spacing: 0.18em;
}


.eyebrow {
  display: inline-block;

  padding: 9px 13px;

  border: 1px solid rgba(14, 165, 233, 0.2);

  border-radius: 999px;

  background: rgba(14, 165, 233, 0.06);
}


/* =========================================================
   Hero 标题
========================================================= */

h1 {
  margin: 25px 0 0;

  font-size: clamp(3.2rem, 9vw, 6.5rem);

  line-height: 0.98;

  letter-spacing: -0.055em;

  font-weight: 800;
}


.hero-subtitle {
  margin: 12px 0 0;

  color: rgb(100, 116, 139);

  font-size: clamp(1.35rem, 3vw, 2.3rem);

  font-weight: 600;

  letter-spacing: -0.025em;
}


.hero-description {
  margin: 30px 0 0;

  color: rgb(71, 85, 105);

  font-size: 1.05rem;

  line-height: 1.9;
}


/* =========================================================
   数据
========================================================= */

.stats {
  display: flex;

  flex-wrap: wrap;

  gap: 42px;

  margin-top: 42px;
}


.stat {
  display: flex;

  flex-direction: column;

  gap: 6px;
}


.stat strong {
  font-size: 1.4rem;

  line-height: 1.1;
}


.stat span {
  color: rgb(100, 116, 139);

  font-size: 0.8rem;
}


/* =========================================================
   软件区域
========================================================= */

.products {
  padding: 78px 0 90px;
}


/* =========================================================
   Section 标题
========================================================= */

.section-heading {
  display: flex;

  align-items: end;

  justify-content: space-between;

  gap: 30px;

  margin-bottom: 32px;
}


.section-heading h2 {
  margin: 8px 0 0;

  font-size: clamp(2rem, 5vw, 3rem);

  line-height: 1.1;

  letter-spacing: -0.04em;
}


.section-heading > p {
  margin: 0;

  color: rgb(100, 116, 139);
}


/* =========================================================
   软件卡片
========================================================= */

.software-card {
  width: 100%;

  box-sizing: border-box;

  padding: 30px;

  border: 1px solid rgba(100, 116, 139, 0.16);

  border-radius: 24px;

  background: rgba(255, 255, 255, 0.86);

  box-shadow:
    0 12px 40px rgba(15, 23, 42, 0.06);
}


/* =========================================================
   软件头部
========================================================= */

.card-header {
  display: flex;

  align-items: center;

  gap: 20px;
}


/* =========================================================
   软件图标
========================================================= */

.icon-box {
  width: 88px;

  height: 88px;

  flex: 0 0 88px;

  overflow: hidden;

  border-radius: 20px;

  background: rgb(241, 245, 249);
}


.icon-box img {
  display: block;

  width: 100%;

  height: 100%;

  object-fit: cover;
}


/* =========================================================
   软件信息
========================================================= */

.product-status {
  display: inline-block;

  color: rgb(22, 163, 74);

  font-size: 0.7rem;

  font-weight: 700;

  letter-spacing: 0.12em;
}


.product-info h3 {
  margin: 5px 0 3px;

  font-size: 1.8rem;

  letter-spacing: -0.035em;
}


.version {
  color: rgb(100, 116, 139);

  font-size: 0.85rem;
}


/* =========================================================
   软件描述
========================================================= */

.description {
  max-width: 760px;

  margin: 25px 0 0;

  color: rgb(71, 85, 105);

  line-height: 1.8;
}


/* =========================================================
   标签
========================================================= */

.tags {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 20px;
}


.tags span {
  padding: 6px 10px;

  border: 1px solid rgba(100, 116, 139, 0.15);

  border-radius: 999px;

  color: rgb(71, 85, 105);

  background: rgb(248, 250, 252);

  font-size: 0.75rem;
}


/* =========================================================
   版本信息
========================================================= */

.release-info {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 180px));

  gap: 12px;

  margin-top: 24px;
}


.release-info div {
  padding: 14px;

  border-radius: 14px;

  background: rgb(248, 250, 252);
}


.release-info span {
  display: block;

  margin-bottom: 5px;

  color: rgb(148, 163, 184);

  font-size: 0.65rem;

  font-weight: 700;

  letter-spacing: 0.12em;
}


.release-info strong {
  font-size: 0.9rem;
}


/* =========================================================
   更新日志
========================================================= */

.updates {
  margin-top: 28px;

  padding-top: 22px;

  border-top:
    1px solid rgba(100, 116, 139, 0.12);
}


.updates-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;
}


.updates-header strong {
  font-size: 0.9rem;
}


.updates-header a {
  color: rgb(14, 165, 233);

  font-size: 0.8rem;

  text-decoration: none;
}


.updates ul {
  margin: 12px 0 0;

  padding-left: 20px;
}


.updates li {
  margin-top: 7px;

  color: rgb(71, 85, 105);

  font-size: 0.86rem;

  line-height: 1.6;
}


/* =========================================================
   按钮
========================================================= */

.actions {
  display: flex;

  flex-wrap: wrap;

  gap: 10px;

  margin-top: 28px;
}


.download-button,
.secondary-button {
  min-height: 48px;

  box-sizing: border-box;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  padding: 0 22px;

  border-radius: 13px;

  text-decoration: none;

  font-size: 0.88rem;

  font-weight: 700;
}


.download-button {
  color: white;

  background: rgb(15, 23, 42);
}


.secondary-button {
  color: rgb(15, 23, 42);

  border:
    1px solid rgba(100, 116, 139, 0.2);

  background: transparent;
}


/* =========================================================
   Release 信息
========================================================= */

.release-note {
  margin-top: 22px;

  padding: 22px 24px;

  border:
    1px solid rgba(14, 165, 233, 0.14);

  border-radius: 18px;

  background: rgba(14, 165, 233, 0.04);
}


.release-note p {
  margin: 7px 0 0;

  color: rgb(100, 116, 139);

  line-height: 1.7;
}


/* =========================================================
   手机端
========================================================= */

@media (max-width: 640px) {

  .container {
    width: calc(100% - 32px);
  }


  .hero .container {
    padding: 68px 0 64px;
  }


  .products {
    padding: 60px 0 70px;
  }


  .section-heading {
    display: block;
  }


  .section-heading > p {
    margin-top: 12px;
  }


  .software-card {
    padding: 22px;

    border-radius: 20px;
  }


  .card-header {
    align-items: flex-start;
  }


  .icon-box {
    width: 68px;

    height: 68px;

    flex-basis: 68px;

    border-radius: 16px;
  }


  .product-info h3 {
    font-size: 1.45rem;
  }


  .release-info {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  .actions {
    display: grid;

    grid-template-columns: 1fr;
  }


  .download-button,
  .secondary-button {
    width: 100%;
  }

}


/* =========================================================
   深色模式
========================================================= */

@media (prefers-color-scheme: dark) {

  .hero {
    background:
      rgba(14, 165, 233, 0.04);
  }


  .software-card {
    background:
      rgba(15, 23, 42, 0.72);

    box-shadow: none;
  }


  .tags span,
  .release-info div {
    background:
      rgba(30, 41, 59, 0.7);
  }


  .download-button {
    color: rgb(15, 23, 42);

    background: rgb(248, 250, 252);
  }


  .secondary-button {
    color: rgb(226, 232, 240);
  }

}

</style>