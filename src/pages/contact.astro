---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: '联系界面',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="欢迎！" />

  <ContactUs
    id="form"
    title="发送邮件"
    subtitle="通过此界面向中心发送邮件，但是并不确定100%能收到，所以建议您尽量在自己的邮箱里发送"
    inputs={[
      {
        type: 'text',
        name: '主题',
        label: '主题',
      },
      {
        type: 'eamil',
        name: '邮件地址',
        label: '邮件地址',
      },
    ]}
    textarea={{
      label: '正文',
    }}
    disclaimer={{
      label:
        '提交后我们将从你填写的邮件地址发送回执，如确认无误，请确定',
    }}
    description="我们将会在一周内回复您，感谢您的来信"
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="提供"
    items={[
      {
        title: '我的信息会被泄露吗？',
        description: `不会，全程只有一人操作，不必担心信息泄露`,
      },
      {
        title: '这个地址会被存储或订阅吗？',
        description:
          '不会，电子邮箱地址完全不会记录在我们的云端上，并且不会给您推送订阅消息',
      },
      {
        title: '这个界面可靠吗',
        description:
          '还是建议您从自己的邮箱APP发送一份',
      },
      {
        title: '官方网址',
        description: 'https://hsdc.dpdns.org',
        icon: 'tabler:headset',
      },
      {
        title: '官方邮箱',
        description: 'xuexiang@lianggong.dpdns.org',
        icon: 'tabler:mail',
      },
      {
        title: '地区',
        description: 'CN-中国',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
